<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR ENGINE DETERMINISTIC RULES MUTATION TESTING -->
    <!-- Targets: DeterministicRules, the geometry of UX Design Doc Section 8
         that the strip offers from named values. Critical path: an answer
         the user accepts onto the tape and onto a takeoff sheet, so a wrong
         pair, a diagonal rounded the wrong way, a perimeter missing its
         factor or a unit from the wrong system is a wrong answer that still
         looks like one. -->

    <files>
        <file>lib/libraries/calculator_engine/deterministic_rules.dart</file>
    </files>

    <rules>
        <!-- RULE 1: Length and Height are read before Length and Width -->
        <regex pattern="\(DimensionKey\.length, DimensionKey\.width\),\s*\(DimensionKey\.length, DimensionKey\.height\)," dotAll="true" id="deterministic_rules.pair.height_first">
            <mutation text="(DimensionKey.length, DimensionKey.height), (DimensionKey.length, DimensionKey.width),"/>
        </regex>

        <!-- RULE 2: Width and Height no longer make a rectangle -->
        <regex pattern="\(DimensionKey\.width, DimensionKey\.height\),\s*\];" dotAll="true" id="deterministic_rules.pair.no_width_height">
            <mutation text="];"/>
        </regex>

        <!-- RULE 3: the perimeter loses its factor -->
        <regex pattern="value: Length\(2 \* \(a \+ b\), unit: unit\)," dotAll="true" id="deterministic_rules.perimeter.no_factor">
            <mutation text="value: Length(a + b, unit: unit),"/>
        </regex>

        <!-- RULE 4: a diagonal is rounded to a whole tick before display -->
        <regex pattern="\?_leg\(diagonalKey, _hypotenuse\(a, b\), unit, sources\)," dotAll="true" id="deterministic_rules.diagonal.whole_tick">
            <mutation text="Answer(key: diagonalKey, value: Length(_hypotenuse(a, b).round(), unit: unit), sources: sources),"/>
        </regex>
        <regex pattern="\?_leg\(\s*diagonalKey,\s*_hypotenuse\(rise\.ticks, run\.ticks\),\s*_entrySystemUnit\(\[rise, run\]\),\s*\[DimensionKey\.rise\.id, DimensionKey\.run\.id\],\s*\)," dotAll="true" id="deterministic_rules.triangle.whole_tick">
            <mutation text="Answer(key: diagonalKey, value: Length(_hypotenuse(rise.ticks, run.ticks).round(), unit: _entrySystemUnit([rise, run])), sources: [DimensionKey.rise.id, DimensionKey.run.id]),"/>
        </regex>

        <!-- RULE 12: a diagonal past 2^53 ticks is still computed, so
             Length.computed asserts instead of the answer being left out -->
        <regex pattern="if \(ticks &gt; Length\.maxTicks\) return null;" dotAll="true" id="deterministic_rules.leg.no_limit">
            <mutation text="if (false) return null;"/>
        </regex>

        <!-- RULE 5: a run of nothing still gives a diagonal, and so does a
             missing run -->
        <regex pattern="if \(rise == null \|\| run == null \|\| run\.ticks &lt;= 0\) return const \[\];" dotAll="true" id="deterministic_rules.triangle.no_guard">
            <mutation text="if (rise == null || run == null || run.ticks &lt; 0) return const [];"/>
            <mutation text="if (rise == null || run == null) return const [];"/>
        </regex>

        <!-- RULE 6: a mixed tape answers in metres, and an all-metric one in
             feet -->
        <regex pattern="lengths\.isNotEmpty &amp;&amp; lengths\.every\(\(length\) =&gt; length\.unit\.isMetric\)" dotAll="true" id="deterministic_rules.unit.wrong_vote">
            <mutation text="lengths.any((length) =&gt; length.unit.isMetric)"/>
            <mutation text="false"/>
        </regex>

        <!-- RULE 7: the area is the sum of the sides -->
        <regex pattern="value: Area\(a \* b\.toDouble\(\), unit: unit\)," dotAll="true" id="deterministic_rules.area.sum">
            <mutation text="value: Area(a + b.toDouble(), unit: unit),"/>
        </regex>

        <!-- RULE 8: the hypotenuse drops a side, or squares one in int math
             so that it wraps past 3,954,427ft -->
        <regex pattern="math\.sqrt\(a\.toDouble\(\) \* a \+ b\.toDouble\(\) \* b\);" dotAll="true" id="deterministic_rules.hypotenuse.one_side">
            <mutation text="math.sqrt(a.toDouble() * a);"/>
            <mutation text="math.sqrt(a.toDouble() * a + b * b);"/>
            <mutation text="math.sqrt(a * a + b.toDouble() * b);"/>
        </regex>

        <!-- RULE 10: the rectangle votes its unit over every named length,
             so a chip no rule used changes the unit -->
        <regex pattern="return _rectangleOf\(a\.ticks, b\.ticks, \[\s*first\.id,\s*second\.id,\s*\], _entrySystemUnit\(\[a, b\]\)\);" dotAll="true" id="deterministic_rules.unit.rectangle_whole_tape">
            <mutation text="return _rectangleOf(a.ticks, b.ticks, [first.id, second.id], _entrySystemUnit(lengths.values));"/>
        </regex>

        <!-- RULE 11: the triangle votes its unit over every named length -->
        <regex pattern="_entrySystemUnit\(\[rise, run\]\)," dotAll="true" id="deterministic_rules.unit.triangle_whole_tape">
            <mutation text="_entrySystemUnit(lengths.values),"/>
        </regex>

        <!-- RULE 9: a value that is not a length is read as a side -->
        <regex pattern="if \(value is Length\) lengths\[key\] = value;" dotAll="true" id="deterministic_rules.named.not_a_length">
            <mutation text="if (value != null) lengths[key] = value as Length;"/>
        </regex>

        <!-- RULE 10: the box answers follow the rectangle facts instead of
             leading -->
        <regex pattern="\.\.\._box\(lengths\),\s*\.\.\._rectangle\(lengths\)," dotAll="true" id="deterministic_rules.box.not_leading">
            <mutation text="..._rectangle(lengths), ..._box(lengths),"/>
        </regex>

        <!-- RULE 11: the volume forgets the height -->
        <regex pattern="_feetOf\(length\) \* _feetOf\(width\) \* _feetOf\(height\)," dotAll="true" id="deterministic_rules.volume.two_sides">
            <mutation text="_feetOf(length) * _feetOf(width),"/>
        </regex>

        <!-- RULE 12: the wall area counts two walls, not four; or its product
             is taken in int math, which wraps past 2^63 square ticks -->
        <regex pattern="2 \* \(length\.ticks \+ width\.ticks\) \* height\.ticks\.toDouble\(\)," dotAll="true" id="deterministic_rules.wall_area.two_walls">
            <mutation text="(length.ticks + width.ticks) * height.ticks.toDouble(),"/>
            <mutation text="(2 * (length.ticks + width.ticks) * height.ticks).toDouble(),"/>
        </regex>

        <!-- RULE 13: two sides are enough for a box -->
        <regex pattern="if \(length == null \|\| width == null \|\| height == null\) return const \[\];" dotAll="true" id="deterministic_rules.box.two_sides">
            <mutation text="if (length == null || width == null) return const [];"/>
        </regex>

        <!-- RULE 14: the flats span no longer grows the corner radius -->
        <regex pattern="PolygonSpan\.flats =&gt; diameter\.ticks / 2 / math\.cos\(math\.pi / sides\)," dotAll="true" id="deterministic_rules.polygon.flats_as_corners">
            <mutation text="PolygonSpan.flats =&gt; diameter.ticks / 2,"/>
        </regex>

        <!-- RULE 15: the polygon area uses the diameter as its radius -->
        <regex pattern="0\.5 \* sides \* cornerRadius \* cornerRadius \* math\.sin\(2 \* math\.pi / sides\)," dotAll="true" id="deterministic_rules.polygon.wrong_area">
            <mutation text="sides * cornerRadius * cornerRadius * math.sin(2 * math.pi / sides),"/>
        </regex>

        <!-- RULE 16: two sides make a polygon, and so does a fraction of a
             side -->
        <regex pattern="when value &gt;= fewestSides &amp;&amp; value == value\.roundToDouble\(\)\) \{" dotAll="true" id="deterministic_rules.sides.no_guard">
            <mutation text="when value &gt; fewestSides &amp;&amp; value == value.roundToDouble()) {"/>
            <mutation text="when value &gt;= fewestSides) {"/>
        </regex>

        <!-- RULE 17: a radius is not doubled into the span -->
        <regex pattern="2 \* radius\.ticks," dotAll="true" id="deterministic_rules.circle.radius_as_diameter">
            <mutation text="radius.ticks,"/>
        </regex>

        <!-- RULE 18: the circle area uses the diameter -->
        <regex pattern="value: Area\(math\.pi \* halfTicks \* halfTicks, unit: unit\)," dotAll="true" id="deterministic_rules.circle.area_of_diameter">
            <mutation text="value: Area(math.pi * span.ticks * halfTicks, unit: unit),"/>
        </regex>

        <!-- RULE 19: the corner angle is the exterior angle -->
        <regex pattern="value: Angle\(180 - 360 / sides\)," dotAll="true" id="deterministic_rules.polygon.exterior_angle">
            <mutation text="value: Angle(360 / sides),"/>
            <mutation text="value: Angle((sides - 2) * 180 / sides),"/>
        </regex>

        <!-- RULE 22: the polygon answers forget their unit -->
        <regex pattern="value: polygonArea\(span, sides, unit: unit\)," dotAll="true" id="deterministic_rules.polygon.area_unit">
            <mutation text="value: polygonArea(span, sides),"/>
        </regex>
        <regex pattern="value: Length\(_wholeTicks\(side\), unit: unit\)," dotAll="true" id="deterministic_rules.polygon.side_unit">
            <mutation text="value: Length(_wholeTicks(side), unit: Unit.foot),"/>
        </regex>
        <regex pattern="value: Length\(_wholeTicks\(sides \* side\), unit: unit\)," dotAll="true" id="deterministic_rules.polygon.perimeter_unit">
            <mutation text="value: Length(_wholeTicks(sides * side), unit: Unit.foot),"/>
            <mutation text="value: Length(sides * _wholeTicks(side), unit: unit),"/>
        </regex>

        <!-- RULE 23: an odd span loses half a tick before the circle or the
             polygon is computed -->
        <regex pattern="final halfTicks = span\.ticks / 2;" dotAll="true" id="deterministic_rules.circle.half_tick_dropped">
            <mutation text="final halfTicks = (span.ticks ~/ 2).toDouble();"/>
        </regex>
        <regex pattern="PolygonSpan\.corners =&gt; diameter\.ticks / 2," dotAll="true" id="deterministic_rules.polygon.half_tick_dropped">
            <mutation text="PolygonSpan.corners =&gt; (diameter.ticks ~/ 2).toDouble(),"/>
        </regex>

        <!-- RULE 24: polygonArea takes any count of sides -->
        <regex pattern="assert\(sides &gt;= fewestSides, 'a polygon has at least \$fewestSides sides'\);" dotAll="true" id="deterministic_rules.polygon_area.no_precondition">
            <mutation text=""/>
        </regex>

        <!-- RULE 20: the side length forgets the sine -->
        <regex pattern="final side = span\.ticks \* math\.sin\(math\.pi / sides\);" dotAll="true" id="deterministic_rules.polygon.side_without_sine">
            <mutation text="final side = span.ticks / sides;"/>
        </regex>

        <!-- RULE 21: the missing half is always the radius -->
        <regex pattern="final missingHalf = diameter == null" dotAll="true" id="deterministic_rules.circle.wrong_missing_half">
            <mutation text="final missingHalf = diameter != null"/>
        </regex>
        <!-- RULE: a circle or polygon length is truncated to a tick
             instead of rounded half up -->
        <regex pattern="int _wholeTicks\(double ticks\) =&gt; \(ticks \+ 0\.5\)\.floor\(\);" dotAll="true" id="deterministic_rules.whole_ticks.truncate">
            <mutation text="int _wholeTicks(double ticks) =&gt; ticks.floor();"/>
        </regex>

        <!-- RULE 22: a tall segment is never the major arc -->
        <regex pattern="final angle = h &gt; c / 2 \? fullTurn - minorAngle : minorAngle;" dotAll="true" id="deterministic_rules.arc.never_major">
            <mutation text="final angle = minorAngle;"/>
        </regex>

        <!-- RULE 27: the half-circle clamp is dropped, so a long chord's
             c / 2R of 1.0000000000000002 makes asin NaN -->
        <regex pattern="math\.asin\(math\.min\(1, c / \(2 \* radius\)\)\)" dotAll="true" id="deterministic_rules.arc.no_clamp">
            <mutation text="math.asin(c / (2 * radius))"/>
        </regex>

        <!-- RULE 28: a radius past 2^53 ticks is still answered, stuck at
             the largest int -->
        <regex pattern="if \(radius &gt; Length\.maxTicks\) return const \[\];" dotAll="true" id="deterministic_rules.arc.no_radius_limit">
            <mutation text="if (false) return const [];"/>
        </regex>

        <!-- RULE 29: the arc radius and length are truncated instead of
             rounded, or the length is taken from the rounded radius -->
        <regex pattern="value: Length\(_wholeTicks\(radius\), unit: unit\)," dotAll="true" id="deterministic_rules.arc.radius_truncated">
            <mutation text="value: Length(radius.floor(), unit: unit),"/>
        </regex>
        <regex pattern="value: Length\(_wholeTicks\(radius \* angle \* math\.pi / 180\), unit: unit\)," dotAll="true" id="deterministic_rules.arc.length_rounding">
            <mutation text="value: Length((radius * angle * math.pi / 180).floor(), unit: unit),"/>
            <mutation text="value: Length(_wholeTicks(_wholeTicks(radius) * angle * math.pi / 180), unit: unit),"/>
        </regex>

        <!-- RULE 23: the radius forgets the height's own square -->
        <regex pattern="final radius = \(h \* h \+ c \* c / 4\) / \(2 \* h\);" dotAll="true" id="deterministic_rules.arc.wrong_radius">
            <mutation text="final radius = (c * c / 4) / (2 * h);"/>
        </regex>

        <!-- RULE 24: the central angle is the half angle -->
        <regex pattern="final minorAngle =\s*2 \* math\.asin\(math\.min\(1, c / \(2 \* radius\)\)\) \* 180 / math\.pi;" dotAll="true" id="deterministic_rules.arc.half_angle">
            <mutation text="final minorAngle = math.asin(math.min(1, c / (2 * radius))) * 180 / math.pi;"/>
        </regex>

        <!-- RULE 25: a Run is never read as the chord -->
        <regex pattern="final chordKey = lengths\.containsKey\(DimensionKey\.chord\)\s*\? DimensionKey\.chord\s*: DimensionKey\.run;" dotAll="true" id="deterministic_rules.arc.chord_only">
            <mutation text="final chordKey = DimensionKey.chord;"/>
            <mutation text="final chordKey = DimensionKey.run;"/>
        </regex>

        <!-- RULE 26: a height of nothing still makes an arc -->
        <regex pattern="if \(chord\.ticks &lt;= 0 \|\| height\.ticks &lt;= 0\) return const \[\];" dotAll="true" id="deterministic_rules.arc.no_height_guard">
            <mutation text="if (chord.ticks &lt;= 0) return const [];"/>
            <mutation text="if (height.ticks &lt;= 0) return const [];"/>
        </regex>
    </rules>

    <commands>
        <command group="deterministic_rules" expected-return="0">flutter test test/libraries/calculator_engine/units/deterministic_rules_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
