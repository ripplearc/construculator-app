<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR ENGINE: A CHIP REOPENED BY A TAP (S1c 1/5, CA-1089) -->
    <!-- Targets: Tape.tapChip and the edit it opens — which chip is active,
         when an edit is open, and the guard no exit key may pass. Critical
         path: a wrong guard discards a value or closes the calculator
         mid-edit. -->

    <files>
        <file>lib/libraries/calculator_engine/tape.dart</file>
    </files>

    <rules>
        <!-- RULE 1: a chip being typed at the end counts as an edit, or the
             reopened last chip of the tape does not (R1, B1) -->
        <regex pattern="if \(!chip\.isEditing\) return null;" dotAll="true" id="tape_edit.editing.entry_counts_as_edit">
            <mutation text=""/>
            <mutation text="if (!chip.isEditing || index == chips.length - 1) return null;"/>
        </regex>

        <!-- RULE 1a: a tap reopens a chip without marking it as an edit
             (R1, B1) -->
        <regex pattern="tape\._reactivated\(tapped as ValueChip\)\.copyWith\(isEditing: true\)," dotAll="true" id="tape_edit.tap.not_marked">
            <mutation text="tape._reactivated(tapped as ValueChip),"/>
        </regex>

        <!-- RULE 1b: the seal leaves the edit mark on the chip, so ⌫ that
             reopens it later counts as an edit (R1, B1) -->
        <regex pattern="chip\.copyWith\(isActive: false, isEditing: false\)," dotAll="true" id="tape_edit.seal.keeps_mark">
            <mutation text="chip.copyWith(isActive: false),"/>
        </regex>

        <!-- RULE 1c: the seal of an edit is refused when the trig chip
             cannot answer the new value, so "Arcsine removed" never runs
             (R1, B2) -->
        <regex pattern="if \(chip != null &amp;&amp; chip\.asksAnUndefinedTrig &amp;&amp; !chip\.isEditing\) \{" dotAll="true" id="tape_edit.unfinished.trig_refuses_edit">
            <mutation text="if (chip != null &amp;&amp; chip.asksAnUndefinedTrig) {"/>
        </regex>

        <!-- RULE 2: a tap on a result or an error chip reopens it -->
        <regex pattern="if \(chips\[index\] is! ValueChip\) \{\s*return const TapeRefused\(TapeRefusal\.chipCannotBeEdited\);\s*\}" dotAll="true" id="tape_edit.tap.result_reopened">
            <mutation text="if (chips[index] is ErrorChip) { return const TapeRefused(TapeRefusal.chipCannotBeEdited); }"/>
        </regex>

        <!-- RULE 3: a tap while a bracket is open goes through -->
        <regex pattern="if \(openBracket != null\) \{\s*return const TapeRefused\(TapeRefusal\.finishThisValueFirst\);\s*\}\s*if \(chips\[index\] is! ValueChip\)" dotAll="true" id="tape_edit.tap.open_bracket_ignored">
            <mutation text="if (chips[index] is! ValueChip)"/>
        </regex>

        <!-- RULE 4: a second tap on the edited chip reopens it instead of
             finishing the edit -->
        <regex pattern="if \(activeIndex == index\) return _leavingEdit\(TapeChanged\.new\);" dotAll="true" id="tape_edit.tap.second_tap_not_a_close">
            <mutation text=""/>
        </regex>

        <!-- RULE 5b: a tap on another chip drops an emptied edit at the end
             of the tape, as if a key had just opened it -->
        <regex pattern="activeIndex == chips\.length - 1 &amp;&amp;\s*!current\.isEditing &amp;&amp;" dotAll="true" id="tape_edit.tap.emptied_edit_dropped">
            <mutation text="activeIndex == chips.length - 1 &amp;&amp;"/>
        </regex>

        <!-- RULE 5: an empty operator chip is dropped by a tap too -->
        <regex pattern="current\.entry\.isEmpty &amp;&amp;\s*current\.operator == null\) \{" dotAll="true" id="tape_edit.tap.operator_chip_dropped">
            <mutation text="current.entry.isEmpty) {"/>
        </regex>

        <!-- RULE 6: a tap on another chip abandons a broken edit -->
        <regex pattern="final closed = _withFractionClosedAsInches\(\);\s*if \(closed\._unfinished case final refusal\?\) return refusal;\s*\(tape: tape, removed: removed\) = closed\._sealedReporting\(\);" dotAll="true" id="tape_edit.tap.switch_abandons_broken_edit">
            <mutation text="(tape: tape, removed: removed) = _withFractionClosedAsInches()._sealedReporting();"/>
        </regex>

        <!-- RULE 7: an exit key abandons a broken edit -->
        <regex pattern="final closed = _withFractionClosedAsInches\(\);\s*if \(closed\._unfinished case final refusal\?\) return refusal;\s*final \(:tape, :removed\) = closed\._sealedReporting\(\);\s*return switch \(key\(tape\)\) \{" dotAll="true" id="tape_edit.leaving.guard_dropped">
            <mutation text="final (:tape, :removed) = _withFractionClosedAsInches()._sealedReporting(); return switch (key(tape)) {"/>
        </regex>

        <!-- RULE 8: = on an edit only seals, and never lands the Calc, or
             lands a second result over the one shown (R1, N3) -->
        <regex pattern="return switch \(tape\.pressEquals\(\)\) \{\s*final TapeChanged landed =&gt; landed,\s*TapeOutcome\(\) =&gt; TapeChanged\(tape\),\s*\};" dotAll="true" id="tape_edit.equals.not_a_seal">
            <mutation text="return TapeChanged(tape);"/>
        </regex>

        <!-- RULE 8a: a unit key on an emptied chip says units apply while
             typing when a result sits on the tape (R1, N4) -->
        <regex pattern="if \(chip != null &amp;&amp; chip\.entry\.isEmpty\) \{\s*return const TapeRefused\(TapeRefusal\.typeANumberFirst\);\s*\}" dotAll="true" id="tape_edit.unit.emptied_chip_units_apply">
            <mutation text=""/>
        </regex>

        <!-- RULE 9: ✕ on an emptied edit closes the calculator (the
             editing check under `chip == null` is unreachable: no active
             chip means no edit, so the rule targets the emptied chip) -->
        <regex pattern="if \(chip\.entry\.isEmpty\) \{\s*if \(editing != null\) \{\s*return const TapeRefused\(TapeRefusal\.finishThisValueFirst\);\s*\}" dotAll="true" id="tape_edit.clear.empty_edit_closes_calculator">
            <mutation text="if (chip.entry.isEmpty) {"/>
        </regex>

        <!-- RULE 10: a unit that cannot continue the compound splits a new
             chip off the edited one -->
        <regex pattern="editing: editing != null,\s*holdsLengthOnly: holdsLengthOnly," dotAll="true" id="tape_edit.unit.split_while_editing">
            <mutation text="holdsLengthOnly: holdsLengthOnly,"/>
        </regex>

        <!-- RULE 11: ⌫ on an emptied edit reopens the bracket at the end -->
        <regex pattern="if \(editing == null &amp;&amp; chips\.isNotEmpty\) \{" dotAll="true" id="tape_edit.backspace.bracket_before_edit">
            <mutation text="if (chips.isNotEmpty) {"/>
        </regex>

        <!-- RULE 12: ⌫ on an emptied edit keeps the chip, removes the
             emptied first chip of a chain, or keeps an emptied first chip
             that nothing follows (R1, N1) -->
        <regex pattern="if \(index == 0 &amp;&amp; chips\.length &gt; 1\) \{\s*return const TapeRefused\(TapeRefusal\.typeANewFirstValue\);\s*\}\s*return _withChipRemoved\(index\);" dotAll="true" id="tape_edit.backspace.empty_edit_kept">
            <mutation text="return TapeChanged(this);"/>
            <mutation text="return _withChipRemoved(index);"/>
            <mutation text="if (index == 0) { return const TapeRefused(TapeRefusal.typeANewFirstValue); } return _withChipRemoved(index);"/>
        </regex>

        <!-- RULE 13: the Read-as pill is offered during an edit -->
        <regex pattern="if \(openBracket != null \|\| editing != null\) return null;" dotAll="true" id="tape_edit.read_as.offered_while_editing">
            <mutation text="if (openBracket != null) return null;"/>
        </regex>

        <!-- RULE 15: a digit into a chip edited before a closed bracket is
             refused for the bracket -->
        <regex pattern="if \(editing == null &amp;&amp; _endsWithClosedBracket\) \{\s*return const TapeRefused\(TapeRefusal\.addAnOperatorFirst\);" dotAll="true" id="tape_edit.digit.closed_bracket_wins_over_edit">
            <mutation text="if (_endsWithClosedBracket) { return const TapeRefused(TapeRefusal.addAnOperatorFirst);"/>
        </regex>

        <!-- RULE 16: a unit onto a chip edited before a closed bracket is
             refused for the bracket -->
        <regex pattern="if \(editing == null &amp;&amp; _endsWithClosedBracket\) \{\s*return const TapeRefused\(TapeRefusal\.groupCannotTakeUnit\);" dotAll="true" id="tape_edit.unit.closed_bracket_wins_over_edit">
            <mutation text="if (_endsWithClosedBracket) { return const TapeRefused(TapeRefusal.groupCannotTakeUnit);"/>
        </regex>

        <!-- RULE 17: a digit on a reopened recalled angle seals it and starts
             a chip at the end -->
        <regex pattern="if \(editing != null\) \{\s*return const TapeEntryRefused\(EntryRefusal\.alreadyAnAngle\);\s*\}" dotAll="true" id="tape_edit.digit.recalled_angle_sealed_mid_edit">
            <mutation text=""/>
        </regex>

        <!-- RULE 18: the strip's answer lands over an emptied edit, dropping
             the chip -->
        <regex pattern="if \(editing != null\) \{\s*return _leavingEdit\(\(tape\) => tape\.landAnswer\(key, value\)\);\s*\}" dotAll="true" id="tape_edit.land_answer.guard_dropped">
            <mutation text=""/>
        </regex>

        <!-- RULE 14: the active chip is only ever the last one -->
        <regex pattern="for \(var index = chips\.length - 1; index &gt;= 0; index--\) \{\s*if \(chips\[index\] case ValueChip\(isActive: true\)\) return index;\s*\}\s*return null;" dotAll="true" id="tape_edit.active.last_only">
            <mutation text="if (chips.lastOrNull case ValueChip(isActive: true)) return chips.length - 1; return null;"/>
        </regex>
    
        <!-- RULE 8b: = on a broken edit seals it anyway -->
        <regex pattern="if \(editing != null\) \{\s*final closed = _withFractionClosedAsInches\(\);\s*if \(closed\._unfinished case final refusal\?\) return refusal;" dotAll="true" id="tape_edit.equals.guard_dropped">
            <mutation text="if (editing != null) { final closed = _withFractionClosedAsInches();"/>
        </regex>
    </rules>

    <commands>
        <command group="tape_edit" expected-return="0">flutter test test/libraries/calculator_engine/units/tape_edit_test.dart test/libraries/calculator_engine/units/tape_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
