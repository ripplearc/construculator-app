<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR ENGINE TRIG MUTATION TESTING (F1a CA-1069, F1b CA-1302) -->
    <!-- Targets: TrigFunction (the ratio of an angle, the angle of a ratio,
         where the tangent has none and where a ratio is out of range), the
         trig keys on the tape (postfix answer, prefix chip, the answers a
         key takes, refusals) and the trig reading of a value chip. Critical path: a wrong function or a
         missing guard prints a confident wrong number, as the prototype once
         printed 16,331,239,353,195,370 for TAN 90 and 0° for 1800 [COS]
         [ACOS]. -->

    <files>
        <file>lib/libraries/calculator_engine/trig.dart</file>
        <file>lib/libraries/calculator_engine/tape.dart</file>
        <file>lib/libraries/calculator_engine/models/chip.dart</file>
        <file>lib/libraries/calculator_engine/quantity_formatter.dart</file>
        <file>lib/libraries/calculator_engine/chain_evaluator.dart</file>
    </files>

    <rules>
        <!-- RULE 1: the functions are swapped, or the angle is read in
             radians -->
        <regex pattern="sine =&gt; Scalar\(math\.sin\(radians\), decimals: ratioDecimals\)," dotAll="true" id="trig.sine.is_cosine">
            <mutation text="sine =&gt; Scalar(math.cos(radians), decimals: ratioDecimals),"/>
        </regex>
        <regex pattern="cosine =&gt; Scalar\(math\.cos\(radians\), decimals: ratioDecimals\)," dotAll="true" id="trig.cosine.is_sine">
            <mutation text="cosine =&gt; Scalar(math.sin(radians), decimals: ratioDecimals),"/>
        </regex>
        <regex pattern=": Scalar\(math\.tan\(radians\), decimals: ratioDecimals\)," dotAll="true" id="trig.tangent.is_sine">
            <mutation text=": Scalar(math.sin(radians), decimals: ratioDecimals),"/>
        </regex>
        <regex pattern="final radians = operand \* math\.pi / _halfTurn;" dotAll="true" id="trig.radians.unconverted">
            <mutation text="final radians = operand;"/>
        </regex>

        <!-- RULE 2: the tangent of 90° is answered, or only 90° itself is
             refused -->
        <regex pattern="if \(!operand\.isFinite\) return null;" dotAll="true" id="trig.infinite.answers">
            <mutation text=""/>
        </regex>
        <regex pattern="_isOddQuarterTurn\(operand\)\s*\? null" dotAll="true" id="trig.tangent.no_guard">
            <mutation text="false ? null"/>
        </regex>
        <regex pattern="\(\(degrees % _halfTurn\) - _quarterTurn\)\.abs\(\) &lt; _quarterTurnTolerance;" dotAll="true" id="trig.tangent.only_ninety">
            <mutation text="(degrees - _quarterTurn).abs() &lt; _quarterTurnTolerance;"/>
        </regex>

        <!-- RULE 3: every key names a trig function -->
        <regex pattern="if \(function\.key == key\) return function;" dotAll="true" id="trig.named.any_key">
            <mutation text="return function;"/>
        </regex>

        <!-- RULE 4: a ratio is rounded like a plain result -->
        <regex pattern="Scalar\(:final decimals\?\) =&gt; _jsRoundedNumber\(\s*value\.value,\s*decimals," dotAll="true" id="trig.ratio.two_decimals">
            <mutation text="Scalar(:final decimals?) =&gt; _jsRoundedNumber(value.value, resultDecimals,"/>
        </regex>

        <!-- RULE 5: a trig chip still wants a unit, or a forward chip does
             not name its degrees (rule 4.11: "Sine · degrees 38°"), or an
             inverse chip reads its ratio as degrees, or an empty chip is not
             renamed -->
        <regex pattern="keyWantsUnit: false,\s*readsDegrees: !function\.isInverse,\s*\);" dotAll="true" id="trig.key.chip_form">
            <mutation text="keyWantsUnit: true, readsDegrees: !function.isInverse, );"/>
            <mutation text="keyWantsUnit: false, readsDegrees: false, );"/>
            <mutation text="keyWantsUnit: false, readsDegrees: true, );"/>
        </regex>
        <regex pattern="return _replaceLast\(_asTrigChip\(chip, function\)\);" dotAll="true" id="trig.key.no_rename">
            <mutation text="return _replaceLast(chip);"/>
        </regex>

        <!-- RULE 6: a named bare number is answered postfix, or a length is
             opened as a fresh chip -->
        <regex pattern="\} else if \(chip\.key == null &amp;&amp; chip\.operator == null\) \{" dotAll="true" id="trig.key.postfix_on_named">
            <mutation text="} else if (chip.operator == null) {"/>
        </regex>
        <regex pattern="case final Quantity _:\s*return const TapeRefused\(TapeRefusal\.trigNeedsAPlainAngle\);" dotAll="true" id="trig.key.length_accepted">
            <mutation text="case final Quantity _: break;"/>
        </regex>

        <!-- RULE 7: the refused tangent says the wrong thing, or the eaten
             number does not become the trig chip the prefix order lands -->
        <regex pattern="degrees\.isFinite\s*\?\s*TapeRefusal\.tangentUndefined\s*:\s*TapeRefusal\.trigCannotAnswer," dotAll="true" id="trig.key.tangent_reason">
            <mutation text="TapeRefusal.trigCannotAnswer,"/>
            <mutation text="TapeRefusal.tangentUndefined,"/>
        </regex>
        <regex pattern="_replaceActive\(\s*_asTrigChip\(chip, function\),\s*\)" dotAll="true" id="trig.key.postfix_other_tape">
            <mutation text="_replaceActive(chip)"/>
        </regex>

        <!-- RULE 8: a unit on a trig number gets the plain-number toast -->
        <regex pattern="if \(chip\.trigFunction != null\) \{\s*return const TapeRefused\(TapeRefusal\.trigTakesAnAngle\);" dotAll="true" id="trig.unit.plain_number_reason">
            <mutation text="if (false) { return const TapeRefused(TapeRefusal.trigTakesAnAngle);"/>
        </regex>

        <!-- RULE 9: an undefined trig chip's digits are used in its place -->
        <regex pattern="if \(chip != null &amp;&amp; chip\.asksAnUndefinedTrig\) \{" dotAll="true" id="trig.undefined.left">
            <mutation text="if (false) {"/>
        </regex>
        <regex pattern="\(final function\?, final operand\?\) =&gt; function\.answerTo\(operand\) == null," dotAll="true" id="trig.undefined.never">
            <mutation text="(final function?, final operand?) =&gt; false,"/>
        </regex>

        <!-- RULE 10: a trig chip is worth its digits, or every bare named
             chip asks a trig function -->
        <regex pattern="if \(trigOperand case final operand\?\) \{\s*return trigFunction\?\.answerTo\(operand\);\s*\}" dotAll="true" id="trig.chip.worth_digits">
            <mutation text=""/>
        </regex>
        <regex pattern="function\.isInverse\s*\? Scalar\(number\)\s*: switch \(exactValue\) \{\s*final Angle recalled =&gt; recalled,\s*_ =&gt; _typedAngle,\s*\}," dotAll="true" id="trig.chip.operand_kind">
            <mutation text="_typedAngle,"/>
            <mutation text="Scalar(number),"/>
        </regex>

        <!-- RULE 10b: a trig key is accepted inside a bracket -->
        <regex pattern="pressTrigKey\(TrigFunction function\) \{\s*if \(openBracket != null\) \{" dotAll="true" id="trig.key.inside_bracket">
            <mutation text="pressTrigKey(TrigFunction function) { if (false) {"/>
        </regex>

        <!-- RULE 10c: the tangent's tolerance widens, so 89.9999° is refused,
             or narrows, so 89.9999999999° answers -->
        <regex pattern="static const double _quarterTurnTolerance = 1e-9;" dotAll="true" id="trig.tangent.tolerance">
            <mutation text="static const double _quarterTurnTolerance = 1e-3;"/>
            <mutation text="static const double _quarterTurnTolerance = 1e-12;"/>
        </regex>

        <!-- RULE 11: a trig chip feeds the rules -->
        <regex pattern="when chip\.isReadable &amp;&amp; chip\.trigFunction == null\)" dotAll="true" id="trig.named_values.include_trig">
            <mutation text="when chip.isReadable)"/>
        </regex>

        <!-- RULE 12 (F1b): the inverse functions are swapped, or answer in
             radians -->
        <regex pattern="final ratio\? =&gt; _angle\(math\.asin\(ratio\)\)," dotAll="true" id="trig.inverse.arcsine_is_arccosine">
            <mutation text="final ratio? =&gt; _angle(math.acos(ratio)),"/>
        </regex>
        <regex pattern="final ratio\? =&gt; _angle\(math\.acos\(ratio\)\)," dotAll="true" id="trig.inverse.arccosine_is_arcsine">
            <mutation text="final ratio? =&gt; _angle(math.asin(ratio)),"/>
        </regex>
        <regex pattern="arctangent =&gt; _angle\(math\.atan\(operand\)\)," dotAll="true" id="trig.inverse.arctangent_is_arcsine">
            <mutation text="arctangent =&gt; _angle(math.asin(operand)),"/>
        </regex>
        <regex pattern="Angle\(radians \* _halfTurn / math\.pi\);" dotAll="true" id="trig.inverse.radians">
            <mutation text="Angle(radians);"/>
        </regex>

        <!-- RULE 13 (F1b): a ratio beyond ±1 answered, or float noise past
             ±1 refused or widened. "< 1" for "<= 1" is equivalent now: at
             exactly ±1 the noise line answers ±1 too. -->
        <regex pattern="if \(operand\.abs\(\) &lt;= 1\) return operand;" dotAll="true" id="trig.inverse.range">
            <mutation text="return operand;"/>
        </regex>
        <regex pattern="if \(operand\.abs\(\) - 1 &lt; _floatNoiseBeyondOne\) return operand\.sign;" dotAll="true" id="trig.inverse.noise_refused">
            <mutation text="if (false) return operand.sign;"/>
        </regex>
        <regex pattern="static const double _floatNoiseBeyondOne = 1e-9;" dotAll="true" id="trig.inverse.noise_tolerance">
            <mutation text="static const double _floatNoiseBeyondOne = 1e-6;"/>
        </regex>

        <!-- RULE 14 (F1b): a function is filed under the wrong family -->
        <regex pattern="sine \|\| cosine \|\| tangent =&gt; false," dotAll="true" id="trig.inverse.forward_is_inverse">
            <mutation text="sine || cosine || tangent =&gt; true,"/>
        </regex>
        <regex pattern="arcsine \|\| arccosine \|\| arctangent =&gt; true," dotAll="true" id="trig.inverse.inverse_is_forward">
            <mutation text="arcsine || arccosine || arctangent =&gt; false,"/>
        </regex>

        <!-- RULE 15 (F1b): a function takes the wrong kind of value -->
        <regex pattern="\(false, Angle\(:final degrees\)\) =&gt; of\(degrees\)," dotAll="true" id="trig.answer_to.inverse_takes_angle">
            <mutation text="(_, Angle(:final degrees)) =&gt; of(degrees),"/>
        </regex>
        <regex pattern="\(_, Scalar\(:final value\)\) =&gt; of\(value\)," dotAll="true" id="trig.answer_to.forward_refuses_number">
            <mutation text="(true, Scalar(:final value)) =&gt; of(value),"/>
        </regex>

        <!-- RULE 16 (F1b): a rebuilt answer loses its reading or its
             operator -->
        <regex pattern="\(final Angle angle, Angle\(:final spelling\)\) =&gt; angle\.spelledAs\(spelling\)," dotAll="true" id="trig.rebuilt.loses_spelling">
            <mutation text="(final Angle angle, Angle(:final spelling)) =&gt; angle,"/>
        </regex>
        <regex pattern="value: kept, operator: answer\.operator\);" dotAll="true" id="trig.rebuilt.loses_operator">
            <mutation text="value: kept);"/>
        </regex>

        <!-- RULE 17 (F1b): a trig key takes the wrong answer, or a wrong
             value, after its number -->
        <regex pattern="Scalar\(\) when function\.isInverse &amp;&amp; TrigFunction\.named\(key\) == null =&gt;" dotAll="true" id="trig.key.inverse_eats_trig_answer">
            <mutation text="Scalar() when function.isInverse =&gt;"/>
        </regex>
        <regex pattern="Angle\(\) when !function\.isInverse =&gt; value," dotAll="true" id="trig.key.forward_skips_angle">
            <mutation text="Angle() when false =&gt; value,"/>
        </regex>
        <regex pattern="if \(chip\.operator == Operator\.divide &amp;&amp; chip\.isReadable\) \{" dotAll="true" id="trig.key.any_operator_ratio">
            <mutation text="if (chip.operator != null &amp;&amp; chip.isReadable) {"/>
        </regex>
        <regex pattern="ChainFailed\(\) =&gt; pressEquals\(\)," dotAll="true" id="trig.key.failed_division_hidden">
            <mutation text="ChainFailed() =&gt; null,"/>
        </regex>
        <regex pattern="if \(chip\.trigFunction != null\) return null;" dotAll="true" id="trig.key.inverse_reads_trig_chip">
            <mutation text=""/>
        </regex>
        <regex pattern="if \(value is Angle\) return const TapeRefused\(TapeRefusal\.ratioOutOfRange\);" dotAll="true" id="trig.key.inverse_takes_angle">
            <mutation text=""/>
        </regex>
        <regex pattern="if \(operand is! Scalar &amp;&amp; operand is! Angle\) \{" dotAll="true" id="trig.key.length_out_of_range">
            <mutation text="if (false) {"/>
        </regex>
        <regex pattern="when !number\.isFinite\) \{\s*return const TapeRefused\(TapeRefusal\.trigCannotAnswer\);\s*\}" dotAll="true" id="trig.key.infinite_ratio_reason">
            <mutation text="when false) { return const TapeRefused(TapeRefusal.trigCannotAnswer); }"/>
        </regex>
        <regex pattern="\? TapeRefusal\.ratioOutOfRange\s*: TapeRefusal\.tangentUndefined," dotAll="true" id="trig.key.refusals_swapped">
            <mutation text="? TapeRefusal.tangentUndefined : TapeRefusal.ratioOutOfRange,"/>
        </regex>

        <!-- RULE 18 (F1b, R1, R2): the ratio ATAN reaches across is built
             wrong, reached by another function, joined by any chip, walked
             past an answer, or a lone ATAN is read at its digits -->
        <regex pattern="if \(divisor\.number == 0\) return null;" dotAll="true" id="trig.reach.divides_by_zero">
            <mutation text="if (false) return null;"/>
        </regex>
        <regex pattern="ratio /= divisor\.number;" dotAll="true" id="trig.reach.multiplies">
            <mutation text="ratio *= divisor.number;"/>
        </regex>
        <regex pattern="if \(chip is! ValueChip \|\| chip\.trigFunction != TrigFunction\.arctangent\) \{\s*return null;\s*\}\s*final digits = chip\.bareNumber;" dotAll="true" id="trig.reach.any_function">
            <mutation text="if (chip is! ValueChip || chip.trigFunction == null) { return null; } final digits = chip.bareNumber;"/>
            <mutation text="if (chip is! ValueChip) { return null; } final digits = chip.bareNumber;"/>
        </regex>
        <regex pattern="ValueChip\(:final bareNumber\?, :final entry\)\s*when chip\.dividesAnArctangentRatio =&gt;" dotAll="true" id="trig.reach.any_operator">
            <mutation text="ValueChip(:final bareNumber?, :final entry) =&gt;"/>
        </regex>
        <regex pattern="if \(divisor == null\) break;\s*divisors\.add\(divisor\);\s*end = next \+ 1;\s*\}\s*if \(divisors\.isEmpty\) return null;" dotAll="true" id="trig.reach.walks_past_an_answer">
            <mutation text="if (divisor == null) { end = next + 1; continue; } divisors.add(divisor); end = next + 1; } if (divisors.isEmpty) return null;"/>
            <mutation text="if (divisor == null) break; divisors.add(divisor); end = next + 1; }"/>
        </regex>
        <regex pattern="key == null &amp;&amp; operator == Operator\.divide &amp;&amp; bareNumber != null;" dotAll="true" id="trig.reach.named_divisor">
            <mutation text="operator == Operator.divide &amp;&amp; bareNumber != null;"/>
            <mutation text="key == null &amp;&amp; bareNumber != null;"/>
        </regex>
        <regex pattern="key: '\$\{function\.key\}\(\$\{reach\.spelling\}\)'," dotAll="true" id="trig.reach.unnamed_operand">
            <mutation text="key: function.key,"/>
        </regex>
        <regex pattern="chip\.entry\.text,\s*for \(final divisor in divisors\) '\$\{Operator\.divide\.symbol\} \$\{divisor\.text\}'," dotAll="true" id="trig.reach.no_operator_in_name">
            <mutation text="'${chip.operator?.symbol ?? ''} ${chip.entry.text}', for (final divisor in divisors) '${Operator.divide.symbol} ${divisor.text}',"/>
            <mutation text="chip.entry.text, for (final divisor in divisors) divisor.text,"/>
        </regex>

        <!-- RULE 18b (F1b, R2): the divisor ÷ 0 reopened after its error
             chip is dropped from the ratio, or the tape's question stops at
             that error chip -->
        <regex pattern="if \(chips\[index\] case ErrorChip\(\s*error: CalculationError\.divisionByZero,\s*\) when index \+ 1 &lt; chips\.length\) \{\s*return index \+ 1;\s*\}" dotAll="true" id="trig.reach.error_chip_stops">
            <mutation text="if (false) { return index + 1; }"/>
        </regex>
        <regex pattern="if \(chip case ErrorChip\(error: CalculationError\.divisionByZero\)\) continue;\s*if \(chip case BracketChip\(isOpen: false\)\) continue;" dotAll="true" id="trig.question.stops_at_error_or_bracket">
            <mutation text="if (chip case BracketChip(isOpen: false)) continue;"/>
            <mutation text="if (chip case ErrorChip(error: CalculationError.divisionByZero)) continue;"/>
        </regex>

        <!-- RULE 18c (F1b, R2): a bracket joins the ratio without a ÷, is
             named by its raw double, or offers no answer while it ends the
             tape -->
        <regex pattern="BracketChip\(operator: Operator\.divide, isOpen: false, :final inner\) =&gt;" dotAll="true" id="trig.reach.bracket_without_divide">
            <mutation text="BracketChip(isOpen: false, :final inner) =&gt;"/>
        </regex>
        <regex pattern="text: const QuantityFormatter\(\)\.format\(\s*Scalar\(value\),\s*groupThousands: false,\s*\)," dotAll="true" id="trig.reach.bracket_named_raw">
            <mutation text="text: '$value',"/>
        </regex>
        <regex pattern="if \(active == null &amp;&amp; chips\.lastOrNull is! BracketChip\) return null;" dotAll="true" id="trig.answer.silent_on_bracket">
            <mutation text="if (active == null) return null;"/>
        </regex>

        <!-- RULE 19 (F1b, R1): = lands the Calc of the digits, lands the lone
             angle of an ATAN that continues a chain, or lands a lone trig
             answer the caller owns -->
        <regex pattern="if \(tape\._trigQuestion case \(\s*chip: ValueChip\(operator: null\),\s*reach: ArctangentReach\(\),\s*\)\) \{" dotAll="true" id="trig.equals.reach">
            <mutation text="if (false) {"/>
            <mutation text="if (tape._trigQuestion case (chip: _, reach: ArctangentReach())) {"/>
            <mutation text="if (tape._trigQuestion case (chip: ValueChip(operator: null), reach: _)) {"/>
        </regex>

        <!-- RULE 20 (F1b, R1): the chain reads the digits of a sealed ratio,
             or of an ATAN that continues a chain, or never reads them, or
             drops the divisors of a sealed ratio -->
        <regex pattern="if \(reach != null &amp;&amp; reach\.end == chips\.length &amp;&amp; operator == null\) \{" dotAll="true" id="trig.chain.reads_angle">
            <mutation text="if (false) {"/>
            <mutation text="if (reach != null &amp;&amp; operator == null) {"/>
            <mutation text="if (reach != null &amp;&amp; reach.end == chips.length) {"/>
        </regex>
        <regex pattern="reading = \(value: angle, steps: reach\.divisors\.length\);\s*next = end;" dotAll="true" id="trig.chain.sealed_keeps_divisors">
            <mutation text="reading = (value: angle, steps: reach.divisors.length);"/>
        </regex>

        <!-- RULE 21 (F1b): postfix inverse leaves its ratio a bare number, so
             the two orders land two tapes (rule 4.11) -->
        <regex pattern="_replaceActive\(_asTrigChip\(chip, function\)\),\s*function,\s*value," dotAll="true" id="trig.inverse.postfix_other_tape">
            <mutation text="this, function, value,"/>
        </regex>

        <!-- RULE 22 (F1b, R2): a rebuilt answer reads a trig operand chip at
             its answer, a reach answer as a lone function, or rewrites a
             Calc that is not a trig answer -->
        <regex pattern="final ValueChip chip when chip\.trigFunction != null =&gt; chip\.trigOperand," dotAll="true" id="trig.rebuilt.operand_at_answer">
            <mutation text=""/>
        </regex>
        <regex pattern="\) when key != function\.key &amp;&amp; _isAnswerOf\(answer, function\)\) \{" dotAll="true" id="trig.rebuilt.reach_lost">
            <mutation text=") when false) {"/>
            <mutation text=") when key != function.key) {"/>
        </regex>

        <!-- RULE CA-1236 (R6, B7): a trig answer above the limit lands as a
             result instead of the Too large chip -->
        <regex pattern="formatter\.isTooLarge\(answer\)\s*\? const ErrorChip\(CalculationError\.outOfRange\)\s*: ResultChip\(key: key, value: answer\);" dotAll="true" id="tape.landed_answer.never_too_large">
            <mutation text="ResultChip(key: key, value: answer);"/>
        </regex>

        <!-- RULE CA-1236 (R6, B7): the strip offers a trig answer above the
             limit -->
        <regex pattern="if \(answer == null \|\| formatter\.isTooLarge\(answer\)\) return null;" id="tape.trig_answer.offers_too_large">
            <mutation text="if (answer == null) return null;"/>
        </regex>

        <!-- RULE CA-1236 (R6, B7): = on a prefix trig chip whose answer is
             above the limit lands nothing -->
        <regex pattern="if \(tape\._offersATooLargeTrigAnswer\) \{" id="tape.press_equals.too_large_trig_not_landed">
            <mutation text="if (false) {"/>
        </regex>
    </rules>

    <commands>
        <command group="trig" expected-return="0">flutter test test/libraries/calculator_engine/units/trig_test.dart test/libraries/calculator_engine/units/tape_trig_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
