<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- THE ARBITER: THE LADDER THAT CHOOSES THE STRIP (G1, CA-1072; UX
         Design Doc rule 4.4) -->
    <!-- Targets: when the strip is silent and why (RULES 1-5); what the
         rules rung offers, in what order, and the rung and trace it leaves
         (RULES 6-12); which area the trade rung counts, which counts it
         still offers, and the rung and trace it leaves (RULES 13-22); the
         area a silent strip still names and the order of row 1 (RULES 18a
         to 18d); how an accepted count hides its offer, by size or by value
         (RULES 17, 17a, 17b). -->

    <files>
        <file>lib/libraries/calculator_engine/arbiter.dart</file>
        <file>lib/libraries/calculator_engine/models/arbitration.dart</file>
        <file>lib/libraries/calculator_engine/models/trade_stores.dart</file>
        <file>lib/libraries/calculator_engine/tape.dart</file>
    </files>

    <rules>
        <!-- RULE 1: an open bracket is not a silence of its own -->
        <regex pattern="if \(tape\.openBracket != null\) return StripSilence\.openBracket;" dotAll="true" id="arbiter.silence.open_bracket_answers">
            <mutation text=""/>
            <mutation text="if (tape.openBracket != null) return StripSilence.chainFailed;"/>
        </regex>

        <!-- RULE 2: a step the chain cannot compute is not silent -->
        <regex pattern="ChainFailed\(\) =&gt; true," dotAll="true" id="arbiter.silence.failed_chain_answers">
            <mutation text="ChainFailed() =&gt; false,"/>
        </regex>

        <!-- RULE 3: an error chip the chain ends on is not silent -->
        <regex pattern="ChainValue\(\) \|\| ChainEmpty\(\) =&gt; _chainHoldsAnError\(tape\)," dotAll="true" id="arbiter.silence.error_chip_answers">
            <mutation text="ChainValue() || ChainEmpty() =&gt; false,"/>
            <mutation text="ChainValue() || ChainEmpty() =&gt; true,"/>
        </regex>

        <!-- RULE 4: an error chip is read as no error, or a result after it
             as one -->
        <regex pattern="case ErrorChip\(\):\s*return true;\s*case ResultChip\(\):\s*return false;" dotAll="true" id="arbiter.silence.which_chip_ends_the_look_back">
            <mutation text="case ErrorChip(): return false; case ResultChip(): return false;"/>
            <mutation text="case ErrorChip(): return true; case ResultChip(): return true;"/>
        </regex>

        <!-- RULE 5: the look back runs past the start of the chain, so an
             error chip silences a value typed after it -->
        <regex pattern="if \(operator == null\) return false;" dotAll="true" id="arbiter.silence.looks_past_the_chain">
            <mutation text=""/>
        </regex>

        <!-- RULE 6: a value that is no calculation is offered as Calc -->
        <regex pattern="ChainValue\(:final value, isCalculation: true\) =&gt; StripOffer\(" dotAll="true" id="arbiter.rules.calc_without_a_calculation">
            <mutation text="ChainValue(:final value) =&gt; StripOffer("/>
        </regex>

        <!-- RULE 7: a trig chip leads when it continues a chain, and
             follows when it stands alone -->
        <regex pattern="final trigLeads = trigAnswer != null &amp;&amp; !tape\.trigAnswerContinuesAChain;" dotAll="true" id="arbiter.rules.trig_leads">
            <mutation text="final trigLeads = trigAnswer != null &amp;&amp; tape.trigAnswerContinuesAChain;"/>
            <mutation text="final trigLeads = trigAnswer != null;"/>
        </regex>

        <!-- RULE 8: the rule answers stay beside the running total, or
             behind an accepted count -->
        <regex pattern="final ruleOffers = runningTotal != null \|\| accepted\.isNotEmpty" dotAll="true" id="arbiter.rules.answers_where_the_ladder_stopped">
            <mutation text="final ruleOffers = runningTotal != null"/>
            <mutation text="final ruleOffers = accepted.isNotEmpty"/>
        </regex>

        <!-- RULE 9: a trig chip that continues a chain is dropped from the
             row -->
        <regex pattern="if \(trigAnswer != null &amp;&amp; !trigLeads\) trigAnswer," dotAll="true" id="arbiter.rules.chained_trig_dropped">
            <mutation text=""/>
        </regex>

        <!-- RULE 10: an answer already on the tape is offered again -->
        <regex pattern="if \(!tape\.chips\.any\(\s*\(chip\) =&gt; chip is ResultChip &amp;&amp; _lands\(chip, answer\.key\),\s*\)\)" dotAll="true" id="arbiter.rules.landed_answer_offered_again">
            <mutation text="if (true)"/>
        </regex>

        <!-- RULE 11: the rules rung is not said for a trig chip, for the
             running total or for the rule answers -->
        <regex pattern="trigAnswer != null \|\| runningTotal != null \|\| ruleOffers\.isNotEmpty;" dotAll="true" id="arbiter.rung.rules">
            <mutation text="runningTotal != null || ruleOffers.isNotEmpty;"/>
            <mutation text="trigAnswer != null || ruleOffers.isNotEmpty;"/>
            <mutation text="trigAnswer != null || runningTotal != null;"/>
        </regex>

        <!-- RULE 12: the trace says the rules rung answered when it did
             not, or the rung is the rules' whatever the tape -->
        <regex pattern="LadderStep\(LadderRung\.rules, applies: answers\)," dotAll="true" id="arbiter.trace.rules">
            <mutation text="const LadderStep(LadderRung.rules, applies: true),"/>
        </regex>
        <regex pattern=": \(answers \? LadderRung\.rules : LadderRung\.none\)," dotAll="true" id="arbiter.rung.always_rules">
            <mutation text=": LadderRung.rules,"/>
            <mutation text=": LadderRung.none,"/>
        </regex>

        <!-- RULE 13: every result is a count, or none is -->
        <regex pattern="Trade\.values\.any\(\(trade\) =&gt; trade\.resultKey == chip\.key\);" dotAll="true" id="arbiter.counts.which_result_is_a_count">
            <mutation text="true;"/>
            <mutation text="false;"/>
        </regex>

        <!-- RULE 14: the area is looked for on the last count, not before
             the counts; or a tape of counts alone is read out of range -->
        <regex pattern="final before = chips\.length - counts - 1;\s*return before &lt; 0 \? null : chips\[before\];" dotAll="true" id="arbiter.counts.area_before_the_counts">
            <mutation text="final before = chips.length - counts; return before &lt; 0 ? null : chips[before];"/>
            <mutation text="final before = chips.length - counts - 1; return chips[before];"/>
        </regex>

        <!-- RULE 15: with no count accepted the area is not read off the
             display -->
        <regex pattern="if \(counts == 0\) return beingTyped \?\? chips\.lastOrNull;" dotAll="true" id="arbiter.counts.area_on_the_display">
            <mutation text="if (counts != 0) return beingTyped ?? chips.lastOrNull;"/>
        </regex>

        <!-- RULE 16: a Calc that is an area is counted -->
        <regex pattern="ResultChip\(value: final Area area, :final key\) when key != calcKey =&gt; area," dotAll="true" id="arbiter.counts.calc_is_counted">
            <mutation text="ResultChip(value: final Area area) =&gt; area,"/>
        </regex>

        <!-- RULE 17: an accepted count stays on offer -->
        <regex pattern="if \(!landed\.remove\(\(count\.trade\.resultKey, count\.size\)\) &amp;&amp;\s*!landed\.remove\(\(count\.trade\.resultKey, count\.value\)\)\)" dotAll="true" id="arbiter.counts.accepted_stays_on_offer">
            <mutation text="if (true)"/>
            <mutation text="if (landed.remove((count.trade.resultKey, count.size)) || landed.remove((count.trade.resultKey, count.value)))"/>
        </regex>

        <!-- RULE 17a: a count that names no size hides no offer -->
        <regex pattern="if \(!landed\.remove\(\(count\.trade\.resultKey, count\.size\)\) &amp;&amp;\s*!landed\.remove\(\(count\.trade\.resultKey, count\.value\)\)\)" dotAll="true" id="arbiter.counts.sizeless_count_stays_on_offer">
            <mutation text="if (!landed.remove((count.trade.resultKey, count.size)))"/>
        </regex>

        <!-- RULE 17b: a count that carries its size hides the first offer
             of its value instead of the offer of its size -->
        <regex pattern="\(chip\.key, chip\.size \?\? chip\.value\)," dotAll="true" id="arbiter.counts.sized_count_hides_by_value">
            <mutation text="(chip.key, chip.value),"/>
        </regex>

        <!-- RULE 18: every area is counted in masonry pieces, or in
             sheets; or a trade counts by the other trade's sizes -->
        <regex pattern="final trade = tape\.countedAreaTrade;" dotAll="true" id="arbiter.counts.wrong_trade">
            <mutation text="const trade = Trade.masonry;"/>
            <mutation text="const trade = Trade.drywall;"/>
        </regex>
        <regex pattern="_trades\.countsFor\(trade, area, stores\.sizesFor\(trade\)\);" dotAll="true" id="arbiter.counts.other_trades_sizes">
            <mutation text="_trades.countsFor(trade, area, stores.sizesFor(Trade.drywall));"/>
            <mutation text="_trades.countsFor(Trade.drywall, area, stores.sizesFor(trade));"/>
        </regex>

        <!-- RULE 18e: the Area a trade key named is offered again behind
             its counts; a covered area is counted for the wrong trade -->
        <regex pattern="chip\.key == key \|\| chip\.namedFrom == key;" dotAll="true" id="arbiter.rules.named_area_offered_again">
            <mutation text="chip.key == key;"/>
        </regex>
        <regex pattern="ResultChip\(:final key\) when key == Trade\.masonry\.coveredAreaKey =&gt;\s*Trade\.masonry," dotAll="true" id="arbiter.counts.masonry_area_counted_in_sheets">
            <mutation text="ResultChip(:final key) when key == Trade.drywall.coveredAreaKey =&gt; Trade.masonry,"/>
            <mutation text="ResultChip(:final key) when key == Trade.masonry.coveredAreaKey =&gt; Trade.drywall,"/>
        </regex>

        <!-- RULE 18a: a silent strip forgets the area on the display, or
             its counts -->
        <regex pattern="silence: silence,\s*countedArea: area,\s*counts: counts," dotAll="true" id="arbiter.silence.area_forgotten">
            <mutation text="silence: silence, counts: counts,"/>
            <mutation text="silence: silence, countedArea: area,"/>
        </regex>

        <!-- RULE 18b: the rule answers lead the counts, or one of the two
             never reaches row 1 -->
        <regex pattern="\.\.\.countOffers,\s*\.\.\.ruleOffers," dotAll="true" id="arbiter.offers.counts_behind_or_gone">
            <mutation text="...ruleOffers, ...countOffers,"/>
            <mutation text="...ruleOffers,"/>
            <mutation text="...countOffers,"/>
        </regex>

        <!-- RULE 18c: only the last count names its area, so the sizes left
             leave the strip once a second count is accepted -->
        <regex pattern="for \(final chip in chips\.reversed\.takeWhile\(_isACount\)\) chip as ResultChip," dotAll="true" id="arbiter.counts.second_count_loses_the_area">
            <mutation text="for (final chip in chips.reversed.take(1).where(_isACount)) chip as ResultChip,"/>
        </regex>

        <!-- RULE 18d: one accepted count hides every offer of its value -->
        <regex pattern="if \(!landed\.remove\(\(count\.trade\.resultKey, count\.size\)\) &amp;&amp;\s*!landed\.remove\(\(count\.trade\.resultKey, count\.value\)\)\)" dotAll="true" id="arbiter.counts.hides_every_offer_of_its_value">
            <mutation text="if (!landed.remove((count.trade.resultKey, count.size)) &amp;&amp; !landed.contains((count.trade.resultKey, count.value)))"/>
        </regex>

        <!-- RULE 19: the counts stay beside the running total -->
        <regex pattern="final countOffers = runningTotal != null\s*\? const &lt;StripOffer&gt;\[\]\s*: _notYetAccepted\(counts, accepted\);" dotAll="true" id="arbiter.rules.counts_beside_calc">
            <mutation text="final countOffers = _notYetAccepted(counts, accepted);"/>
        </regex>

        <!-- RULE 20: the trade rung is said only while a count is still on
             offer, or only once one is accepted -->
        <regex pattern="final follows = accepted\.isNotEmpty \|\| countOffers\.isNotEmpty;" dotAll="true" id="arbiter.rung.trade_follow_on">
            <mutation text="final follows = accepted.isNotEmpty;"/>
            <mutation text="final follows = countOffers.isNotEmpty;"/>
        </regex>

        <!-- RULE 21: the trace asks the rules after the trade rung
             answered, or says the trade rung did not answer -->
        <regex pattern="LadderStep\(LadderRung\.tradeFollowOn, applies: follows\),\s*if \(!follows\)" dotAll="true" id="arbiter.trace.trade">
            <mutation text="LadderStep(LadderRung.tradeFollowOn, applies: follows), if (true)"/>
            <mutation text="const LadderStep(LadderRung.tradeFollowOn, applies: false), if (!follows)"/>
        </regex>

        <!-- RULE 22: a trade counts by the other trade's store -->
        <regex pattern="Trade\.drywall =&gt; sheetSizes,\s*Trade\.masonry =&gt; masonrySizes," dotAll="true" id="trade_stores.sizes_for.swapped">
            <mutation text="Trade.drywall =&gt; masonrySizes, Trade.masonry =&gt; sheetSizes,"/>
        </regex>
    </rules>

    <commands>
        <command group="arbiter" expected-return="0">flutter test test/libraries/calculator_engine/units/arbiter_test.dart test/libraries/calculator_engine/units/tape_trade_key_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
