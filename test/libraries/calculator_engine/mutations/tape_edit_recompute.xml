<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR ENGINE: THE RESULTS AFTER A REOPENED CHIP (S1c 2/5, CA-1089) -->
    <!-- Targets: the recompute of the results after the edited chip and the
         removal of one that cannot be rebuilt. Critical path: a wrong
         recompute shows a stale or a missing answer. -->

    <files>
        <file>lib/libraries/calculator_engine/tape.dart</file>
    </files>

    <rules>
        <!-- RULE 2: a result nothing can rebuild is kept at the seal too -->
        <regex pattern="\} else if \(!removesStale\) \{\s*kept\.add\(chip\);" dotAll="true" id="tape_edit.recompute.unrebuilt_kept">
            <mutation text="} else if (true) { kept.add(chip);"/>
        </regex>

        <!-- RULE 2a: a result nothing can rebuild is removed mid-edit -->
        <regex pattern="\} else if \(!removesStale\) \{\s*kept\.add\(chip\);" dotAll="true" id="tape_edit.recompute.unrebuilt_removed_mid_edit">
            <mutation text="} else if (false) { kept.add(chip);"/>
        </regex>

        <!-- RULE 2b: the seal keeps a stale result like a keystroke does -->
        <regex pattern="\)\._recomputedAfter\(index, removesStale: !chip\.isActive\);" dotAll="true" id="tape_edit.recompute.seal_keeps_stale">
            <mutation text=")._recomputedAfter(index, removesStale: false);"/>
        </regex>

        <!-- RULE 2c: a leaving key loses the name of the result the seal
             removed -->
        <regex pattern="TapeChanged\(tape: final after, :final notice\) when removed != null =>\s*_changed\(after, notice: notice, removed: removed\)," dotAll="true" id="tape_edit.recompute.leaving_key_unnamed">
            <mutation text="TapeChanged(tape: final after, :final notice) when removed != null => TapeChanged(after, notice: notice),"/>
        </regex>

        <!-- RULE 2d: an error chip is never rebuilt -->
        <regex pattern="case final ErrorChip error\s*when !_leadsIntoAnOperator\(first \+ offset\):\s*rebuilt = _with\(kept\)\._rebuiltError\(error\);" dotAll="true" id="tape_edit.recompute.error_chip_kept">
            <mutation text="case ErrorChip(): kept.add(chip); continue;"/>
        </regex>

        <!-- RULE 2e: the error chip before a reopened divisor is rebuilt too -->
        <regex pattern="when !_leadsIntoAnOperator\(first \+ offset\):" dotAll="true" id="tape_edit.recompute.divisor_error_rebuilt">
            <mutation text="when true:"/>
        </regex>

        <!-- RULE 2g: a Calc whose chain fails at the seal is removed instead
             of landing its error -->
        <regex pattern="ChainFailed\(:final error\) when failsAsError => ErrorChip\(error\)," dotAll="true" id="tape_edit.recompute.failed_calc_removed_at_seal">
            <mutation text=""/>
        </regex>

        <!-- RULE 2h: a Calc whose chain fails lands its error mid-edit -->
        <regex pattern="ChainFailed\(:final error\) when failsAsError => ErrorChip\(error\)," dotAll="true" id="tape_edit.recompute.failed_calc_errors_mid_edit">
            <mutation text="ChainFailed(:final error) => ErrorChip(error),"/>
        </regex>

        <!-- RULE 2f: a Calc is rebuilt from a lone operand -->
        <regex pattern="ChainValue\(:final value, isCalculation: true\) => ResultChip\(\s*key: calcKey,\s*value: value,\s*operator: result\.operator," dotAll="true" id="tape_edit.recompute.calc_from_lone_operand">
            <mutation text="ChainValue(:final value) => ResultChip(key: calcKey, value: value, operator: result.operator,"/>
        </regex>

        <!-- RULE 3: the removed result is not named -->
        <regex pattern="removed \?\?= key;" dotAll="true" id="tape_edit.recompute.removed_unnamed">
            <mutation text=""/>
        </regex>

        <!-- RULE 4: a named answer is matched to any key -->
        <regex pattern="if \(answer\.key == result\.key\) \{" dotAll="true" id="tape_edit.recompute.any_answer_matches">
            <mutation text="if (true) {"/>
        </regex>

    </rules>

    <commands>
        <command group="tape_edit_recompute" expected-return="0">flutter test test/libraries/calculator_engine/units/tape_edit_recompute_test.dart test/libraries/calculator_engine/units/tape_edit_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
