<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR ENGINE QUANTITY FORMATTER MUTATION TESTING -->
    <!-- Targets: QuantityFormatter, the one place a stored value becomes the
         text on screen. Critical path: rounding is part of the behaviour
         (UX Design Doc rule 4.15) and every result a user copies onto a
         takeoff sheet passes through here, so a fraction rounded to the
         wrong step, a carry lost at 12 inches, a tiny ratio shown as 0 or
         a thousands separator in the wrong place is a wrong answer that
         still looks like one. -->

    <files>
        <file>lib/libraries/calculator_engine/quantity_formatter.dart</file>
        <file>lib/libraries/calculator_engine/models/quantity.dart</file>
    </files>

    <rules>
        <!-- RULE 1: a remainder that rounds to a whole inch reads 16/16
             instead of carrying -->
        <regex pattern="if \(numerator == steps\) return \(text: '', carry: 1\);" dotAll="true" id="quantity_formatter.fraction.no_carry">
            <mutation text="if (false) return (text: '', carry: 1);"/>
        </regex>

        <!-- RULE 2: fractions are not reduced, so 8/16 stays 8/16 -->
        <regex pattern="while \(numerator\.isEven\) \{" dotAll="true" id="quantity_formatter.fraction.no_reduce">
            <mutation text="while (false) {"/>
        </regex>

        <!-- RULE 3: the resolution setting is ignored -->
        <regex pattern="final steps = preferences\.fractionResolution\.denominator;" dotAll="true" id="quantity_formatter.fraction.ignore_resolution">
            <mutation text="final steps = 16;"/>
        </regex>

        <!-- RULE 4: twelve inches no longer carry into a foot -->
        <regex pattern="if \(wholeInches == 12\) \{" dotAll="true" id="quantity_formatter.feet_and_inches.no_carry">
            <mutation text="if (false) {"/>
        </regex>

        <!-- RULE 5: a ratio below 0.1 is shown to two decimals, so 1 ÷ 78
             reads 0.01 -->
        <regex pattern="if \(value\.abs\(\) &gt;= 0\.1\) \{" dotAll="true" id="quantity_formatter.scalar.two_decimals_below_point_one">
            <mutation text="if (true) {"/>
        </regex>

        <!-- RULE 6: three significant digits instead of two -->
        <regex pattern="return double\.parse\(value\.toStringAsPrecision\(2\)\)\.toString\(\);" dotAll="true" id="quantity_formatter.scalar.three_significant">
            <mutation text="return double.parse(value.toStringAsPrecision(3)).toString();"/>
        </regex>

        <!-- RULE 7: Math.round becomes truncation -->
        <regex pattern="int _jsMathRound\(double value\) =&gt; \(value \+ 0\.5\)\.floor\(\);" dotAll="true" id="quantity_formatter.js_round.truncate">
            <mutation text="int _jsMathRound(double value) =&gt; value.floor();"/>
        </regex>

        <!-- RULE 8: half no longer rounds up -->
        <regex pattern="final roundUp = fraction\.codeUnitAt\(decimals\) &gt;= '5'\.codeUnitAt\(0\);" dotAll="true" id="quantity_formatter.round_decimal_text.half_down">
            <mutation text="final roundUp = fraction.codeUnitAt(decimals) &gt; '5'.codeUnitAt(0);"/>
        </regex>

        <!-- RULE 9: thousands are grouped in fours -->
        <regex pattern="if \(i &gt; 0 &amp;&amp; \(whole\.length - i\) % 3 == 0\) buffer\.write\(','\);" dotAll="true" id="quantity_formatter.grouped.by_four">
            <mutation text="if (i &gt; 0 &amp;&amp; (whole.length - i) % 4 == 0) buffer.write(',');"/>
        </regex>

        <!-- RULE 10: the metre display setting is ignored -->
        <regex pattern="preferences\.metreDisplay\.decimals," dotAll="true" id="quantity_formatter.length.ignore_metre_display">
            <mutation text="resultDecimals,"/>
        </regex>

        <!-- RULE 11: the ton setting is ignored at display -->
        <regex pattern="value\.unit\.hundredthsOfPoundPer\(poundsPerTon: preferences\.poundsPerTon\);" dotAll="true" id="quantity_formatter.weight.ignore_ton_setting">
            <mutation text="value.unit.hundredthsOfPoundPer(poundsPerTon: 2000);"/>
        </regex>

        <!-- RULE 12: a stored size under Metric is shown in inches -->
        <regex pattern="'\$\{_jsRoundedNumber\(inches \* millimetresPerInch, 0, false\)\}'" dotAll="true" id="quantity_formatter.stored_length.metric_in_inches">
            <mutation text="'${_localeNumber(inches, 0, false)}'"/>
        </regex>

        <!-- RULE 13: results stop grouping their thousands -->
        <regex pattern="if \(group\) text = _grouped\(text\);" dotAll="true" id="quantity_formatter.number.never_group">
            <mutation text="if (false) text = _grouped(text);"/>
        </regex>

        <!-- RULE 14: a fraction that rounds up to a whole inch is taken off
             instead of carried -->
        <regex pattern="whole \+= fraction\.carry;\s*final text =" dotAll="true" id="quantity_formatter.inches.carry_subtracted">
            <mutation text="whole -= fraction.carry; final text ="/>
        </regex>

        <!-- RULE 15: a stored size under Metric divides by the millimetres
             in an inch -->
        <regex pattern="inches \* millimetresPerInch, 0, false" dotAll="true" id="quantity_formatter.stored.divide_millimetres">
            <mutation text="inches / millimetresPerInch, 0, false"/>
        </regex>

        <!-- RULE 16: a zero remainder carries a whole inch -->
        <regex pattern="if \(numerator == 0\) return \(text: '', carry: 0\);" dotAll="true" id="quantity_formatter.fraction.zero_carries">
            <mutation text="if (numerator == 0) return (text: '', carry: 1);"/>
        </regex>

        <!-- RULE 17: the angle is truncated to whole seconds instead of
             rounded, so 29.99999° reads 29°59'59" -->
        <regex pattern="final totalSeconds = \(degrees\.abs\(\) \* secondsPerDegree \+ 0\.5\)\s*\.floorToDouble\(\);" dotAll="true" id="quantity_formatter.dms.truncate_seconds">
            <mutation text="final totalSeconds = (degrees.abs() * secondsPerDegree).floorToDouble();"/>
        </regex>

        <!-- RULE 17b: the seconds become an int, which clamps at 2^63, so a
             very large angle reads a different number in D:M:S -->
        <regex pattern="final totalSeconds = \(degrees\.abs\(\) \* secondsPerDegree \+ 0\.5\)\s*\.floorToDouble\(\);" dotAll="true" id="quantity_formatter.dms.int_seconds_clamp">
            <mutation text="final totalSeconds = _jsMathRound(degrees.abs() * secondsPerDegree).toDouble();"/>
        </regex>

        <!-- RULE 17c: the whole degrees keep the seconds' remainder, so
             1234.5° rounds up to 1,235° -->
        <regex pattern="final wholeDegrees = \(totalSeconds - rest\) / secondsPerDegree;" dotAll="true" id="quantity_formatter.dms.degrees_keep_remainder">
            <mutation text="final wholeDegrees = totalSeconds / secondsPerDegree;"/>
        </regex>

        <!-- RULE 17d: the degrees of a D:M:S answer never group their
             thousands -->
        <regex pattern="\$\{_localeNumber\(wholeDegrees, 0, group\)\}" dotAll="true" id="quantity_formatter.dms.never_group">
            <mutation text="${_localeNumber(wholeDegrees, 0, false)}"/>
        </regex>

        <!-- RULE 18: minutes are taken from the whole count instead of the
             remainder after the degrees -->
        <regex pattern="final minutes = rest ~/ secondsPerMinute;" dotAll="true" id="quantity_formatter.dms.minutes_not_remainder">
            <mutation text="final minutes = totalSeconds.toInt() ~/ secondsPerMinute;"/>
        </regex>

        <!-- RULE 19: the minus is dropped, or written on a zero -->
        <regex pattern="final sign = degrees &lt; 0 &amp;&amp; totalSeconds &gt; 0 \? '-' : '';" dotAll="true" id="quantity_formatter.dms.no_sign">
            <mutation text="final sign = '';"/>
            <mutation text="final sign = degrees &lt; 0 ? '-' : '';"/>
        </regex>

        <!-- RULE 20 (CA-1070 2/2): zero seconds are dropped, so 30°00'00"
             reads 30°00' -->
        <regex pattern="&quot;\$\{_twoDigits\(minutes\)\}'\$\{_twoDigits\(seconds\)\}\\&quot;&quot;;" dotAll="true" id="quantity_formatter.dms.seconds_dropped">
            <mutation text="&quot;${_twoDigits(minutes)}'${seconds == 0 ? '' : '${_twoDigits(seconds)}\&quot;'}&quot;;"/>
        </regex>

        <!-- RULE 21: segments are no longer padded, so 45°02' reads 45°2' -->
        <regex pattern="String _twoDigits\(int value\) =&gt; value\.toString\(\)\.padLeft\(2, '0'\);" dotAll="true" id="quantity_formatter.dms.no_padding">
            <mutation text="String _twoDigits(int value) =&gt; value.toString();"/>
        </regex>

        <!-- RULE 24: a length is rounded to a tick before a decimal
             rendering, a compound rendering or a stored size reads it -->
        <regex pattern="final amount = value\.amountIn\(value\.unit\);" dotAll="true" id="quantity_formatter.length.decimal_from_whole_ticks">
            <mutation text="final amount = value.ticks / value.unit.ticksPerUnit;"/>
        </regex>
        <regex pattern="Unit\.inch =&gt; _wholeInchesAndFraction\(value\.inches, group\),\s*Unit\.footInch =&gt; _feetAndInches\(value\.inches\)," dotAll="true" id="quantity_formatter.length.compound_from_whole_ticks">
            <mutation text="Unit.inch =&gt; _wholeInchesAndFraction(Rational(value.ticks, Length.ticksPerInch), group), Unit.footInch =&gt; _feetAndInches(value.inches),"/>
            <mutation text="Unit.inch =&gt; _wholeInchesAndFraction(value.inches, group), Unit.footInch =&gt; _feetAndInches(Rational(value.ticks, Length.ticksPerInch)),"/>
        </regex>
        <regex pattern="final inches = value\.inches\.toDouble\(\);" dotAll="true" id="quantity_formatter.stored_length.from_whole_ticks">
            <mutation text="final inches = value.ticks / Length.ticksPerInch;"/>
        </regex>

        <!-- RULE 25: a computed length's part of a tick is floored or ceiled
             instead of rounded, or kept to 1/256 of a tick instead of 1/512 -->
        <regex pattern="\(ticks \* partsPerTick\)\.round\(\)," dotAll="true" id="quantity.length.computed_rounding">
            <mutation text="(ticks * partsPerTick).floor(),"/>
            <mutation text="(ticks * partsPerTick).ceil(),"/>
        </regex>
        <regex pattern="static const int partsPerTick = 1 &lt;&lt; 9;" dotAll="true" id="quantity.length.parts_per_tick">
            <mutation text="static const int partsPerTick = 1 &lt;&lt; 8;"/>
        </regex>


        <!-- RULE 23: a pitch's rise is quoted per inch of run, or its grade
             per inch, or the rise is the sine and not the tangent -->
        <regex pattern="'\$\{_riseInInches\(_rise\(value\) \* Angle\.inchesPerFootOfRun, group\)\}in/12in'," dotAll="true" id="quantity_formatter.pitch.rise_per_inch">
            <mutation text="'${_riseInInches(_rise(value), group)}in/12in',"/>
        </regex>
        <regex pattern="'\$\{_jsRoundedNumber\(_rise\(value\) \* percent, pitchDecimals, group\)\}%'" dotAll="true" id="quantity_formatter.pitch.grade_per_foot">
            <mutation text="'${_jsRoundedNumber(_rise(value) * Angle.inchesPerFootOfRun, pitchDecimals, group)}%'"/>
        </regex>
        <regex pattern="double _rise\(Angle value\) =&gt; math\.tan\(value\.degrees \* math\.pi / 180\);" dotAll="true" id="quantity_formatter.pitch.sine_not_tangent">
            <mutation text="double _rise(Angle value) =&gt; math.sin(value.degrees * math.pi / 180);"/>
        </regex>

        <!-- RULE 22: the spelling is ignored and a D:M:S angle reads in
             degrees -->
        <regex pattern="AngleSpelling\.degreesMinutesSeconds =&gt; _degreesMinutesSeconds\(\s*value\.degrees,\s*group,?\s*\)," dotAll="true" id="quantity_formatter.angle.ignore_spelling">
            <mutation text="AngleSpelling.degreesMinutesSeconds =&gt; '${_jsRoundedNumber(value.degrees, resultDecimals, group)}°',"/>
        </regex>
        <!-- RULE: a length near the limit throws in a metric rendering
             instead of falling back to double math -->
        <regex pattern="\} on RationalOverflow \{\s*return inches\.toDouble\(\) / unit\.inchesPer\.toDouble\(\);" dotAll="true" id="quantity.amount_in.no_fallback">
            <mutation text="} on RationalOverflow { rethrow;"/>
        </regex>

        <!-- RULE CA-1236a: a real value under the rounding reads 0, a true
             zero reads in words, or the words and the step are wrong -->
        <regex pattern="if \(number != '0' \|\| amount == 0\) return '\$number\$suffix';" dotAll="true" id="quantity_formatter.under.never_or_zero">
            <mutation text="if (true) return '$number$suffix';"/>
            <mutation text="if (number != '0') return '$number$suffix';"/>
        </regex>
        <regex pattern="final step = decimals == 0 \? '1' : '0\.\$\{'0' \* \(decimals - 1\)\}1';" dotAll="true" id="quantity_formatter.under.step_off_by_one">
            <mutation text="final step = decimals == 0 ? '1' : '0.${'0' * decimals}1';"/>
            <mutation text="final step = '0.01';"/>
        </regex>
        <regex pattern="return _under\('\$step\$suffix', negative: amount &lt; 0\);" dotAll="true" id="quantity_formatter.under.sign">
            <mutation text="return _under('$step$suffix', negative: amount &gt; 0);"/>
        </regex>
        <regex pattern="negative \? belowZero : '\$under \$step';" dotAll="true" id="quantity_formatter.under.words_swapped">
            <mutation text="negative ? '$under $step' : belowZero;"/>
            <mutation text="'$under $step';"/>
        </regex>
        <regex pattern="if \(whole == 0 &amp;&amp; fraction\.text\.isEmpty &amp;&amp; magnitude\.numerator != 0\) \{" dotAll="true" id="quantity_formatter.under.inch_zero">
            <mutation text="if (whole == 0 &amp;&amp; fraction.text.isEmpty) {"/>
            <mutation text="if (false) {"/>
        </regex>
        <regex pattern="if \(feet == 0 &amp;&amp;\s*wholeInches == 0 &amp;&amp;\s*fraction\.text\.isEmpty &amp;&amp;\s*magnitude\.numerator != 0\) \{" dotAll="true" id="quantity_formatter.under.compound_zero">
            <mutation text="if (feet == 0 &amp;&amp; wholeInches == 0 &amp;&amp; fraction.text.isEmpty) {"/>
            <mutation text="if (wholeInches == 0 &amp;&amp; fraction.text.isEmpty &amp;&amp; magnitude.numerator != 0) {"/>
            <mutation text="if (false) {"/>
        </regex>
        <regex pattern="'1/\$\{preferences\.fractionResolution\.denominator\}\$\{Unit\.inch\.suffix\}'," dotAll="true" id="quantity_formatter.under.ignore_resolution">
            <mutation text="'1/16${Unit.inch.suffix}',"/>
        </regex>
        <regex pattern="_jsRoundedNumber\(inUnit, acreDecimals, group\),\s*inUnit,\s*acreDecimals," dotAll="true" id="quantity_formatter.under.acre_step">
            <mutation text="_jsRoundedNumber(inUnit, acreDecimals, group), inUnit, resultDecimals,"/>
        </regex>

        <!-- RULE CA-1236b: Too large at the wrong edge, read off the value
             instead of the number written, for one sign only, or with no
             guard for a value past 2⁶³ whose text is not the value -->
        <regex pattern="return _leadingNumber\(format\(value\)\) &gt; Quantity\.largestShown;" dotAll="true" id="quantity_formatter.too_large.edge">
            <mutation text="return _leadingNumber(format(value)) &gt;= Quantity.largestShown;"/>
            <mutation text="return _amountShown(value).abs() &gt; Quantity.largestShown;"/>
            <mutation text="return false;"/>
        </regex>
        <regex pattern="RegExp\(r'\^\[−-\]\?\(" dotAll="true" id="quantity_formatter.too_large.one_sign">
            <mutation text="RegExp(r'^("/>
        </regex>
        <regex pattern="if \(!\(_amountShown\(value\)\.abs\(\) &lt; _firstWholeNumberPastTheLimit\)\) \{" dotAll="true" id="quantity_formatter.too_large.no_guard">
            <mutation text="if (false) {"/>
            <mutation text="if (!(_amountShown(value) &lt; _firstWholeNumberPastTheLimit)) {"/>
        </regex>
        <regex pattern="Area\(\) =&gt; _areaInUnit\(value\),\s*Volume\(\) =&gt; _volumeInUnit\(value\),\s*Weight\(\) =&gt; _weightInUnit\(value\),\s*Angle\(\)" dotAll="true" id="quantity_formatter.too_large.area_unguarded">
            <mutation text="Area() =&gt; 0, Volume() =&gt; _volumeInUnit(value), Weight() =&gt; _weightInUnit(value), Angle()"/>
            <mutation text="Area() =&gt; _areaInUnit(value), Volume() =&gt; 0, Weight() =&gt; _weightInUnit(value), Angle()"/>
            <mutation text="Area() =&gt; _areaInUnit(value), Volume() =&gt; _volumeInUnit(value), Weight() =&gt; 0, Angle()"/>
        </regex>
        <regex pattern="Length\(unit: Unit\.footInch\) =&gt; value\.amountIn\(Unit\.foot\)," dotAll="true" id="quantity_formatter.too_large.compound_in_inches">
            <mutation text="Length(unit: Unit.footInch) =&gt; value.amountIn(Unit.inch),"/>
        </regex>
        <regex pattern="Length\(\) =&gt; value\.amountIn\(value\.unit\)," dotAll="true" id="quantity_formatter.too_large.length_in_feet">
            <mutation text="Length() =&gt; value.amountIn(Unit.foot),"/>
        </regex>
        <regex pattern="static const double largestShown = 19999999\.99;" dotAll="true" id="quantity_formatter.too_large.limit">
            <mutation text="static const double largestShown = 99999999.99;"/>
        </regex>
    </rules>

    <commands>
        <command group="quantity_formatter" expected-return="0">flutter test test/libraries/calculator_engine/units/quantity_formatter_test.dart test/libraries/calculator_engine/units/models/quantity_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
