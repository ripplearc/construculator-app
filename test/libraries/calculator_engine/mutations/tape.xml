<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR ENGINE TAPE MUTATION TESTING -->
    <!-- Targets: Tape, which routes every entry key to the active chip and
         unwinds the tape on backspace, and ValueChip, which decides what a
         chip is worth. Critical path: a wrong route makes a digit land in a
         finished value or a unit key skip the ladder, and a wrong unwind
         deletes a value instead of reopening it after an error. -->

    <files>
        <file>lib/libraries/calculator_engine/tape.dart</file>
        <file>lib/libraries/calculator_engine/models/chip.dart</file>
    </files>

    <rules>
        <!-- RULE 1: a function key opens a second chip instead of renaming
             the empty one -->
        <regex pattern="if \(chip != null &amp;&amp; chip\.entry\.isEmpty\) \{\s*return _replaceLast\(\s*chip\.copyWith\(\s*key: \(\) =&gt; key," dotAll="true" id="tape.function_key.no_rename">
            <mutation text="if (false) { return _replaceLast(chip.copyWith(key: () =&gt; key,"/>
        </regex>

        <!-- RULE 1b: a renamed empty chip keeps the old key's unit rule or
             its old reading of a plain number -->
        <regex pattern="key: \(\) =&gt; key,\s*keyWantsUnit: keyWantsUnit,\s*readsDegrees: readsDegrees," dotAll="true" id="tape.function_key.rename_drops_flags">
            <mutation text="key: () =&gt; key, readsDegrees: readsDegrees,"/>
            <mutation text="key: () =&gt; key, keyWantsUnit: keyWantsUnit,"/>
        </regex>

        <!-- RULE 2: an unfinished value can be left by a function key -->
        <regex pattern="final tape = _withFractionClosedAsInches\(\);\s*if \(tape\._unfinished case final refusal\?\) return refusal;\s*if \(key == PlainNumberKeys\.pitch\) \{" dotAll="true" id="tape.function_key.leave_unfinished">
            <mutation text="final tape = _withFractionClosedAsInches(); if (key == PlainNumberKeys.pitch) {"/>
            <mutation text="final tape = this; if (tape._unfinished case final refusal?) return refusal; if (key == PlainNumberKeys.pitch) {"/>
        </regex>

        <!-- RULE 2b: a new chip under a function key loses the key's unit
             rule or its reading of a plain number -->
        <regex pattern="ValueChip\(\s*key: key,\s*keyWantsUnit: keyWantsUnit,\s*readsDegrees: readsDegrees,\s*\)" dotAll="true" id="tape.function_key.new_chip_drops_flags">
            <mutation text="ValueChip(key: key, readsDegrees: readsDegrees)"/>
            <mutation text="ValueChip(key: key, keyWantsUnit: keyWantsUnit)"/>
        </regex>

        <!-- RULE 3: a unit after a result is answered like an empty tape -->
        <regex pattern="_hasResult\s*\? TapeRefusal\.unitsApplyWhileTyping\s*: TapeRefusal\.typeANumberFirst," dotAll="true" id="tape.press_unit.same_refusal">
            <mutation text="TapeRefusal.typeANumberFirst,"/>
        </regex>

        <!-- RULE 4: a unit key on a finished value is routed to the entry
             buffer instead of the ladder -->
        <regex pattern="if \(chip\.entry\.isOpen\) \{" dotAll="true" id="tape.press_unit.always_close">
            <mutation text="if (true) {"/>
        </regex>

        <!-- RULE 4b: Slope takes a length unit, refuses every unit, or
             refuses a length without the caller naming Slope -->
        <regex pattern="if \(takesAGrade &amp;&amp; unit\.dimension == Dimension\.length\) \{" dotAll="true" id="tape.press_unit.slope_takes_a_length">
            <mutation text="if (false) {"/>
            <mutation text="if (takesAGrade) {"/>
            <mutation text="if (unit.dimension == Dimension.length) {"/>
        </regex>

        <!-- RULE 5: an edited converted value still reads as its stale exact
             quantity -->
        <regex pattern="if \(exact case \(:final value, :final spelled\) when spelled == entry\) \{" dotAll="true" id="chip.exact_value.ignore_edit">
            <mutation text="if (exact case (:final value, spelled: _)) {"/>
        </regex>

        <!-- RULE 6: a split finishes the value but never starts the new one
             beside it -->
        <regex pattern="_replaceActive\(chip\.copyWith\(entry: finished\)\)\.append\(\s*ValueChip\(\s*entry: started,\s*poundsPerTon: _tonTypedUnder\(const ValueChip\(\), started\),\s*\),\s*\)," dotAll="true" id="tape.entry.split_drops_started">
            <mutation text="_replaceActive(chip.copyWith(entry: finished)),"/>
        </regex>

        <!-- RULE 7: backspace drops the last chip without reopening the value
             before it -->
        <regex pattern="previous\.copyWith\(isActive: true\),\s*\]\),\s*final BracketChip closed =&gt; _with\(\[\.\.\.before, _reopened\(closed\)\]\)," dotAll="true" id="tape.backspace.no_reopen">
            <mutation text="previous, ]), final BracketChip closed =&gt; _with([...before, _reopened(closed)]),"/>
        </regex>

        <!-- RULE 8: backspace unwinds the tape even while the active chip has
             tokens -->
        <regex pattern="if \(chip != null &amp;&amp; !chip\.entry\.isEmpty\) \{" dotAll="true" id="tape.backspace.skip_entry">
            <mutation text="if (false) {"/>
        </regex>

        <!-- RULE 9: a fraction without a unit counts as a bare number -->
        <regex pattern="entry\.tokens\.first\.denominator == null &amp;&amp;" dotAll="true" id="chip.bare_number.fraction">
            <mutation text="true &amp;&amp;"/>
        </regex>

        <!-- RULE 10: a converted chip is re-read from its rounded digits -->
        <regex pattern="if \(exactValue case final value\?\) return value;" dotAll="true" id="chip.value.ignore_exact">
            <mutation text="if (false) return exactValue;"/>
        </regex>

        <!-- RULE 11: an unfinished value under a function key is refused for
             the wrong reason -->
        <regex pattern="if \(chip == null \|\| chip\.isReadable\) return null;\s*if \(chip\.entry\.endsWithUnitlessFraction\) \{\s*return const TapeEntryRefused\(EntryRefusal\.fractionNeedsUnit\);\s*\}\s*return const TapeRefused\(TapeRefusal\.finishThisValueFirst\);" dotAll="true" id="tape.function_key.wrong_refusal">
            <mutation text="if (chip == null) return null; if (chip.entry.endsWithUnitlessFraction) { return const TapeEntryRefused(EntryRefusal.fractionNeedsUnit); } return const TapeRefused(TapeRefusal.finishThisValueFirst);"/>
            <mutation text="if (chip == null || chip.isReadable) return null; return const TapeRefused(TapeRefusal.finishThisValueFirst);"/>
            <mutation text="if (chip == null || chip.isReadable) return null; if (chip.entry.endsWithUnitlessFraction) { return const TapeEntryRefused(EntryRefusal.fractionNeedsUnit); } return const TapeRefused(TapeRefusal.typeANumberFirst);"/>
        </regex>

        <!-- RULE: closing a bracket leaves a fraction after whole inches
             open, so ( 7 in 1 [/] 2 ) is refused -->
        <regex pattern="var inner = _with\(bracket\.inner\)\._withFractionClosedAsInches\(\);" dotAll="true" id="tape.close_bracket.fraction_left_open">
            <mutation text="var inner = _with(bracket.inner);"/>
        </regex>

        <!-- RULE 26: a fraction after whole inches is never closed by itself,
             or any fraction is -->
        <regex pattern="if \(chip == null \|\| !chip\.entry\.endsWithFractionAfterWholeInches\) \{\s*return this;\s*\}" dotAll="true" id="tape.fraction.never_closed_as_inches">
            <mutation text="if (true) { return this; }"/>
            <mutation text="if (chip == null || !chip.entry.endsWithUnitlessFraction) { return this; }"/>
        </regex>

        <!-- RULE: = leaves the fraction it closed as inches open when there
             is nothing to compute -->
        <regex pattern="ChainValue\(\) \|\| ChainEmpty\(\) when !identical\(tape, this\) =&gt; TapeChanged\(" dotAll="true" id="tape.equals.fraction_left_open">
            <mutation text="ChainValue() || ChainEmpty() when false =&gt; TapeChanged("/>
        </regex>

        <!-- RULE 12: an error chip counts as a result -->
        <regex pattern="bool get endsWithResult =&gt; chips\.isNotEmpty &amp;&amp; chips\.last is ResultChip;" dotAll="true" id="tape.ends_with_result.error_counts">
            <mutation text="bool get endsWithResult =&gt; chips.isNotEmpty &amp;&amp; chips.last is ErrorChip;"/>
        </regex>

        <!-- RULE 13: backspace with nothing typed keeps the last chip -->
        <regex pattern="final remaining = chips\.sublist\(0, chips\.length - 1\);" dotAll="true" id="tape.backspace.keep_last_chip">
            <mutation text="final remaining = chips.sublist(0, chips.length);"/>
        </regex>

        <!-- RULE 14: a result chip counts as an error -->
        <regex pattern="bool get endsWithError =&gt; chips\.isNotEmpty &amp;&amp; chips\.last is ErrorChip;" dotAll="true" id="tape.ends_with_error.result_counts">
            <mutation text="bool get endsWithError =&gt; chips.isNotEmpty &amp;&amp; chips.last is ResultChip;"/>
        </regex>

        <!-- RULE 15: append leaves the active chip active behind the new
             one -->
        <regex pattern="final sealed = _sealed\(\);\s*return sealed\._with\(\[\.\.\.sealed\.chips, chip\]\);" dotAll="true" id="tape.append.no_seal">
            <mutation text="return _with([...chips, chip]);"/>
        </regex>

        <!-- RULE 16: a result with a unit is refused like a bare Calc -->
        <regex pattern="if \(chip == null &amp;&amp; last is ResultChip &amp;&amp; last\.value is! Scalar\) \{" dotAll="true" id="tape.press_unit.never_convert_result">
            <mutation text="if (false) {"/>
        </regex>

        <!-- RULE 17: a bare number under a function key can be left -->
        <regex pattern="bool get _isPlainNumber =&gt; \(key == null \|\| !keyWantsUnit\) &amp;&amp; _isBareNumber;" dotAll="true" id="chip.bare_number.named_is_readable">
            <mutation text="bool get _isPlainNumber =&gt; _isBareNumber;"/>
            <mutation text="bool get _isPlainNumber =&gt; key == null &amp;&amp; _isBareNumber;"/>
        </regex>

        <!-- RULE 17b: a plain number under Pitch is a scalar, or every
             plain number is an angle -->
        <regex pattern="if \(entry\.isDegreesMinutesSeconds \|\| readsDegrees\) return _typedAngle;\s*return Scalar\(entry\.tokens\.first\.value\);" dotAll="true" id="chip.plain_number.degrees_under_pitch">
            <mutation text="return Scalar(entry.tokens.first.value);"/>
            <mutation text="return _typedAngle;"/>
        </regex>

        <!-- RULE 18: an emptied chip keeps the exact quantity it was
             converted from -->
        <regex pattern="chip\.copyWith\(\s*entry: buffer,\s*exact: buffer\.isEmpty \? \(\) =&gt; null : null,\s*poundsPerTon: \(\) =&gt; _tonTypedUnder\(chip, buffer\),\s*\)," dotAll="true" id="tape.entry.empty_keeps_exact">
            <mutation text="chip.copyWith(entry: buffer, poundsPerTon: () =&gt; _tonTypedUnder(chip, buffer)),"/>
        </regex>

        <!-- RULE 19: new settings drop the chips, or keep the old settings -->
        <regex pattern="Tape withPreferences\(CalculatorPreferences preferences\) =&gt;\s*Tape\(chips: chips, preferences: preferences\);" dotAll="true" id="tape.with_preferences.drops_chips">
            <mutation text="Tape withPreferences(CalculatorPreferences preferences) =&gt; Tape(preferences: preferences);"/>
            <mutation text="Tape withPreferences(CalculatorPreferences preferences) =&gt; Tape(chips: chips, preferences: this.preferences);"/>
        </regex>

        <!-- RULE 22: a typed ton never remembers its definition, so a new
             one re-reads it; or every edit re-stamps it, so ⌫ on a digit
             open after the ton re-reads it -->
        <regex pattern="return tons &gt; _tonTokens\(chip\.entry\) \? poundsPerTon : chip\.poundsPerTon;" dotAll="true" id="tape.entry.ton_definition_forgotten">
            <mutation text="return chip.poundsPerTon;"/>
            <mutation text="return poundsPerTon;"/>
        </regex>

        <!-- RULE 23: a chip is read by the tape's ton, not the one it was
             typed under -->
        <regex pattern="if \(entry\.isComplete\) return _typedUnder\(parser\)\.parse\(entry\.tokens\);" dotAll="true" id="chip.value.ignores_typed_ton">
            <mutation text="if (entry.isComplete) return parser.parse(entry.tokens);"/>
        </regex>

        <!-- RULE 24: every token counts as a ton, so a digit typed after
             the ton re-stamps it -->
        <!-- RULE: a ton a split starts is read at whatever the setting is
             later -->
        <regex pattern="entry: started,\s*poundsPerTon: _tonTypedUnder\(const ValueChip\(\), started\)," dotAll="true" id="tape.entry.split_ton_unstamped">
            <mutation text="entry: started, poundsPerTon: null,"/>
        </regex>

        <regex pattern="entry\.tokens\.where\(\(token\) =&gt; token\.unit == Unit\.ton\)\.length;" dotAll="true" id="tape.entry.every_token_is_a_ton">
            <mutation text="entry.tokens.length;"/>
        </regex>

        <!-- RULE 25: two chips typed under different ton definitions
             compare equal -->
        <regex pattern="exact,\s*poundsPerTon,\s*isActive,\s*\];" dotAll="true" id="chip.props.ignores_typed_ton">
            <mutation text="exact, isActive, ];"/>
        </regex>

        <!-- RULE 20: a key press forgets the settings -->
        <regex pattern="Tape _with\(List&lt;TapeChip&gt; chips\) =&gt;\s*Tape\(chips: chips, preferences: preferences\);" dotAll="true" id="tape.with.forgets_settings">
            <mutation text="Tape _with(List&lt;TapeChip&gt; chips) =&gt; Tape(chips: chips);"/>
        </regex>

        <!-- RULE 25: the evaluator ignores the System of units setting -->
        <regex pattern="arithmetic: ChainArithmetic\(system: preferences\.system\)," dotAll="true" id="tape.evaluator.ignores_system">
            <mutation text="arithmetic: const ChainArithmetic(),"/>
        </regex>

        <!-- RULE 21: the formatter ignores the settings -->
        <regex pattern="QuantityFormatter get formatter =&gt;\s*QuantityFormatter\(preferences: preferences\);" dotAll="true" id="tape.formatter.ignores_settings">
            <mutation text="QuantityFormatter get formatter =&gt; const QuantityFormatter();"/>
        </regex>
    </rules>

    <commands>
        <command group="tape" expected-return="0">flutter test test/libraries/calculator_engine/units/tape_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
