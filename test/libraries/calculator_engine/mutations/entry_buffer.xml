<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR ENGINE ENTRY BUFFER MUTATION TESTING -->
    <!-- Targets: EntryBuffer, the entry grammar of the active chip. Critical
         path: every value on the tape is typed through it, and a weakened
         guard here lets a number be read as something it is not — a
         compound of two systems, a fraction under a decimal, inches glued
         to a cubic value — while the tape still shows a plausible chip. -->

    <files>
        <file>lib/libraries/calculator_engine/entry_buffer.dart</file>
    </files>

    <rules>
        <!-- RULE 1: a leading point is not read as 0. -->
        <regex pattern="Token\(digits: digit == '\.' \? '0\.' : digit\)" dotAll="true" id="entry_buffer.type_digit.no_leading_zero">
            <mutation text="Token(digits: digit)"/>
        </regex>

        <!-- RULE 2: a second decimal point is accepted -->
        <regex pattern="if \(digit == '\.' &amp;&amp; last\.digits\.contains\('\.'\)\) \{" dotAll="true" id="entry_buffer.type_digit.second_point">
            <mutation text="if (false) {"/>
        </regex>

        <!-- RULE 3: a digit after a finished token is appended to it instead
             of starting a new one -->
        <regex pattern="if \(last == null \|\| last\.unit != null\) \{\s*return _changed\(\[\.\.\.tokens, Token" dotAll="true" id="entry_buffer.type_digit.append_to_finished">
            <mutation text="if (last == null) { return _changed([...tokens, Token"/>
        </regex>

        <!-- RULE 4: [/] is accepted on a decimal -->
        <regex pattern="if \(last\.digits\.contains\('\.'\) \|\| last\.isDegreesMinutesSeconds\) \{\s*return const EntryRefused\(EntryRefusal\.decimalCannotTakeFraction\);" dotAll="true" id="entry_buffer.type_fraction.on_decimal">
            <mutation text="if (false) { return const EntryRefused(EntryRefusal.decimalCannotTakeFraction);"/>
        </regex>

        <!-- RULE 5: a unit closes a fraction that has no denominator yet -->
        <regex pattern="if \(last\.denominator == ''\) \{" dotAll="true" id="entry_buffer.close_with.open_fraction">
            <mutation text="if (false) {"/>
        </regex>

        <!-- RULE 6: a compound may step up as well as down -->
        <regex pattern="previousUnit\.compoundRank &gt; unit\.compoundRank &amp;&amp;" dotAll="true" id="entry_buffer.compound.step_up">
            <mutation text="previousUnit.compoundRank != unit.compoundRank &amp;&amp;"/>
        </regex>

        <!-- RULE 7: a compound may cross systems -->
        <regex pattern="return previousUnit\.isMetric == unit\.isMetric &amp;&amp;" dotAll="true" id="entry_buffer.compound.cross_system">
            <mutation text="return true &amp;&amp;"/>
        </regex>

        <!-- RULE 8: a cubic value continues as a compound -->
        <regex pattern="if \(previousUnit == null \|\| previous\.power &gt; 1\) return false;" dotAll="true" id="entry_buffer.compound.after_power">
            <mutation text="if (previousUnit == null) return false;"/>
        </regex>

        <!-- RULE 9: while editing, a broken compound splits instead of
             refusing in place -->
        <regex pattern="if \(editing\) return const EntryRefused\(EntryRefusal\.cannotAppendUnit\);" dotAll="true" id="entry_buffer.close_with.ignore_editing">
            <mutation text="if (false) return const EntryRefused(EntryRefusal.cannotAppendUnit);"/>
        </regex>

        <!-- RULE 10: a key that takes lengths accepts a weight -->
        <!-- RULE: a fraction after any inch token, or after a decimal inch,
             closes as inches by itself -->
        <regex pattern="token\.unit == Unit\.inch &amp;&amp;\s*token\.power == 1 &amp;&amp;\s*token\.denominator == null &amp;&amp;\s*!token\.digits\.contains\('\.'\);" dotAll="true" id="entry_buffer.fraction.after_whole_inches">
            <mutation text="token.unit != null &amp;&amp; token.power == 1 &amp;&amp; token.denominator == null &amp;&amp; !token.digits.contains('.');"/>
            <mutation text="token.unit == Unit.inch &amp;&amp; token.power == 1 &amp;&amp; !token.digits.contains('.');"/>
            <mutation text="token.unit == Unit.inch &amp;&amp; token.power == 1 &amp;&amp; token.denominator == null;"/>
        </regex>

        <!-- RULE: a fraction closed as inches after whole inches is never
             written as a mixed number, or a fraction after feet is -->
        <regex pattern="_isWholeInches\(whole\) &amp;&amp;\s*fraction\.unit == Unit\.inch &amp;&amp;\s*fraction\.power == 1 &amp;&amp;\s*\(fraction\.denominator\?\.isNotEmpty \?\? false\);" dotAll="true" id="entry_buffer.text.no_mixed_number">
            <mutation text="false;"/>
            <mutation text="fraction.unit == Unit.inch &amp;&amp; fraction.power == 1 &amp;&amp; (fraction.denominator?.isNotEmpty ?? false);"/>
        </regex>

        <!-- RULE: [Inch] on a fraction after whole inches still splits -->
        <regex pattern="!\(unit == Unit\.inch &amp;&amp; endsWithFractionAfterWholeInches\)\) \{" dotAll="true" id="entry_buffer.close_with.fraction_after_inches_splits">
            <mutation text="true) {"/>
            <mutation text="!endsWithFractionAfterWholeInches) {"/>
        </regex>

        <!-- RULE: a zero whole part is written as 0-1/2in, or the fraction
             after a dropped zero is joined with a dash -->
        <regex pattern="if \(isWholeOfMixed &amp;&amp; token\.digits == '0'\) continue;" dotAll="true" id="entry_buffer.text.zero_whole_part">
            <mutation text=""/>
        </regex>
        <regex pattern="_isMixedNumber\(previous, token\) &amp;&amp; previous\.digits != '0' \? '-' : ' ',"  dotAll="true" id="entry_buffer.text.dash_after_dropped_zero">
            <mutation text="_isMixedNumber(previous, token) ? '-' : ' ',"/>
        </regex>

        <!-- RULE: a zero under the line is accepted, or every 0 under the
             line is refused so 7/10 cannot be typed -->
        <regex pattern="if \(denominator\.isEmpty &amp;&amp; digit == '0'\) \{" dotAll="true" id="entry_buffer.fraction.zero_denominator">
            <mutation text="if (false) {"/>
            <mutation text="if (digit == '0') {"/>
        </regex>

        <!-- RULE: a second [/] on a finished fraction asks for the top number
             again, or both cases say the same -->
        <regex pattern="denominator\.isEmpty\s*\? EntryRefusal\.fractionAlreadyOpen\s*: EntryRefusal\.fractionNeedsUnit," dotAll="true" id="entry_buffer.fraction.second_slash_message">
            <mutation text="denominator.isEmpty ? EntryRefusal.fractionAlreadyOpen : EntryRefusal.fractionNeedsNumerator,"/>
            <mutation text="EntryRefusal.fractionAlreadyOpen,"/>
        </regex>

        <!-- RULE: the carry starts one part too late, or a fraction's
             numerator is carried as whole parts -->
        <regex pattern="if \(parts == null \|\| wholeAbove == null \|\| parts &lt; partsPerUnit\) \{\s*return null;\s*\}" dotAll="true" id="entry_buffer.carry.threshold">
            <mutation text="if (parts == null || wholeAbove == null || parts &lt;= partsPerUnit) { return null; }"/>
            <mutation text="if (true) { return null; }"/>
        </regex>
        <regex pattern="final parts = part\.denominator == null \? int\.tryParse\(whole\) : null;" dotAll="true" id="entry_buffer.carry.fraction_numerator">
            <mutation text="final parts = int.tryParse(whole);"/>
        </regex>
        <regex pattern="final wholeAbove = previous\.denominator == null\s*\?\s*int\.tryParse\(previous\.digits\)\s*:\s*null;" dotAll="true" id="entry_buffer.carry.into_a_fraction">
            <mutation text="final wholeAbove = int.tryParse(previous.digits);"/>
        </regex>

        <!-- RULE: a decimal part is never carried, or loses its decimals -->
        <regex pattern="if \(point &lt; 0\) return \(digits, ''\);" dotAll="true" id="entry_buffer.carry.decimal_never">
            <mutation text="if (true) return (digits, '');"/>
        </regex>

        <!-- RULE: the carry adds one whatever the size, or keeps the whole
             part below -->
        <regex pattern="previous\.copyWith\(digits: '\$\{wholeAbove \+ parts ~/ partsPerUnit\}'\)," dotAll="true" id="entry_buffer.carry.quotient">
            <mutation text="previous.copyWith(digits: '${wholeAbove + 1}'),"/>
        </regex>
        <regex pattern="part\.copyWith\(digits: '\$\{parts % partsPerUnit\}\$decimals'\)," dotAll="true" id="entry_buffer.carry.remainder">
            <mutation text="part.copyWith(digits: '${parts - partsPerUnit}$decimals'),"/>
            <mutation text="part.copyWith(digits: '${parts % partsPerUnit}'),"/>
        </regex>

        <!-- RULE: the carry stops after one step, so a part above can be as
             large as its own unit -->
        <regex pattern="return _carryInto\(carried, index - 1, higher, above\) \?\? carried;" dotAll="true" id="entry_buffer.carry.once">
            <mutation text="return carried;"/>
        </regex>

        <!-- RULE: a key that takes lengths takes a weight, or answers the
             first number's toast on a typed tail -->
        <regex pattern="if \(holdsLengthOnly &amp;&amp; unit\.dimension != Dimension\.length\) \{" dotAll="true" id="entry_buffer.close_with.ignore_length_only">
            <mutation text="if (false) {"/>
            <mutation text="if (editing &amp;&amp; holdsLengthOnly &amp;&amp; unit.dimension != Dimension.length) {"/>
        </regex>
        <regex pattern="previous == null\s*\? EntryRefusal\.needsLength\s*: EntryRefusal\.tailNeedsLength," dotAll="true" id="entry_buffer.close_with.one_needs_length_toast">
            <mutation text="EntryRefusal.needsLength,"/>
        </regex>

        <!-- RULE 11: backspace drops the whole raised unit instead of one
             power -->
        <regex pattern="return _replaceLast\(last\.copyWith\(power: last\.power - 1\)\);" dotAll="true" id="entry_buffer.backspace.drop_power">
            <mutation text="return _replaceLast(last.copyWith(power: 1));"/>
        </regex>

        <!-- RULE 12: backspace on the last digit leaves an empty token -->
        <regex pattern="if \(last\.digits\.length &lt;= 1\) \{" dotAll="true" id="entry_buffer.backspace.keep_empty_token">
            <mutation text="if (false) {"/>
        </regex>

        <!-- RULE 13: a compound may step sideways, 18ft then feet again -->
        <regex pattern="previousUnit\.compoundRank &gt; unit\.compoundRank &amp;&amp;" dotAll="true" id="entry_buffer.compound.step_sideways">
            <mutation text="previousUnit.compoundRank &gt;= unit.compoundRank &amp;&amp;"/>
        </regex>

        <!-- RULE 14: backspace on the last digit keeps an empty token -->
        <regex pattern="if \(last\.digits\.length &lt;= 1\) \{" dotAll="true" id="entry_buffer.backspace.keep_last_digit">
            <mutation text="if (last.digits.length &lt; 1) {"/>
        </regex>

        <!-- RULE 15: backspace raises the power instead of lowering it -->
        <regex pattern="return _replaceLast\(last\.copyWith\(power: last\.power - 1\)\);" dotAll="true" id="entry_buffer.backspace.raise_power">
            <mutation text="return _replaceLast(last.copyWith(power: last.power + 1));"/>
        </regex>

        <!-- RULE 16: a second decimal point is refused for the wrong reason -->
        <regex pattern="return const EntryRefused\(EntryRefusal\.secondDecimalPoint\);" dotAll="true" id="entry_buffer.digit.wrong_point_reason">
            <mutation text="return const EntryRefused(EntryRefusal.decimalInDenominator);"/>
        </regex>
    </rules>

    <commands>
        <command group="entry_buffer" expected-return="0">flutter test test/libraries/calculator_engine/units/entry_buffer_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
