<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- COST ESTIMATION REPOSITORY IMPLEMENTATION MUTATION TESTING -->
    <!-- Targets: Repository implementation for cost estimations -->

    <files>
        <file>lib/libraries/estimation/data/repositories/cost_estimation_repository_impl.dart</file>
    </files>

    <exclude>
        <!-- Exclude logging statements -->
        <regex pattern="_logger\.(debug|info|warning|error)\s*\(" dotAll="false"/>

        <!-- Exclude try-catch structure -->
        <regex pattern="try\s*{" dotAll="false"/>
        <regex pattern="catch\s*\(" dotAll="false"/>

        <!-- Exclude override annotations -->
        <regex pattern="@override" dotAll="false"/>
    </exclude>

    <rules>
        <!-- getEstimation: the phone's row wins over the server's -->
        <regex pattern="final dto = phoneDto \?\? await _dataSource\.getEstimationById\(estimationId\);" dotAll="true" id="repo.get.ignore_phone_row">
            <mutation text="final dto = await _dataSource.getEstimationById(estimationId);"/>
        </regex>
        <regex pattern="final dto = phoneDto \?\? await _dataSource\.getEstimationById\(estimationId\);" dotAll="true" id="repo.get.ignore_server_row">
            <mutation text="final dto = phoneDto;"/>
        </regex>


        <!-- RULE 7: In hasMoreEstimations, return wrong default value -->
        <regex pattern="return _paginationStates\[streamKey\]\?\.hasMore \?\? true;" dotAll="true" id="repo.pagination.wrong_default_hasmore">
            <mutation text="return _paginationStates[streamKey]?.hasMore ?? false;"/>
        </regex>

        <!-- RULE 8: In _emitToStream, skip emitting to stream -->
        <regex pattern="_streamControllers\[streamKey\]\?\.add\(result\);" dotAll="true" id="repo.stream.skip_emit">
            <mutation text="// _streamControllers[streamKey]?.add(result);"/>
        </regex>














        <!-- RULE 29: In _buildStreamKey, collapse key (breaks sort/limit isolation) -->
        <regex pattern="return '\$projectId:\$\{sortBy\.name\}:\$\{ascending \? 'asc' : 'desc'\}:\$\{limit \?\? 'all'\}';" dotAll="true" id="repo.streamkey.collapse_to_projectid">
            <mutation text="return projectId;"/>
        </regex>

        <!-- RULE 30: In _emitToStream, skip syncing cache from successful emission -->
        <regex pattern="\(estimations\) =&gt; _cachedEstimations\[streamKey\] = estimations" dotAll="true" id="repo.stream.skip_cache_sync">
            <mutation text="(estimations) { }"/>
        </regex>

        <!-- Paging raises the limit of the local watch -->
        <regex pattern="final visibleLimit = limit \?\? defaultPageSize;" dotAll="true" id="repo.paging.ignore_explicit_limit">
            <mutation text="final visibleLimit = defaultPageSize;"/>
        </regex>
        <regex pattern="\(_visibleLimits\[streamKey\] \?\? defaultPageSize\) \+\s*paginationState\.pageSize;" dotAll="true" id="repo.paging.lower_limit_on_load_more">
            <mutation text="(_visibleLimits[streamKey] ?? defaultPageSize) - paginationState.pageSize;"/>
            <mutation text="(_visibleLimits[streamKey] ?? defaultPageSize);"/>
        </regex>
        <regex pattern="final hasMore = localEstimates\.length &gt;= visibleLimit;" dotAll="true" id="repo.paging.hasmore_boundary">
            <mutation text="final hasMore = localEstimates.length &gt; visibleLimit;"/>
            <mutation text="final hasMore = localEstimates.length &lt; visibleLimit;"/>
        </regex>
        <regex pattern="return Future\.value\(Right\(_cachedEstimations\[streamKey\] \?\? \[\]\)\);" dotAll="true" id="repo.paging.wrong_early_return_when_nomore">
            <mutation text="return Future.value(Right([]));"/>
        </regex>
        <regex pattern="if \(!paginationState\.hasMore\) \{" dotAll="true" id="repo.paging.load_more_when_nomore">
            <mutation text="if (paginationState.hasMore) {"/>
        </regex>
        <regex pattern="_localSubscriptions\.remove\(streamKey\)\?\.cancel\(\);\s*_localSubscriptions\[streamKey\]" dotAll="true" id="repo.local.keep_old_subscription">
            <mutation text="_localSubscriptions[streamKey]"/>
        </regex>
        <regex pattern="if \(!firstResult\.isCompleted\) firstResult\.complete\(result\);" dotAll="true" id="repo.local.never_complete_first_result">
            <mutation text="// firstResult.complete(result);"/>
        </regex>

        <regex pattern="\.where\(\(edit\) =&gt; edit\.projectId == projectId\)" dotAll="true" id="repo.edits.apply_other_projects">
            <mutation text=".where((edit) =&gt; true)"/>
        </regex>
        <regex pattern="estimates\.every\(\(e\) =&gt; e\.id != estimationId\)" dotAll="true" id="repo.edits.delete_reflected_any">
            <mutation text="estimates.any((e) =&gt; e.id != estimationId)"/>
        </regex>
        <regex pattern="estimates\.where\(\(e\) =&gt; e\.id != estimationId\)\.toList\(\)" dotAll="true" id="repo.edits.delete_keeps_estimate">
            <mutation text="estimates"/>
        </regex>
        <regex pattern="e\.id == estimationId \? replace\(e\) : e" dotAll="true" id="repo.edits.replace_all">
            <mutation text="replace(e)"/>
        </regex>

        <regex pattern="if \(!_streamControllers\.containsKey\(streamKey\)\) \{\s*_localSubscriptions" dotAll="true" id="repo.local.keep_unwatched_subscription">
            <mutation text="if (_streamControllers.containsKey(streamKey)) { _localSubscriptions"/>
        </regex>
        <regex pattern="waiting\.complete\(Right\(_cachedEstimations\[streamKey\] \?\? \[\]\)\);" dotAll="true" id="repo.local.leave_caller_waiting">
            <mutation text="// waiting.complete(Right(_cachedEstimations[streamKey] ?? []));"/>
        </regex>
        <regex pattern="patch: \(e\) =&gt; e\.copyWith\(lockStatus: updatedEstimation\.lockStatus\)," dotAll="true" id="repo.edits.lock_patch_replaces_all">
            <mutation text="patch: (e) =&gt; updatedEstimation,"/>
        </regex>
        <regex pattern="_emitToStream\(\s*key,\s*Right\(_applyPendingEdits\(key, projectId, copy\.estimates, copy\.view\)\),\s*\);" dotAll="true" id="repo.republish.skip_emit">
            <mutation text="// republish skipped"/>
        </regex>
        <regex pattern="if \(copy == null\) continue;" dotAll="true" id="repo.republish.skip_lists_without_copy">
            <mutation text="if (copy != null) continue;"/>
        </regex>
        <regex pattern="_republishProject\(estimation\.projectId\);" dotAll="true" id="repo.create.skip_republish">
            <mutation text="// _republishProject(estimation.projectId);"/>
        </regex>
        <regex pattern="if \(_isReflectedOn\(edit, estimates, view\)\) \{" dotAll="true" id="repo.edits.apply_before_reflected_check">
            <mutation text="if (!_isReflectedOn(edit, estimates, view)) {"/>
        </regex>
        <regex pattern="if \(edit\.awaitingKeys\.remove\(streamKey\)\) edit\.wasReflected = true;" dotAll="true" id="repo.edits.never_mark_reflected">
            <mutation text="edit.awaitingKeys.remove(streamKey);"/>
        </regex>
        <regex pattern="shown = edit\.apply\(shown, view\);" dotAll="true" id="repo.edits.skip_apply">
            <mutation text="shown = shown;"/>
        </regex>
        <regex pattern="_phoneCopies\[streamKey\] = \(estimates: estimates, view: view\);" dotAll="true" id="repo.edits.skip_phone_copy">
            <mutation text="// phone copy not kept"/>
        </regex>
        <regex pattern="edit\.wasReflected &amp;&amp; edit\.awaitingKeys\.isEmpty" dotAll="true" id="repo.edits.drop_without_reflection">
            <mutation text="edit.awaitingKeys.isEmpty"/>
        </regex>
        <regex pattern="for \(final edit in _pendingEditsOf\(projectId\)\) \{\s*edit\.awaitingKeys\.add\(streamKey\);\s*\}" dotAll="true" id="repo.edits.skip_join_new_list">
            <mutation text=""/>
        </regex>
        <regex pattern="for \(final edit in _pendingEdits\.values\) \{\s*edit\.awaitingKeys\.remove\(streamKey\);\s*\}" dotAll="true" id="repo.edits.keep_closed_list_awaited">
            <mutation text=""/>
        </regex>
        <regex pattern="_pendingEdits\[editKey\] = edit;" dotAll="true" id="repo.edits.skip_remember">
            <mutation text="// edit not remembered"/>
        </regex>
        <regex pattern="_forgetPendingEdit\(lockEdit\);" dotAll="true" id="repo.edits.keep_failed_lock">
            <mutation text="// _forgetPendingEdit(lockEdit);"/>
        </regex>
        <regex pattern="_forgetPendingEdit\(deleteEdit\);" dotAll="true" id="repo.edits.keep_failed_delete">
            <mutation text="// _forgetPendingEdit(deleteEdit);"/>
        </regex>
        <regex pattern="showsWrite\(e\) \|\|" dotAll="true" id="repo.edits.reflected_ignores_write">
            <mutation text=""/>
        </regex>
        <regex pattern="e\.id != estimationId \|\|" dotAll="true" id="repo.edits.reflected_for_other_rows">
            <mutation text="e.id == estimationId ||"/>
        </regex>
        <regex pattern="e\.updatedAt\.isAfter\(writtenAt\)" dotAll="true" id="repo.edits.newer_phone_row_older">
            <mutation text="e.updatedAt.isBefore(writtenAt)"/>
        </regex>
        <regex pattern="bool showsWrite\(CostEstimate e\) =&gt; e\.lockStatus\.isLocked == isLocked;" dotAll="true" id="repo.edits.lock_reflected_negated">
            <mutation text="bool showsWrite(CostEstimate e) =&gt; e.lockStatus.isLocked != isLocked;"/>
        </regex>
        <regex pattern="position == -1 \? estimates\.length : position" dotAll="true" id="repo.create.ignore_sort_position">
            <mutation text="0"/>
        </regex>
        <regex pattern="return merged\.take\(view\.limit\)\.toList\(\);" dotAll="true" id="repo.create.ignore_limit">
            <mutation text="return merged;"/>
        </regex>
        <regex pattern="view\.sortBy == EstimationSortOption\.updatedAt" dotAll="true" id="repo.create.sort_column_swapped">
            <mutation text="view.sortBy != EstimationSortOption.updatedAt"/>
        </regex>
        <regex pattern="view\.ascending \? aTime\.isBefore\(bTime\)" dotAll="true" id="repo.create.ascending_reversed">
            <mutation text="view.ascending ? aTime.isAfter(bTime)"/>
        </regex>
        <regex pattern=": !aTime\.isBefore\(bTime\)" dotAll="true" id="repo.create.tie_goes_after">
            <mutation text=": aTime.isAfter(bTime)"/>
        </regex>
        <regex pattern="!_withCreated\(\s*estimates,\s*createdEstimation,\s*view,\s*\)\.any\(\(e\) =&gt; e\.id == createdEstimation\.id\)" dotAll="true" id="repo.create.hidden_when_not_fit_never_reflected">
            <mutation text="false"/>
        </regex>
        <regex pattern="_localSubscriptions\.remove\(streamKey\)\?\.cancel\(\);\s*_forgetStream\(streamKey\);" dotAll="true" id="repo.local.keep_copy_of_unwatched_list">
            <mutation text="_localSubscriptions.remove(streamKey)?.cancel();"/>
        </regex>
        <regex pattern="edit\.wasReflected = true;\n    \}\n    _pendingEdits\[editKey\]" dotAll="true" id="repo.edits.skip_settle_when_reflected_everywhere">
            <mutation text="edit.wasReflected = false;
    }
    _pendingEdits[editKey]"/>
        </regex>
        <regex pattern="return !rowIsStillBeingCreated &amp;&amp; edit\.isReflected\(estimates, view\);" dotAll="true" id="repo.edits.ignore_row_still_being_created">
            <mutation text="return edit.isReflected(estimates, view);"/>
        </regex>
        <regex pattern="_pendingEdits\.containsKey\('create:\$estimationId'\) &amp;&amp;" dotAll="true" id="repo.edits.created_check_ignores_pending_create">
            <mutation text="false &amp;&amp;"/>
        </regex>
        <regex pattern="'\$kind:\$estimationId:\$\{_editCount\+\+\}'" dotAll="true" id="repo.edits.share_key_per_row">
            <mutation text="'$kind:$estimationId'"/>
        </regex>
        <regex pattern="_phoneCopies\.remove\(streamKey\);\n\s*publish\(\n\s*Left\(\n\s*_handleError\(\n\s*e,\n\s*.reading estimations from the phone." dotAll="true" id="repo.local.unreadable_row_keeps_old_copy">
            <mutation text="publish(Left(_handleError(e,
 'reading estimations from the phone'"/>
        </regex>
        <!-- renameEstimation: the phone not having the row is a not-found failure -->
        <regex pattern="if \(renamedDto == null\) \{" dotAll="true" id="repo.rename.skip_not_found">
            <mutation text="if (renamedDto != null) {"/>
        </regex>

        <!-- renameEstimation: a successful rename answers with the stored row -->
        <regex pattern="return Right\(renamedDto\.toDomain\(\)\);" dotAll="true" id="repo.rename.success_as_failure">
            <mutation text="return Left(UnexpectedFailure());"/>
        </regex>

        <!-- renameEstimation: the name written is the name asked for -->
        <regex pattern="newName: newName,\n      \);\n      if \(renamedDto" dotAll="true" id="repo.rename.writes_wrong_name">
            <mutation text="newName: estimationId,\n      );\n      if (renamedDto"/>
        </regex>
    </rules>

    <commands>
        <command group="cost_estimation_repository" expected-return="0">flutter test --fail-fast test/libraries/estimation/units/data/repositories/cost_estimation_repository_impl_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
