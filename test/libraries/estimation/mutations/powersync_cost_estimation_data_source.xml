<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- POWERSYNC COST ESTIMATION DATA SOURCE MUTATION TESTING -->
    <!-- Targets: reactive read data source (watch + snapshot) over local SQLite -->

    <files>
        <file>lib/libraries/estimation/data/data_source/powersync_cost_estimation_data_source_impl.dart</file>
    </files>

    <exclude>
        <!-- Exclude logging statements -->
        <regex pattern="_logger\.(debug|info|warning|error)\s*\(" dotAll="false"/>

        <!-- Exclude try-catch structure -->
        <regex pattern="try\s*{" dotAll="false"/>
        <regex pattern="catch\s*\(" dotAll="false"/>

        <!-- Exclude override annotations -->
        <regex pattern="@override" dotAll="false"/>
    </exclude>

    <rules>
        <!-- RULE 1: In _buildSelectSql, pick the wrong ORDER BY column for sortBy -->
        <regex pattern="sortBy == EstimationSortOption\.updatedAt\s*\?\s*'updated_at'\s*:\s*'created_at'" dotAll="true" id="ds.sort.wrong_order_column">
            <mutation text="sortBy == EstimationSortOption.updatedAt ? 'created_at' : 'updated_at'"/>
        </regex>

        <!-- RULE 2: In _buildSelectSql, invert the sort direction -->
        <regex pattern="ascending \? 'ASC' : 'DESC'" dotAll="true" id="ds.sort.invert_direction">
            <mutation text="ascending ? 'DESC' : 'ASC'"/>
        </regex>

        <!-- RULE 3: In _buildSelectSql, invert the LIMIT clause inclusion -->
        <regex pattern="limited \? ' LIMIT \?' : ''" dotAll="true" id="ds.sort.invert_limit_clause">
            <mutation text="limited ? '' : ' LIMIT ?'"/>
        </regex>

        <!-- RULE 4: In _selectParameters, drop the limit-binding guard -->
        <regex pattern="\?limit,\n  \];" dotAll="true" id="ds.params.drop_limit_guard">
            <mutation text="limit,\n  ];"/>
        </regex>

        <!-- RULE 5: In watchEstimations, drop the row->DTO mapping -->
        <regex pattern="mapRows: \(rows\) =&gt; rows\.map\(CostEstimateDto\.fromRow\)\.toList\(\)," dotAll="true" id="ds.watch.skip_row_mapping">
            <mutation text="mapRows: (rows) =&gt; &lt;CostEstimateDto&gt;[],"/>
        </regex>

        <!-- RULE 6: In getEstimations, drop the row->DTO mapping -->
        <regex pattern="return rows\.map\(CostEstimateDto\.fromRow\)\.toList\(\);" dotAll="true" id="ds.snapshot.skip_row_mapping">
            <mutation text="return &lt;CostEstimateDto&gt;[];"/>
        </regex>

        <!-- RULE 7: In _watchWithSyncStream onCancel, fail to release the sync
             stream (guards both watchEstimations and watchEstimationById) -->
        <regex pattern="currentHandle\?\.unsubscribe\(\);" dotAll="true" id="ds.watch.skip_stream_release">
            <mutation text="// currentHandle?.unsubscribe();"/>
        </regex>

        <!-- RULE 8: In _watchWithSyncStream, swallow the sync-stream activation
             error (guards both watchEstimations and watchEstimationById) -->
        <regex pattern="controller\.addError\(error, stackTrace\);" dotAll="true" id="ds.watch.swallow_activation_error">
            <mutation text="// controller.addError(error, stackTrace);"/>
        </regex>

        <!-- RULE 9: In watchEstimationById, invert the empty-result guard so a
             present row maps to null (and an absent one dereferences .first) -->
        <regex pattern="rows\.isEmpty \? null" dotAll="true" id="ds.watchById.invert_empty_guard">
            <mutation text="rows.isNotEmpty ? null"/>
        </regex>

        <!-- RULE 10: In watchEstimationById, drop the row->DTO mapping -->
        <regex pattern=": CostEstimateDto\.fromRow\(rows\.first\)," dotAll="true" id="ds.watchById.skip_row_mapping">
            <mutation text=": null,"/>
        </regex>

        <!-- RULE 11: In _watchWithSyncStream, always skip dedupe even when
             dedupeWith is supplied -->
        <regex pattern="\(dedupeWith != null \? mapped\.distinct\(dedupeWith\) : mapped\)" dotAll="true" id="ds.watch.skip_dedupe">
            <mutation text="mapped"/>
        </regex>
        <!-- WRITES: insert mints an id only when the row has none -->
        <regex pattern="estimation\.id\.isEmpty \? uuid\.v4\(\) : estimation\.id" dotAll="true" id="ds.insert.always_mint_id">
            <mutation text="uuid.v4()"/>
        </regex>
        <regex pattern="estimation\.id\.isEmpty \? uuid\.v4\(\) : estimation\.id" dotAll="true" id="ds.insert.never_mint_id">
            <mutation text="estimation.id"/>
        </regex>

        <!-- WRITES: is_locked is stored as 1 / 0 -->
        <regex pattern="estimation\.isLocked \? 1 : 0" dotAll="true" id="ds.insert.invert_locked_encoding">
            <mutation text="estimation.isLocked ? 0 : 1"/>
        </regex>
        <regex pattern="DatabaseConstants\.isLockedColumn, isLocked \? 1 : 0\)" dotAll="true" id="ds.lock.invert_locked_encoding">
            <mutation text="DatabaseConstants.isLockedColumn, isLocked ? 0 : 1)"/>
        </regex>


        <regex pattern="'DELETE FROM \$_table WHERE" dotAll="true" id="ds.delete.keeps_row">
            <mutation text="'SELECT id FROM $_table WHERE"/>
        </regex>

        <!-- WRITES: insert drops its transaction -->
        <regex pattern="await _wrapper\.writeTransaction\(\s*\(tx\) =&gt; tx\.execute\(\s*'INSERT INTO \$_table \(\$columns\) VALUES \(\$placeholders\)',\s*row\.values\.toList\(\),\s*\),\s*\);" dotAll="true" id="ds.insert.skip_write">
            <mutation text=""/>
        </regex>
        <!-- WRITES: an update of a row the phone lacks writes nothing and returns null -->
        <regex pattern="if \(rows\.isEmpty\) return null;" dotAll="true" id="ds.update.write_even_when_row_missing">
            <mutation text=""/>
        </regex>
        <regex pattern="if \(rows\.isEmpty\) return null;" dotAll="true" id="ds.update.never_write">
            <mutation text="return null;"/>
        </regex>

        <!-- WRITES: a value the row already has is not written again -->
        <regex pattern="if \(rows\.first\[column\] == value\) return CostEstimateDto\.fromRow\(rows\.first\);" dotAll="true" id="ds.update.write_unchanged_value">
            <mutation text=""/>
        </regex>
        <regex pattern="rows\.first\[column\] == value" dotAll="true" id="ds.update.skip_changed_value">
            <mutation text="rows.first[column] != value"/>
        </regex>

        <!-- WRITES: the answer is the row as it now is on the phone -->
        <regex pattern="return updatedRows\.isEmpty\s*\?\s*null\s*:\s*CostEstimateDto\.fromRow\(updatedRows\.first\);" dotAll="true" id="ds.update.return_nothing_after_write">
            <mutation text="return null;"/>
        </regex>

        <regex pattern="return updatedRows\.isEmpty\s*\?\s*null\s*:\s*CostEstimateDto\.fromRow\(updatedRows\.first\);" dotAll="true" id="ds.update.invert_empty_after_write">
            <mutation text="return updatedRows.isNotEmpty ? null : CostEstimateDto.fromRow(updatedRows.first);"/>
        </regex>

        <!-- WRITES: parameters and column of an update -->
        <regex pattern="\[value, id\]," dotAll="true" id="ds.update.swap_parameters">
            <mutation text="[id, value],"/>
        </regex>
        <regex pattern="_updateColumnById\(id, DatabaseConstants\.estimateNameColumn, newName\)" dotAll="true" id="ds.rename.wrong_column">
            <mutation text="_updateColumnById(id, DatabaseConstants.updatedAtColumn, newName)"/>
        </regex>
        <regex pattern="_updateColumnById\(id, DatabaseConstants\.isLockedColumn, isLocked \? 1 : 0\)" dotAll="true" id="ds.lock.wrong_column">
            <mutation text="_updateColumnById(id, DatabaseConstants.estimateNameColumn, isLocked ? 1 : 0)"/>
        </regex>

        <!-- loadEstimationById: a missing row is null, a found row is returned -->
        <regex pattern="return rows\.isEmpty \? null : CostEstimateDto\.fromRow\(rows\.first\);" dotAll="true" id="ds.load.return_nothing">
            <mutation text="return null;"/>
        </regex>
        <regex pattern="return rows\.isEmpty \? null : CostEstimateDto\.fromRow\(rows\.first\);" dotAll="true" id="ds.load.invert_empty_check">
            <mutation text="return rows.isNotEmpty ? null : CostEstimateDto.fromRow(rows.first);"/>
        </regex>
    </rules>

    <commands>
        <command group="powersync_cost_estimation_data_source" expected-return="0">flutter test test/libraries/estimation/units/data/data_source/powersync_cost_estimation_data_source_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
