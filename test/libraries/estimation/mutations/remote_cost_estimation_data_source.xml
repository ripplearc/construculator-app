<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- REMOTE COST ESTIMATION DATA SOURCE MUTATION TESTING -->
    <!-- Targets: Remote data source implementation for cost estimations -->

    <files>
        <file>lib/libraries/estimation/data/data_source/remote_cost_estimation_data_source.dart</file>
    </files>

    <exclude>
        <!-- Exclude logging statements -->
        <regex pattern="_logger\.(debug|info|warning|error)\s*\(" dotAll="false"/>

        <!-- Exclude try-catch structure -->
        <regex pattern="try\s*{" dotAll="false"/>
        <regex pattern="catch\s*\(" dotAll="false"/>

        <!-- Exclude override annotations -->
        <regex pattern="@override" dotAll="false"/>
    </exclude>

    <rules>
        <!-- RULE 8: In `changeLockStatus`, use wrong lock status value -->
        <regex pattern="(DatabaseConstants\.isLockedColumn:\s*isLocked)" id="estimation.lock.invert_status">
            <mutation text="DatabaseConstants.isLockedColumn: !isLocked"/>
        </regex>

        <!-- RULE 9: In `changeLockStatus`, use wrong filter column -->
        <regex pattern="(filterColumn:\s*DatabaseConstants\.idColumn,\s*filterValue:\s*estimationId,)" id="estimation.lock.wrong_filter_column">
            <mutation text="filterColumn: DatabaseConstants.projectIdColumn, filterValue: estimationId,"/>
        </regex>

        <!-- RULE 10: In `changeLockStatus`, use empty filter value -->
        <regex pattern="(filterValue:\s*estimationId,)" id="estimation.lock.empty_filter">
            <mutation text="filterValue: '',"/>
        </regex>

        <!-- RULE 11: In `renameEstimation`, use wrong column name -->
        <regex pattern="(DatabaseConstants\.estimateNameColumn:\s*newName)" id="estimation.rename.wrong_column">
            <mutation text="DatabaseConstants.projectIdColumn: newName"/>
        </regex>

        <!-- RULE 12: In `renameEstimation`, use empty name value -->
        <regex pattern="(\{DatabaseConstants\.estimateNameColumn:\s*newName\})" id="estimation.rename.empty_value">
            <mutation text="{DatabaseConstants.estimateNameColumn: ''}"/>
        </regex>

        <!-- RULE 13: In `renameEstimation`, use wrong filter column -->
        <regex pattern="(filterColumn:\s*DatabaseConstants\.idColumn,\s*filterValue:\s*estimationId,)" id="estimation.rename.wrong_filter_column">
            <mutation text="filterColumn: DatabaseConstants.projectIdColumn, filterValue: estimationId,"/>
        </regex>
    </rules>

    <commands>
        <command group="estimation_data_source" expected-return="0">flutter test test/libraries/estimation/units/data/data_source/remote_cost_estimation_data_source_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
