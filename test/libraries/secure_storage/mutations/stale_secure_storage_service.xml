<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- STALE SECURE STORAGE SERVICE MUTATION TESTING -->
    <!-- Targets: when secure storage is emptied after a fresh install -->

    <files>
        <file>lib/libraries/secure_storage/stale_secure_storage_service.dart</file>
    </files>

    <exclude>
        <!-- Exclude imports -->
        <regex pattern="^import\s" dotAll="false"/>
    </exclude>

    <rules>
        <!-- RULE 1: Empty secure storage on every launch -->
        <regex pattern="if \(preferences\.getBool\(_hasLaunchedBeforeKey\) \?\? false\) return;" dotAll="true" id="stale.skip_first_run_guard">
            <mutation text=""/>
        </regex>

        <!-- RULE 2: Treat an unset flag as already launched -->
        <regex pattern="\?\? false\) return;" dotAll="true" id="stale.unset_flag_means_launched">
            <mutation text="?? true) return;"/>
        </regex>

        <!-- RULE 3: Stop after the first launch only when the flag is false -->
        <regex pattern="if \(preferences\.getBool\(_hasLaunchedBeforeKey\) \?\? false\) return;" dotAll="true" id="stale.invert_first_run_guard">
            <mutation text="if (!(preferences.getBool(_hasLaunchedBeforeKey) ?? false)) return;"/>
        </regex>

        <!-- RULE 4: Empty secure storage on an update too -->
        <regex pattern="if \(!preferences\.containsKey\(earlierVersionKey\)\) \{" dotAll="true" id="stale.wipe_on_update">
            <mutation text="if (true) {"/>
        </regex>

        <!-- RULE 5: Never empty secure storage -->
        <regex pattern="if \(!preferences\.containsKey\(earlierVersionKey\)\) \{" dotAll="true" id="stale.never_wipe">
            <mutation text="if (false) {"/>
        </regex>

        <!-- RULE 6: Empty secure storage only on an update -->
        <regex pattern="if \(!preferences\.containsKey\(earlierVersionKey\)\) \{" dotAll="true" id="stale.invert_update_check">
            <mutation text="if (preferences.containsKey(earlierVersionKey)) {"/>
        </regex>

        <!-- RULE 7: Skip the actual wipe -->
        <regex pattern="await _secureStorage\.deleteAll\(\);" dotAll="true" id="stale.skip_delete_all">
            <mutation text=""/>
        </regex>

        <!-- RULE 8: Let a failed wipe stop the app from starting -->
        <regex pattern="\} on PlatformException \{\s*return;\s*\}" dotAll="true" id="stale.rethrow_failed_wipe">
            <mutation text="} on PlatformException {rethrow;}"/>
        </regex>

        <!-- RULE 9: Record the launch even when the wipe failed -->
        <regex pattern="\} on PlatformException \{\s*return;\s*\}" dotAll="true" id="stale.record_after_failed_wipe">
            <mutation text="} on PlatformException {}"/>
        </regex>

        <!-- RULE 10: Never record the launch -->
        <regex pattern="await preferences\.setBool\(_hasLaunchedBeforeKey, true\);" dotAll="true" id="stale.skip_record_launch">
            <mutation text=""/>
        </regex>

        <!-- RULE 11: Record the launch as not yet launched -->
        <regex pattern="setBool\(_hasLaunchedBeforeKey, true\)" dotAll="true" id="stale.record_false">
            <mutation text="setBool(_hasLaunchedBeforeKey, false)"/>
        </regex>
    </rules>

    <commands>
        <command group="stale_secure_storage_service" expected-return="0">flutter test test/libraries/secure_storage/units/stale_secure_storage_service_test.dart test/libraries/supabase/units/supabase_wrapper_impl_session_test.dart</command>
    </commands>

    <threshold failure="85"/>
</mutations>
