<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR STATE MUTATION TESTING -->
    <!-- Targets: what the equals key is named by. Critical path: a key that
         names an answer = would refuse is a dead key with a name on it. -->

    <files>
        <file>lib/features/calculator/presentation/bloc/calculator_bloc/calculator_state.dart</file>
    </files>

    <rules>
        <!-- RULE 1: = is said to land the leading answer after a result, or
             with an operator still waiting for its number -->
        <regex pattern="tape\.endsWithResult \|\| tape\.endsWithOperator\s*\? null\s*: suggestions\.firstOrNull;" dotAll="true" id="calculator_state.equals_lands.after_result_or_operator">
            <mutation text="suggestions.firstOrNull;"/>
            <mutation text="tape.endsWithResult ? null : suggestions.firstOrNull;"/>
            <mutation text="tape.endsWithOperator ? null : suggestions.firstOrNull;"/>
        </regex>

        <!-- RULE 2: the equals key is named by the leading suggestion whether
             or not = lands it -->
        <regex pattern="return switch \(equalsLands\) \{" dotAll="true" id="calculator_state.equals_key.names_what_is_not_landed">
            <mutation text="return switch (suggestions.firstOrNull) {"/>
        </regex>

        <!-- RULE (S1b 4/6, R3): the reopened divisor after ÷ 0 = keeps the
             Division… label instead of the error's title -->
        <regex pattern="ValueChip\(\) when _readsTheReopenedDivisor =&gt; CalculatorDisplayLabel\(" dotAll="true" id="calculator_state.display_label.reopened_divisor_untitled">
            <mutation text="ValueChip() when false =&gt; CalculatorDisplayLabel("/>
        </regex>

        <!-- RULE: the value row no longer reads Error on the reopened divisor -->
        <regex pattern="ValueChip\(\) =&gt; _readsTheReopenedDivisor,\s*_ =&gt; false,\s*\};" dotAll="true" id="calculator_state.value_reads_error.divisor_has_a_value">
            <mutation text="_ =&gt; false, };"/>
        </regex>

        <!-- RULE (S1c 3/5, R2): the equals key ignores an open edit, or reads
             Update over a tape with no result and = over one with -->
        <regex pattern="if \(tape\.editing != null\) return _hasAResult \? updateKey : null;" dotAll="true" id="calculator_state.equals_key.edit_ignored">
            <mutation text=""/>
            <mutation text="if (tape.editing != null) return _hasAResult ? null : updateKey;"/>
        </regex>
        <!-- RULE: the tiles give way to Calc as row 1 does -->
        <regex pattern="List&lt;CalculatorSuggestion&gt; get dimensions =&gt; \[" dotAll="true" id="calculator_state.dimensions.hidden_by_calc">
            <mutation text="List&lt;CalculatorSuggestion&gt; get dimensions =&gt; [ if (tape.runningTotal case ChainValue(isCalculation: true)) ...const &lt;CalculatorSuggestion&gt;[] else"/>
        </regex>

        <!-- CA-1094 (Section 1.8; decision tree rows 339, 375): the Sides
             note is silent, = on a warning raises no Alert, or the Alert
             names another warning -->
        <regex pattern="sidesStillTyped: tape\.beingTyped\?\.key == PlainNumberKeys\.sides," dotAll="true" id="calculator_state.note.sides_while_typed">
            <mutation text="sidesStillTyped: false,"/>
            <mutation text="sidesStillTyped: true,"/>
        </regex>
        <regex pattern="case RuleRefusal\.sidesNotWhole:\s*return const CalculatorSidesNotWholeNote\(\);" dotAll="true" id="calculator_state.note.sides_silent">
            <mutation text="case RuleRefusal.sidesNotWhole: return null;"/>
        </regex>
        <regex pattern="\(TapeRefused\(reason: TapeRefusal\.nothingToCompute\), _, _\) =&gt;\s*_rangeWarningOnEquals," dotAll="true" id="calculator_state.toast.equals_on_a_warning_silent">
            <mutation text="(TapeRefused(reason: TapeRefusal.nothingToCompute), _, _) =&gt; null,"/>
        </regex>
        <regex pattern="CalculatorPitchOutOfRangeNote\(isAtLeastARightAngle: true\) =&gt;\s*const CalculatorRangeWarningToast\(\s*CalculatorRangeWarning\.pitchUnderRightAngle," dotAll="true" id="calculator_state.toast.right_angle_named_wrong">
            <mutation text="CalculatorPitchOutOfRangeNote(isAtLeastARightAngle: true) =&gt; const CalculatorRangeWarningToast(CalculatorRangeWarning.pitchAtLeastZero,"/>
        </regex>
        <regex pattern="CalculatorPitchOutOfRangeNote\(\) =&gt; const CalculatorRangeWarningToast\(\s*CalculatorRangeWarning\.pitchAtLeastZero," dotAll="true" id="calculator_state.toast.below_zero_named_wrong">
            <mutation text="CalculatorPitchOutOfRangeNote() =&gt; const CalculatorRangeWarningToast(CalculatorRangeWarning.pitchUnderRightAngle,"/>
        </regex>
        <regex pattern="CalculatorFlatPitchHasNoRunNote\(\) =&gt; const CalculatorRangeWarningToast\(\s*CalculatorRangeWarning\.flatPitchHasNoRun," dotAll="true" id="calculator_state.toast.flat_pitch_named_wrong">
            <mutation text="CalculatorFlatPitchHasNoRunNote() =&gt; const CalculatorRangeWarningToast(CalculatorRangeWarning.slopeAboveZero,"/>
        </regex>
        <regex pattern="CalculatorSlopeOutOfRangeNote\(\) =&gt; const CalculatorRangeWarningToast\(\s*CalculatorRangeWarning\.slopeAboveZero," dotAll="true" id="calculator_state.toast.slope_named_wrong">
            <mutation text="CalculatorSlopeOutOfRangeNote() =&gt; const CalculatorRangeWarningToast(CalculatorRangeWarning.flatPitchHasNoRun,"/>
        </regex>
        <!-- CA-1376 (Section 1.8, "A percent tip"; Section 7, "Percent"):
             the tip is silent, outlives the next key, shows after × or ÷,
             names the wrong sign, side or amount, or the chip loses its % -->
        <regex pattern="return _percentTip;\s*\}" dotAll="true" id="calculator_state.tip.silent">
            <mutation text="return null; }"/>
        </regex>
        <regex pattern="return tape\.openBracket != null \? _percentTip : null;" dotAll="true" id="calculator_state.tip.silent_in_a_bracket">
            <mutation text="return null;"/>
        </regex>
        <regex pattern="if \(refusal != null\) return null;\s*final openIndex = tape\.openBracketIndex;" dotAll="true" id="calculator_state.tip.outlives_a_refusal">
            <mutation text="final openIndex = tape.openBracketIndex;"/>
        </regex>
        <regex pattern="if \(operator != Operator\.add &amp;&amp; operator != Operator\.subtract\) return null;" dotAll="true" id="calculator_state.tip.after_times_or_divide">
            <mutation text="if (operator != Operator.add) return null;"/>
            <mutation text="if (operator != Operator.subtract) return null;"/>
            <mutation text="if (false) return null;"/>
        </regex>
        <regex pattern="final adds = operator == Operator\.add;" dotAll="true" id="calculator_state.tip.sign">
            <mutation text="final adds = true;"/>
        </regex>
        <regex pattern="\? evaluator\.arithmetic\.combine\(withPercent, Operator\.subtract, total\)" dotAll="true" id="calculator_state.tip.amount_negated">
            <mutation text="? evaluator.arithmetic.combine(total, Operator.subtract, withPercent)"/>
        </regex>
        <regex pattern="ofTheBracket: openIndex != null," dotAll="true" id="calculator_state.tip.of_the_total_in_a_bracket">
            <mutation text="ofTheBracket: false,"/>
        </regex>
        <regex pattern="when ticks\.abs\(\) &lt; Length\.ticksPerFoot =&gt;" dotAll="true" id="calculator_state.tip.inches_boundary">
            <mutation text="when ticks.abs() &lt;= Length.ticksPerFoot =&gt;"/>
            <mutation text="when true =&gt;"/>
        </regex>
        <regex pattern="\(Length\(:final ticks\), Length\(:final unit\)\) =&gt; Length\(ticks, unit: unit\)," dotAll="true" id="calculator_state.tip.amount_in_its_own_unit">
            <mutation text="(Length(:final ticks), Length(:final unit)) =&gt; amount,"/>
        </regex>
        <regex pattern="\$\{_percentSign\(chip\.isPercent\)\}'," dotAll="true" id="calculator_state.chip.no_percent_sign">
            <mutation text="',"/>
        </regex>
        <regex pattern="'\(\$\{inner\.map\(_valueTextOf\)\.join\(\)\}\)%'," dotAll="true" id="calculator_state.chip.bracket_no_percent_sign">
            <mutation text="'(${inner.map(_valueTextOf).join()})',"/>
        </regex>
        <regex pattern="BracketChip\(isPercent: true\) =&gt; CoreCalculatorChipType\.editable," dotAll="true" id="calculator_state.chip.percent_bracket_type">
            <mutation text="BracketChip(isPercent: true) =&gt; CoreCalculatorChipType.bracketClosed,"/>
        </regex>

        <!-- CA-1376 (rule 4.12): a percent refusal raises another Alert, or
             names the wrong operator, place or bracket -->
        <regex pattern="operator: _lead\(tape\.beingTyped\?\.operator\)," dotAll="true" id="calculator_state.toast.percent_operator">
            <mutation text="operator: '',"/>
        </regex>
        <regex pattern="insideABracket: tape\.openBracket != null," dotAll="true" id="calculator_state.toast.percent_in_a_bracket">
            <mutation text="insideABracket: false,"/>
        </regex>
        <regex pattern="\(TapeRefused\(reason: TapeRefusal\.alreadyAPercent\), _, _\) =&gt;\s*const CalculatorAlreadyAPercentToast\(\)," dotAll="true" id="calculator_state.toast.already_a_percent">
            <mutation text="(TapeRefused(reason: TapeRefusal.alreadyAPercent), _, _) =&gt; const CalculatorPercentTakesNoUnitToast(),"/>
        </regex>
        <regex pattern="\(TapeRefused\(reason: TapeRefusal\.percentTakesNoUnit\), _, _\) =&gt;\s*const CalculatorPercentTakesNoUnitToast\(\)," dotAll="true" id="calculator_state.toast.takes_no_unit">
            <mutation text="(TapeRefused(reason: TapeRefusal.percentTakesNoUnit), _, _) =&gt; const CalculatorPercentHasNoUnitToast(),"/>
        </regex>
        <regex pattern="\(TapeRefused\(reason: TapeRefusal\.percentHasNoUnit\), _, _\) =&gt;\s*const CalculatorPercentHasNoUnitToast\(\)," dotAll="true" id="calculator_state.toast.has_no_unit">
            <mutation text="(TapeRefused(reason: TapeRefusal.percentHasNoUnit), _, _) =&gt; const CalculatorPercentTakesNoUnitToast(),"/>
        </regex>
        <regex pattern="BracketChip\(:final inner\) =&gt; '\(\$\{inner\.map\(_valueTextOf\)\.join\(\)\}\)'," dotAll="true" id="calculator_state.toast.bracket_named">
            <mutation text="BracketChip(:final inner) =&gt; '',"/>
        </regex>
        <!-- S2b (CA-1091): the detail panel shows under a pulled-down display,
             or shows while the keypad is up -->
        <regex pattern="bool get showsDetailPanel =&gt;\s*isKeypadFolded &amp;&amp; historyStage == DisplayAreaStage\.collapsed;" dotAll="true" id="calculator_state.detail_panel.when_shown">
            <mutation text="bool get showsDetailPanel =&gt; historyStage == DisplayAreaStage.collapsed;"/>
            <mutation text="bool get showsDetailPanel =&gt; isKeypadFolded;"/>
        </regex>
        <!-- S2b 2/2 (CA-1091): the card forgets its result, or says carried
             forward for every bank -->
        <regex pattern="ResultChip\(:final key, :final value\) =&gt; \(\s*key: key,\s*text: banked\.formatter\.format\(value\),\s*\)," dotAll="true" id="calculator_state.card.result_forgotten">
            <mutation text="ResultChip(:final key, :final value) =&gt; null,"/>
        </regex>
        <regex pattern="carriedForward: bankedCarriedForward," dotAll="true" id="calculator_state.card.always_carried">
            <mutation text="carriedForward: true,"/>
        </regex>
        <!-- T2a 2/3 (CA-1095): the sheet table of the detail panel -->
        <regex pattern="if \(area == null\) return null;\s*final seenSizes" dotAll="true" id="calculator_state.size_table.without_an_area">
            <mutation text="if (area == null) return const CalculatorSizeTable(areaText: '', rows: []); final seenSizes"/>
        </regex>
        <!-- R1 (B1): a row is named by its size and its place again, so the
             row after a deleted twin takes the name of the row just swiped -->
        <regex pattern="id: count\.size\.id \?\? '\$sizeText#\$before'," dotAll="true" id="calculator_state.size_table.row_named_by_place">
            <mutation text="id: '$sizeText#$before',"/>
        </regex>
        <regex pattern="final before = seenSizes\[sizeText\] \?\? 0;" dotAll="true" id="calculator_state.size_table.twins_share_an_id">
            <mutation text="const before = 0;"/>
        </regex>
        <regex pattern="seenSizes\[sizeText\] = before \+ 1;" dotAll="true" id="calculator_state.size_table.twins_not_counted">
            <mutation text=""/>
        </regex>
        <regex pattern="countText: tape\.formatter\.format\(count\.value\)," dotAll="true" id="calculator_state.size_table.raw_count">
            <mutation text="countText: '${count.count}',"/>
        </regex>
        <regex pattern="dimensions\.isNotEmpty \|\| sizeTable != null;" dotAll="true" id="calculator_state.has_details.one_part_only">
            <mutation text="dimensions.isNotEmpty;"/>
            <mutation text="sizeTable != null;"/>
            <mutation text="dimensions.isNotEmpty &amp;&amp; sizeTable != null;"/>
        </regex>
        <!-- T2a 3/3 (CA-1095): the size editor reads under the system in force -->
        <regex pattern="const SizeEntryParser\(\)\.read\(text, tape\.preferences\.system\)" dotAll="true" id="calculator_state.size_entry.always_imperial">
            <mutation text="const SizeEntryParser().read(text, MeasurementSystem.imperial)"/>
        </regex>

        <!-- G1 (CA-1072): row 1 is the ladder's. Which area is counted,
             which counts and rule answers are offered and when the strip is
             silent are the engine's rules now, in
             test/libraries/calculator_engine/mutations/arbiter.xml; these
             are the state's own readings of the ladder's answer. -->
        <!-- RULE: the suggestions stay under a note -->
        <regex pattern="List&lt;CalculatorSuggestion&gt; get suggestions =&gt; stripNote != null\s*\? const \[\]\s*:" dotAll="true" id="calculator_state.suggestions.shown_under_a_note">
            <mutation text="List&lt;CalculatorSuggestion&gt; get suggestions =&gt; false ? const [] :"/>
        </regex>
        <!-- RULE: a count is drawn as a rule answer, or loses its size -->
        <regex pattern="StripOfferKind\.materialCount =&gt; CalculatorSuggestionKind\.materialCount," dotAll="true" id="calculator_state.suggestion.count_drawn_as_answer">
            <mutation text="StripOfferKind.materialCount =&gt; CalculatorSuggestionKind.answer,"/>
        </regex>
        <regex pattern="final count\? =&gt; tape\.formatter\.formatPieceSize\(count\.size\)," dotAll="true" id="calculator_state.suggestion.count_without_its_size">
            <mutation text="final _? =&gt; null,"/>
        </regex>
        <!-- RULE: the ladder's silence is not the state's: the conversions
             and a note show over an error or an open bracket -->
        <regex pattern="bool get _stripIsSilent =&gt; _arbitration\.silence != null;" dotAll="true" id="calculator_state.strip_silent.ladder_not_asked">
            <mutation text="bool get _stripIsSilent =&gt; false;"/>
        </regex>
        <!-- RULE: the table lists no row, or the tiles are not the rule
             answers -->
        <regex pattern="rows: \[for \(final count in materialCounts\) _sizeRow\(count, seenSizes\)\]," dotAll="true" id="calculator_state.size_table.rows_dropped">
            <mutation text="rows: const [],"/>
        </regex>

        <!-- RULES (G1, CA-1072; rule 4.7): the Sheet size pill is read off
             the last chip while another one is on the display; every trade
             names the count, or none does; a trade's pill is the other's -->
        <regex pattern="if \(_chipRead case ResultChip\(:final key, size: final size\?\)\)" dotAll="true" id="calculator_state.size_pill.read_off_the_last_chip">
            <mutation text="if (tape.chips.lastOrNull case ResultChip(:final key, size: final size?))"/>
        </regex>
        <regex pattern="if \(trade\.resultKey == key\) return \(trade: trade, size: size\);" dotAll="true" id="calculator_state.size_pill.which_trade">
            <mutation text="return (trade: trade, size: size);"/>
            <mutation text="if (trade.resultKey != key) return (trade: trade, size: size);"/>
        </regex>
        <regex pattern="Trade\.drywall =&gt; DependentKeyId\.sheetSize," dotAll="true" id="calculator_state.size_pill.sheet_named_piece">
            <mutation text="Trade.drywall =&gt; DependentKeyId.pieceSize,"/>
        </regex>
        <regex pattern="Trade\.masonry =&gt; DependentKeyId\.pieceSize," dotAll="true" id="calculator_state.size_pill.piece_named_sheet">
            <mutation text="Trade.masonry =&gt; DependentKeyId.sheetSize,"/>
        </regex>

        <!-- RULE (T2b 3/3, CA-1096): the editor opens on the size turned on
             its side -->
        <regex pattern="\[sizeEntryFaces\(size\.width\), sizeEntryFaces\(size\.height\)\]," dotAll="true" id="calculator_state.size_pill.fields_swapped">
            <mutation text="[sizeEntryFaces(size.height), sizeEntryFaces(size.width)],"/>
        </regex>

        <!-- RULES (CA-1478): a trade key's refusal raises no Alert, or the
             empty store is named for the other trade -->
        <regex pattern="\(TapeRefused\(reason: TapeRefusal\.areaMustBeMoreThanZero\), _, _\) =&gt;\s*const CalculatorAreaMoreThanZeroToast\(\)," dotAll="true" id="calculator_state.toast.area_of_zero_silent">
            <mutation text=""/>
        </regex>
        <regex pattern="\(TapeRefused\(reason: TapeRefusal\.noSheetSizes\), _, _\) =&gt;\s*const CalculatorNoSizesToast\(Trade\.drywall\)," dotAll="true" id="calculator_state.toast.no_sheet_sizes">
            <mutation text=""/>
            <mutation text="(TapeRefused(reason: TapeRefusal.noSheetSizes), _, _) =&gt; const CalculatorNoSizesToast(Trade.masonry),"/>
        </regex>
        <regex pattern="\(TapeRefused\(reason: TapeRefusal\.noPieceSizes\), _, _\) =&gt;\s*const CalculatorNoSizesToast\(Trade\.masonry\)," dotAll="true" id="calculator_state.toast.no_piece_sizes">
            <mutation text=""/>
            <mutation text="(TapeRefused(reason: TapeRefusal.noPieceSizes), _, _) =&gt; const CalculatorNoSizesToast(Trade.drywall),"/>
        </regex>
    </rules>

    <commands>
        <command group="calculator_state" expected-return="0">flutter test test/features/calculator/units/blocs/calculator_bloc_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
