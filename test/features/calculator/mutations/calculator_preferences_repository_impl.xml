<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR PREFERENCES REPOSITORY MUTATION TESTING -->
    <!-- Targets: CalculatorPreferencesRepositoryImpl, the one path between
         the signed-in profile and the calculator's settings. A weakened
         guard here saves to nobody, drops every other key under
         user_preferences, leaves a fresh repository on the defaults for a
         user who is already signed in, or shows and writes the previous
         user's settings after a sign-out. -->

    <files>
        <file>lib/features/calculator/data/repositories/calculator_preferences_repository_impl.dart</file>
    </files>

    <rules>
        <!-- RULE 1: a save with no signed-in profile is answered as saved -->
        <regex pattern="if \(user == null\) \{\s*_logger\.warning\('No signed-in profile to save calculator preferences to'\);\s*return Left\(UserNotFoundFailure\(\)\);\s*\}" dotAll="true" id="calculator_preferences_repository.save.answer_missing_profile_as_saved">
            <mutation text="if (user == null) { return Right(_current); }"/>
        </regex>

        <!-- RULE 2: the other keys under user_preferences are dropped -->
        <regex pattern="\.\.\.user\.userPreferences,\s*CalculatorPreferencesDto\.preferencesKey:" dotAll="true" id="calculator_preferences_repository.save.drop_other_keys">
            <mutation text="CalculatorPreferencesDto.preferencesKey:"/>
        </regex>

        <!-- RULE 3: a failed update is answered as a success -->
        <regex pattern="if \(!result\.isSuccess\) \{" dotAll="true" id="calculator_preferences_repository.save.ignore_failure">
            <mutation text="if (false) {"/>
        </regex>

        <!-- RULE 4: the auth library's error type is replaced by a constant -->
        <regex pattern="final errorType = result\.errorType \?\? AuthErrorType\.serverError;" dotAll="true" id="calculator_preferences_repository.save.constant_error_type">
            <mutation text="final errorType = AuthErrorType.serverError;"/>
        </regex>

        <!-- RULE 5: a missing profile row is answered as a success -->
        <regex pattern="if \(written == null\) \{\s*_logger\.warning\('No profile row to save calculator preferences to'\);\s*return Left\(UserNotFoundFailure\(\)\);\s*\}" dotAll="true" id="calculator_preferences_repository.save.ignore_missing_row">
            <mutation text="if (written == null) { return Right(preferences); }"/>
        </regex>

        <!-- RULE 6: the profile signed in before the first watcher is never
             fetched -->
        <regex pattern="unawaited\(_loadSignedInProfile\(\)\);" dotAll="true" id="calculator_preferences_repository.follow.skip_signed_in_profile">
            <mutation text=""/>
        </regex>

        <!-- RULE 7: a disposed repository follows the profile again -->
        <regex pattern="if \(_isDisposed \|\| _profileSubscription != null\) return;" dotAll="true" id="calculator_preferences_repository.follow.ignore_disposed">
            <mutation text="if (_profileSubscription != null) return;"/>
        </regex>

        <!-- RULE 8: a profile change leaves the settings where they were -->
        <regex pattern="_user = user;\s*_current = _preferencesOf\(user\);" dotAll="true" id="calculator_preferences_repository.change.keep_current">
            <mutation text="_user = user;"/>
        </regex>

        <!-- RULE 9: a slow first fetch overwrites a profile announced while
             it ran -->
        <regex pattern="if \(_profileVersion == versionAtStart\) _onProfileChanged" dotAll="true" id="calculator_preferences_repository.fetch.skip_version_check">
            <mutation text="_onProfileChanged"/>
        </regex>

        <!-- RULE 10: the fetch's own echo brings the older profile back -->
        <regex pattern="if \(user != null &amp;&amp; identical\(user, _fetchEcho\)\) \{" dotAll="true" id="calculator_preferences_repository.announce.keep_echo">
            <mutation text="if (false) {"/>
        </regex>

        <!-- RULE 11: a save before the first fetch finishes starts a second
             fetch -->
        <regex pattern="if \(_signedInProfileFetch case final inFlight\?\) return inFlight\.result;" dotAll="true" id="calculator_preferences_repository.load.no_shared_fetch">
            <mutation text=""/>
        </regex>

        <!-- RULE 12: a finished fetch is kept, so no later save fetches again
             after a failure -->
        <regex pattern="if \(identical\(_signedInProfileFetch\?\.result, fetch\)\) \{\s*_signedInProfileFetch = null;\s*\}" dotAll="true" id="calculator_preferences_repository.fetch.keep_finished_fetch">
            <mutation text=""/>
        </regex>

        <!-- RULE 13: a fetch dropped at a user switch clears the next user's
             fetch from the record when it finishes, so a save fetches again -->
        <regex pattern="if \(identical\(_signedInProfileFetch\?\.result, fetch\)\) \{\s*_signedInProfileFetch = null;\s*\}" dotAll="true" id="calculator_preferences_repository.fetch.clear_next_users_fetch">
            <mutation text="_signedInProfileFetch = null;"/>
        </regex>

        <!-- RULE 14: a sign-out or a user switch on the auth state leaves the
             previous user's profile in place -->
        <regex pattern="if \(state\.user\?\.id != _followedCredentialId\) _forgetProfile\(\);" dotAll="true" id="calculator_preferences_repository.auth_state.keep_previous_user">
            <mutation text=""/>
        </regex>

        <!-- RULE 15: a save does not check whose profile it holds, so a
             switch the auth state has not announced yet writes the previous
             user's row -->
        <regex pattern="if \(credentials\.isSuccess &amp;&amp;\s*credentials\.data\?\.id != _followedCredentialId\) \{\s*_forgetProfile\(\);\s*\}" dotAll="true" id="calculator_preferences_repository.save.skip_credential_check">
            <mutation text=""/>
        </regex>

        <!-- RULE 16: a lost connection is taken for a sign-out -->
        <regex pattern="if \(state\.status == AuthStatus\.connectionError\) return;" dotAll="true" id="calculator_preferences_repository.auth_state.forget_on_connection_error">
            <mutation text=""/>
        </regex>

        <!-- RULE 17: an empty credential id is fetched -->
        <regex pattern="if \(credentialId == null \|\| credentialId\.isEmpty\) return Future\.value\(\);" dotAll="true" id="calculator_preferences_repository.load.fetch_empty_credential">
            <mutation text="if (credentialId == null) return Future.value();"/>
        </regex>

        <!-- RULE 18: a failed fetch is applied as "no profile", so a save
             answers not found instead of the auth library's error -->
        <regex pattern="if \(!result\.isSuccess\) return result\.errorType \?\? AuthErrorType\.serverError;" dotAll="true" id="calculator_preferences_repository.fetch.ignore_failure">
            <mutation text=""/>
        </regex>

        <!-- RULE 19: the echo is dropped for good, so the same profile
             announced again later is lost -->
        <regex pattern="_fetchEcho = null;\s*return;" dotAll="true" id="calculator_preferences_repository.announce.drop_echo_forever">
            <mutation text="return;"/>
        </regex>

        <!-- RULE 20: dispose leaves the profile subscription on the auth
             library -->
        <regex pattern="unawaited\(_profileSubscription\?\.cancel\(\)\);" dotAll="true" id="calculator_preferences_repository.dispose.keep_profile_subscription">
            <mutation text=""/>
        </regex>

        <!-- RULE 21: dispose leaves the auth state subscription on the auth
             library -->
        <regex pattern="unawaited\(_authStateSubscription\?\.cancel\(\)\);" dotAll="true" id="calculator_preferences_repository.dispose.keep_auth_state_subscription">
            <mutation text=""/>
        </regex>


        <!-- RULE 20: a change whose save failed stays in flight, so it rides
             along with the next save -->
        <regex pattern="\} finally \{\s*_changesInFlight\.remove\(change\);\s*\}" dotAll="true" id="calculator_preferences_repository.update.failed_change_rides_next_save">
            <mutation text="} finally {}"/>
        </regex>

        <!-- RULE 21: the echoes owed to the user who signed out are kept, so
             the next user's first announcement is swallowed -->
        <regex pattern="_signedInProfileFetch = null;\s*_echoesDue\.clear\(\);" dotAll="true" id="calculator_preferences_repository.forget.keep_echoes_due">
            <mutation text="_signedInProfileFetch = null;"/>
        </regex>

        <!-- RULE 22: the echo of an older save repaints the screen while a
             newer save's echo is still due -->
        <regex pattern="if \(_echoesDue\.isEmpty\) _onProfileChanged\(user\);" dotAll="true" id="calculator_preferences_repository.announce.repaint_mid_echoes">
            <mutation text="_onProfileChanged(user);"/>
        </regex>
    </rules>

    <commands>
        <command group="calculator_preferences_repository_impl" expected-return="0">flutter test test/features/calculator/units/data/repositories/calculator_preferences_repository_impl_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
