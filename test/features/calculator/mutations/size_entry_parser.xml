<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- SIZE ENTRY PARSER MUTATION TESTING (CA-1095, T2a 3/3): what a field of the size editor reads as -->

    <files>
        <file>lib/features/calculator/presentation/formatters/size_entry_parser.dart</file>
    </files>

    <rules>
        <regex pattern="parts\.map\(\(part\) =&gt; part\[0\]\)\.join\(\) != trimmed" dotAll="true" id="size_entry_parser.whole_field.leftovers_ignored">
            <mutation text="false"/>
        </regex>
        <regex pattern="null when parts\.length == 1 =&gt; _bareNumberUnit\(system\)," dotAll="true" id="size_entry_parser.bare_number.inside_a_compound">
            <mutation text="null =&gt; _bareNumberUnit(system),"/>
        </regex>
        <regex pattern="spelledIn \?\?= unit;" dotAll="true" id="size_entry_parser.unit.of_the_last_part">
            <mutation text="spelledIn = unit;"/>
        </regex>
        <regex pattern="\} on RationalOverflow \{" dotAll="true" id="size_entry_parser.overflow.escapes">
            <mutation text="} on FormatException {"/>
        </regex>
        <regex pattern="if \(spelledIn == null \|\| inches\.isZero\) return null;" dotAll="true" id="size_entry_parser.zero.is_a_size">
            <mutation text="if (spelledIn == null) return null;"/>
        </regex>
        <regex pattern="'CM': Unit\.centimetre," dotAll="true" id="size_entry_parser.face.cm_as_mm">
            <mutation text="'CM': Unit.millimetre,"/>
        </regex>
        <regex pattern="MeasurementSystem\.metric =&gt; Unit\.millimetre," dotAll="true" id="size_entry_parser.bare_number.inches_under_metric">
            <mutation text="MeasurementSystem.metric =&gt; Unit.inch,"/>
        </regex>
    </rules>

    <commands>
        <command group="size_entry_parser" expected-return="0">flutter test test/features/calculator/units/formatters/size_entry_parser_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
