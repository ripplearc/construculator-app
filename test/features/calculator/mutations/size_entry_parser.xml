<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- SIZE ENTRY PARSER MUTATION TESTING (CA-1095, T2a 3/3): what a field of the size editor reads as -->

    <files>
        <file>lib/features/calculator/presentation/formatters/size_entry_parser.dart</file>
    </files>

    <rules>
        <!-- RULE 1: what is left of a field after its key faces is ignored -->
        <regex pattern="if \(faces\.join\(\) != typed\) \{" dotAll="true" id="size_entry_parser.whole_field.leftovers_ignored">
            <mutation text="if (false) {"/>
        </regex>
        <!-- RULE 2 (R1, B1): a unit that cannot continue the value is not
             named, or an empty field is not a size of zero -->
        <regex pattern="return unit == null\s*\? const SizeEntryRefused\(SizeEntryRefusal\.unfinished\)\s*: _refusedUnit\(buffer, unit, face\);" dotAll="true" id="size_entry_parser.refusal.unit_not_named">
            <mutation text="return const SizeEntryRefused(SizeEntryRefusal.unfinished);"/>
        </regex>
        <regex pattern="if \(buffer\.isEmpty\) return const SizeEntryRefused\(SizeEntryRefusal\.zero\);" dotAll="true" id="size_entry_parser.empty.not_zero">
            <mutation text="if (buffer.isEmpty) return const SizeEntryRefused(SizeEntryRefusal.unfinished);"/>
        </regex>
        <!-- RULE 3 (R1, B1): Add does not close as the equals key does: a
             number after feet, a fraction after whole inches, a bare number -->
        <regex pattern="if \(finished\.tokens case \[\.\.\., Token\(unit: Unit\.foot\), _\]\) \{" dotAll="true" id="size_entry_parser.equals.inches_after_feet">
            <mutation text="if (false) {"/>
        </regex>
        <regex pattern="final finished = buffer\.withFractionClosedAsInches;" dotAll="true" id="size_entry_parser.equals.fraction_after_inches">
            <mutation text="final finished = buffer;"/>
        </regex>
        <!-- RULE 3a (R2, B3): a number with no unit is not named, a
             fraction with nothing under its line is named as one, or a
             bare 0 is -->
        <regex pattern="if \(finished\.tokens case \[final number\] when finished\.isOpen\) \{" dotAll="true" id="size_entry_parser.bare_number.not_named">
            <mutation text="if (false) {"/>
        </regex>
        <regex pattern="if \(number\.denominator == ''\) \{" dotAll="true" id="size_entry_parser.bare_number.open_fraction_named">
            <mutation text="if (false) {"/>
        </regex>
        <regex pattern="return number\.value == 0" dotAll="true" id="size_entry_parser.bare_number.zero_named">
            <mutation text="return false"/>
        </regex>
        <!-- RULE 3b (R2, B4): a size that rounds to zero reads as a size of
             zero, or a size of zero as one that rounds to it -->
        <regex pattern="return length\.inches\.toDouble\(\) == 0" dotAll="true" id="size_entry_parser.zero.rounding_not_told_apart">
            <mutation text="return true"/>
            <mutation text="return false"/>
        </regex>
        <!-- RULE 3c (R2, B4): the three mistakes of a unit key share one
             reason, or a unit key on an empty field names one -->
        <regex pattern="if \(before == null\) \{" dotAll="true" id="size_entry_parser.unit.nothing_before_named">
            <mutation text="if (false) {"/>
        </regex>
        <regex pattern="if \(before == unit\) \{" dotAll="true" id="size_entry_parser.unit.used_twice_not_named">
            <mutation text="if (false) {"/>
        </regex>
        <regex pattern="if \(!system\.contains\(unit\)\) \{" dotAll="true" id="size_entry_parser.unit.other_system_not_named">
            <mutation text="if (false) {"/>
        </regex>
        <regex pattern="if \(system\.indexOf\(unit\) &lt; system\.indexOf\(before\)\) \{" dotAll="true" id="size_entry_parser.unit.larger_after_smaller_reversed">
            <mutation text="if (system.indexOf(unit) &gt; system.indexOf(before)) {"/>
        </regex>
        <!-- RULE 4 (R1, B2): a number above the limit is a size, by what was
             typed or by what the row would show; the limit moves; or the
             limit itself is refused -->
        <regex pattern="if \(closed\.tokens\.any\(\(token\) =&gt; token\.value &gt; largestNumber\) \|\|\s*_storedNumberOf\(length, system\) &gt; largestNumber\) \{" dotAll="true" id="size_entry_parser.too_large">
            <mutation text="if (closed.tokens.any((token) =&gt; token.value &gt; largestNumber)) {"/>
            <mutation text="if (_storedNumberOf(length, system) &gt; largestNumber) {"/>
            <mutation text="if (closed.tokens.any((token) =&gt; token.value &gt;= largestNumber) || _storedNumberOf(length, system) &gt; largestNumber) {"/>
            <mutation text="if (closed.tokens.any((token) =&gt; token.value &gt; largestNumber) || _storedNumberOf(length, system) &gt;= largestNumber) {"/>
        </regex>
        <regex pattern="static const double largestNumber = 19999999\.99;" dotAll="true" id="size_entry_parser.too_large.limit">
            <mutation text="static const double largestNumber = 199999999.99;"/>
        </regex>
        <regex pattern="\(length\.inches\.toDouble\(\) \* QuantityFormatter\.millimetresPerInch\)" dotAll="true" id="size_entry_parser.too_large.metric_in_inches">
            <mutation text="(length.inches.toDouble())"/>
        </regex>
        <!-- RULE 5 (R1, B2): a size that shows as zero is a size -->
        <regex pattern="if \(writer\.formatStoredLength\(length\) == shownAsZero\) \{" dotAll="true" id="size_entry_parser.zero.shown_zero_is_a_size">
            <mutation text="if (length.inches.isZero) {"/>
            <mutation text="if (false) {"/>
        </regex>
        <!-- RULE 6: a key face reads as another unit -->
        <regex pattern="UnitType\.centimeter\.label: Unit\.centimetre," dotAll="true" id="size_entry_parser.face.cm_as_mm">
            <mutation text="UnitType.centimeter.label: Unit.millimetre,"/>
        </regex>

        <!-- RULES (T2b 3/3, CA-1096; term 2.18): a stored size is spelled
             with another key's face, or with the pill's suffix left in -->
        <regex pattern="MeasurementSystem\.imperial =&gt; \(Unit\.inch\.suffix, UnitType\.inch\.label\)," dotAll="true" id="size_entry_parser.faces.imperial_face">
            <mutation text="MeasurementSystem.imperial =&gt; (Unit.inch.suffix, UnitType.feet.label),"/>
        </regex>
        <regex pattern="Unit\.millimetre\.suffix,\s*UnitType\.millimeter\.label," dotAll="true" id="size_entry_parser.faces.metric_face">
            <mutation text="Unit.millimetre.suffix, UnitType.centimeter.label,"/>
        </regex>
        <regex pattern="\)\.formatStoredLength\(length\)\.replaceFirst\(suffix, face\);" dotAll="true" id="size_entry_parser.faces.suffix_left_in">
            <mutation text=").formatStoredLength(length);"/>
        </regex>
    </rules>

    <commands>
        <command group="size_entry_parser" expected-return="0">flutter test test/features/calculator/units/formatters/size_entry_parser_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
