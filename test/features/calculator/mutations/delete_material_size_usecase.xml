<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- DELETE MATERIAL SIZE USE CASE MUTATION TESTING (CA-1095, T2a 2/3) -->
    <!-- Targets: which stored size a deleted row of the sheet table removes,
         by its measure or by the name of its stored row. -->

    <files>
        <file>lib/features/calculator/domain/usecases/delete_material_size_usecase.dart</file>
        <file>lib/features/calculator/domain/entities/trade_store_entities.dart</file>
    </files>

    <rules>
        <regex pattern="\.watchSizes\(trade\.sizeStore, system\)" dotAll="true" id="delete_material_size.store.always_sheets">
            <mutation text=".watchSizes(SizeStore.sheet, system)"/>
        </regex>
        <regex pattern="\.watchSizes\(trade\.sizeStore, system\)" dotAll="true" id="delete_material_size.system.always_imperial">
            <mutation text=".watchSizes(trade.sizeStore, MeasurementSystem.imperial)"/>
        </regex>
        <regex pattern="\? width == size\.width &amp;&amp; height == size\.height" dotAll="true" id="delete_material_size.match.any_other_size">
            <mutation text="? !(width == size.width &amp;&amp; height == size.height)"/>
        </regex>
        <!-- R1 (B1): a size named by its stored row is matched by its measure,
             so of two rows with one size the first goes whichever was
             swiped; or every other row is taken for it -->
        <regex pattern=": \(id \?\? seed\) == size\.id;" dotAll="true" id="delete_material_size.match.named_row">
            <mutation text=": width == size.width &amp;&amp; height == size.height;"/>
            <mutation text=": (id ?? seed) != size.id;"/>
        </regex>
        <regex pattern="if \(stored\.isTheRowOf\(size\)\) return _repository\.deleteSize\(stored\);" dotAll="true" id="delete_material_size.match.not_deleted">
            <mutation text="if (stored.isTheRowOf(size)) continue;"/>
        </regex>
    </rules>

    <commands>
        <command group="delete_material_size" expected-return="0">flutter test test/features/calculator/units/domain/usecases/delete_material_size_usecase_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
