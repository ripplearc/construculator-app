<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR LABEL FORMATTER: THE BRACKET CHIP'S WORDS (T1a, CA-1092) -->
    <!-- Targets: the screen-reader label a bracket chip is given, since the
         chip's own would read the same for an open and a closed bracket. -->

    <files>
        <file>lib/features/calculator/presentation/formatters/calculator_label_formatter.dart</file>
    </files>

    <rules>
        <!-- RULE 1: an open bracket is read as a closed one -->
        <regex pattern="'\$\{l10n\.calculatorBracketOpenSemantics\(chip\.value \?\? ''\)\}'," dotAll="true" id="calculator_label_formatter.chips.open_read_as_closed">
            <mutation text="'${l10n.calculatorBracketClosedSemantics(chip.value ?? '')}',"/>
        </regex>

        <!-- RULE 2: a closed bracket is read as an open one -->
        <regex pattern="'\$\{l10n\.calculatorBracketClosedSemantics\(chip\.value \?\? ''\)\}'," dotAll="true" id="calculator_label_formatter.chips.closed_read_as_open">
            <mutation text="'${l10n.calculatorBracketOpenSemantics(chip.value ?? '')}',"/>
        </regex>

        <!-- RULE 3: every other chip loses the label it was given -->
        <regex pattern="_ => chip\.semanticsLabel," dotAll="true" id="calculator_label_formatter.chips.drop_given_label">
            <mutation text="_ => null,"/>
        </regex>

        <!-- RULE 3a: a bracket after + is read as after − -->
        <regex pattern="if \(factor == CoreIcons\.addOperator\) return Operator\.add\.symbol;" dotAll="true" id="calculator_label_formatter.lead.add_as_subtract">
            <mutation text="if (factor == CoreIcons.addOperator) return Operator.subtract.symbol;"/>
        </regex>

        <!-- RULE 3b: a bracket after − is read as after + -->
        <regex pattern="if \(factor == CoreIcons\.subtractOperator\) return Operator\.subtract\.symbol;" dotAll="true" id="calculator_label_formatter.lead.subtract_as_add">
            <mutation text="if (factor == CoreIcons.subtractOperator) return Operator.add.symbol;"/>
        </regex>

        <!-- RULE 3c: a bracket after × is read as after ÷ -->
        <regex pattern="if \(factor == CoreIcons\.multiplyOperator\) return Operator\.multiply\.symbol;" dotAll="true" id="calculator_label_formatter.lead.multiply_as_divide">
            <mutation text="if (factor == CoreIcons.multiplyOperator) return Operator.divide.symbol;"/>
        </regex>

        <!-- RULE 3d: a bracket after ÷ is read as after nothing -->
        <regex pattern="if \(factor == CoreIcons\.divide\) return Operator\.divide\.symbol;" dotAll="true" id="calculator_label_formatter.lead.divide_silent">
            <mutation text="if (factor == CoreIcons.divide) return '';"/>
        </regex>

        <!-- RULE 4 (S1c 3/5, CA-1089): every chip says a tap edits it -->
        <regex pattern="CoreCalculatorChipType\.editable \|\|\s*CoreCalculatorChipType\.bracketClosed when onChipTap != null =&gt;\s*l10n\.calculatorChipTapToEdit," dotAll="true" id="calculator_label_formatter.chips.every_chip_says_edit">
            <mutation text="_ when onChipTap != null =&gt; l10n.calculatorChipTapToEdit,"/>
        </regex>

        <!-- RULE 4b (S1c bracket edit 2/2, CA-1089): the open bracket says a
             tap edits it, not that it closes it -->
        <regex pattern="CoreCalculatorChipType\.bracketOpen when onChipTap != null =&gt;\s*l10n\.calculatorChipTapToClose," dotAll="true" id="calculator_label_formatter.chips.open_bracket_says_edit">
            <mutation text="CoreCalculatorChipType.bracketOpen when onChipTap != null =&gt; l10n.calculatorChipTapToEdit,"/>
        </regex>

        <!-- RULE 4a: the chip being edited says a tap edits it -->
        <regex pattern="CoreCalculatorChipType\.active when onChipTap != null =&gt;\s*l10n\.calculatorChipTapToFinish," dotAll="true" id="calculator_label_formatter.chips.active_says_edit">
            <mutation text="CoreCalculatorChipType.active when onChipTap != null =&gt; l10n.calculatorChipTapToEdit,"/>
        </regex>

        <!-- RULE 5: every chip taps back as the first one -->
        <regex pattern="\(\) =&gt; onChipTap\(index\)," dotAll="true" id="calculator_label_formatter.chips.tap_index_lost">
            <mutation text="() =&gt; onChipTap(0),"/>
        </regex>

        <!-- RULE 7 (S1c 5/5, CA-1089): the weight to remove is named, not
             its key -->
        <regex pattern="l10n\.calculatorToastNeedsLengthBody\(unitKeyFace\(unit\)\)," dotAll="true" id="calculator_label_formatter.toast.remove_unit_by_name">
            <mutation text="l10n.calculatorToastNeedsLengthBody(unitName(unit)),"/>
        </regex>

        <!-- RULE 8: Lbs is the face of Kg -->
        <regex pattern="Unit\.pound => l10n\.calculatorKeyLbs," dotAll="true" id="calculator_label_formatter.face.lbs_as_kg">
            <mutation text="Unit.pound => l10n.calculatorKeyKg,"/>
        </regex>

        <!-- RULE 6: a result chip taps back too -->
        <regex pattern="CoreCalculatorChipType\.editable \|\|\s*CoreCalculatorChipType\.active \|\|\s*CoreCalculatorChipType\.bracketClosed \|\|\s*CoreCalculatorChipType\.bracketOpen when onChipTap != null =&gt;\s*\(\) =&gt; onChipTap\(index\)," dotAll="true" id="calculator_label_formatter.chips.result_taps_back">
            <mutation text="_ when onChipTap != null =&gt; () =&gt; onChipTap(index),"/>
        </regex>

        <!-- RULE 6a: a bracket chip takes no tap -->
        <regex pattern="CoreCalculatorChipType\.editable \|\|\s*CoreCalculatorChipType\.active \|\|\s*CoreCalculatorChipType\.bracketClosed \|\|\s*CoreCalculatorChipType\.bracketOpen when onChipTap != null =&gt;\s*\(\) =&gt; onChipTap\(index\)," dotAll="true" id="calculator_label_formatter.chips.bracket_takes_no_tap">
            <mutation text="CoreCalculatorChipType.editable || CoreCalculatorChipType.active when onChipTap != null =&gt; () =&gt; onChipTap(index),"/>
        </regex>
    </rules>

    <commands>
        <command group="calculator_label_formatter" expected-return="0">flutter test test/features/calculator/units/formatters/calculator_label_formatter_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
