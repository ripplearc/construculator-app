<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR LABEL FORMATTER: THE BRACKET CHIP'S WORDS (T1a, CA-1092) -->
    <!-- Targets: the screen-reader label a bracket chip is given, since the
         chip's own would read the same for an open and a closed bracket. -->

    <files>
        <file>lib/features/calculator/presentation/formatters/calculator_label_formatter.dart</file>
    </files>

    <rules>
        <!-- RULE 1: an open bracket is read as a closed one -->
        <regex pattern="'\$\{l10n\.calculatorBracketOpenSemantics\(chip\.value \?\? ''\)\}'," dotAll="true" id="calculator_label_formatter.chips.open_read_as_closed">
            <mutation text="'${l10n.calculatorBracketClosedSemantics(chip.value ?? '')}',"/>
        </regex>

        <!-- RULE 2: a closed bracket is read as an open one -->
        <regex pattern="'\$\{l10n\.calculatorBracketClosedSemantics\(chip\.value \?\? ''\)\}'," dotAll="true" id="calculator_label_formatter.chips.closed_read_as_open">
            <mutation text="'${l10n.calculatorBracketOpenSemantics(chip.value ?? '')}',"/>
        </regex>

        <!-- RULE 3: every other chip loses the label it was given -->
        <regex pattern="_ => chip\.semanticsLabel," dotAll="true" id="calculator_label_formatter.chips.drop_given_label">
            <mutation text="_ => null,"/>
        </regex>

        <!-- RULE 3a: a bracket is read after the first operator its factor
             is not -->
        <regex pattern="if \(value == factor\) return key\.symbol;" dotAll="true" id="calculator_label_formatter.lead.wrong_operator">
            <mutation text="if (value != factor) return key.symbol;"/>
        </regex>

        <!-- RULE 3b: a bracket that starts the chain is read after + -->
        <regex pattern="if \(value == factor\) return key\.symbol;\s*\}\s*return '';" dotAll="true" id="calculator_label_formatter.lead.silent_as_add">
            <mutation text="if (value == factor) return key.symbol; } return Operator.add.symbol;"/>
        </regex>

        <!-- RULE 4 (S1c 3/5, CA-1089): every chip says a tap edits it -->
        <regex pattern="CoreCalculatorChipType\.editable \|\|\s*CoreCalculatorChipType\.bracketClosed when onChipTap != null =&gt;\s*l10n\.calculatorChipTapToEdit," dotAll="true" id="calculator_label_formatter.chips.every_chip_says_edit">
            <mutation text="_ when onChipTap != null =&gt; l10n.calculatorChipTapToEdit,"/>
        </regex>

        <!-- RULE 4b (S1c bracket edit 2/2, CA-1089): the open bracket says a
             tap edits it, not that it closes it -->
        <regex pattern="CoreCalculatorChipType\.bracketOpen when onChipTap != null =&gt;\s*l10n\.calculatorChipTapToClose," dotAll="true" id="calculator_label_formatter.chips.open_bracket_says_edit">
            <mutation text="CoreCalculatorChipType.bracketOpen when onChipTap != null =&gt; l10n.calculatorChipTapToEdit,"/>
        </regex>

        <!-- RULE 4a: the chip being edited says a tap edits it -->
        <regex pattern="CoreCalculatorChipType\.active when onChipTap != null =&gt;\s*l10n\.calculatorChipTapToFinish," dotAll="true" id="calculator_label_formatter.chips.active_says_edit">
            <mutation text="CoreCalculatorChipType.active when onChipTap != null =&gt; l10n.calculatorChipTapToEdit,"/>
        </regex>

        <!-- RULE 5: every chip taps back as the first one -->
        <regex pattern="\(\) =&gt; onChipTap\(index\)," dotAll="true" id="calculator_label_formatter.chips.tap_index_lost">
            <mutation text="() =&gt; onChipTap(0),"/>
        </regex>

        <!-- RULE 7 (S1c 5/5, CA-1089): the weight to remove is named, not
             its key -->
        <regex pattern="l10n\.calculatorToastNeedsLengthBody\(unitKeyFace\(unit\)\)," dotAll="true" id="calculator_label_formatter.toast.remove_unit_by_name">
            <mutation text="l10n.calculatorToastNeedsLengthBody(unitName(unit)),"/>
        </regex>

        <!-- RULE 8: Lbs is the face of Kg -->
        <regex pattern="Unit\.pound => l10n\.calculatorKeyLbs," dotAll="true" id="calculator_label_formatter.face.lbs_as_kg">
            <mutation text="Unit.pound => l10n.calculatorKeyKg,"/>
        </regex>

        <!-- RULE 6: a result chip taps back too -->
        <regex pattern="CoreCalculatorChipType\.editable \|\|\s*CoreCalculatorChipType\.active \|\|\s*CoreCalculatorChipType\.bracketClosed \|\|\s*CoreCalculatorChipType\.bracketOpen when onChipTap != null =&gt;\s*\(\) =&gt; onChipTap\(index\)," dotAll="true" id="calculator_label_formatter.chips.result_taps_back">
            <mutation text="_ when onChipTap != null =&gt; () =&gt; onChipTap(index),"/>
        </regex>
        <!-- RULE 4 (S1c 4/5 R1): two removed results are named as one, or
             the count of the rest is off by one -->
        <regex pattern="CalculatorResultRemovedToast\(keys: \[final first, final second\]\) =>\s*l10n\.calculatorToastResultsRemovedBoth\(\s*displayLabel\(first\),\s*displayLabel\(second\),\s*\)," dotAll="true" id="calculator_label_formatter.toast.second_unnamed">
            <mutation text="CalculatorResultRemovedToast(keys: [final first, final _]) => l10n.calculatorToastResultRemoved(displayLabel(first)),"/>
        </regex>
        <regex pattern="l10n\.calculatorToastResultsRemovedMore\(displayLabel\(first\), more\.length\)," dotAll="true" id="calculator_label_formatter.toast.rest_miscounted">
            <mutation text="l10n.calculatorToastResultsRemovedMore(displayLabel(first), more.length + 1),"/>
        </regex>


        <!-- RULE 6a: a bracket chip takes no tap -->
        <regex pattern="CoreCalculatorChipType\.editable \|\|\s*CoreCalculatorChipType\.active \|\|\s*CoreCalculatorChipType\.bracketClosed \|\|\s*CoreCalculatorChipType\.bracketOpen when onChipTap != null =&gt;\s*\(\) =&gt; onChipTap\(index\)," dotAll="true" id="calculator_label_formatter.chips.bracket_takes_no_tap">
            <mutation text="CoreCalculatorChipType.editable || CoreCalculatorChipType.active when onChipTap != null =&gt; () =&gt; onChipTap(index),"/>
        </regex>
        <!-- CA-1094 (Section 1.8): the Sides note, and the Alert = raises on a
             warning, read in another note's words -->
        <regex pattern="CalculatorSidesNotWholeNote\(\) =&gt; l10n\.calculatorNoteSidesNotWhole," dotAll="true" id="calculator_label_formatter.note.sides_words">
            <mutation text="CalculatorSidesNotWholeNote() =&gt; l10n.calculatorNoteSlopeAboveZero,"/>
        </regex>
        <regex pattern="CalculatorRangeWarning\.pitchUnderRightAngle =&gt;\s*l10n\.calculatorToastPitchUnderRightAngleTitle," dotAll="true" id="calculator_label_formatter.toast.right_angle_title">
            <mutation text="CalculatorRangeWarning.pitchUnderRightAngle =&gt; l10n.calculatorToastPitchAtLeastZeroTitle,"/>
        </regex>
        <regex pattern="CalculatorRangeWarning\.pitchAtLeastZero =&gt;\s*l10n\.calculatorToastPitchAtLeastZeroTitle," dotAll="true" id="calculator_label_formatter.toast.below_zero_title">
            <mutation text="CalculatorRangeWarning.pitchAtLeastZero =&gt; l10n.calculatorToastPitchUnderRightAngleTitle,"/>
        </regex>
        <regex pattern="CalculatorRangeWarning\.flatPitchHasNoRun =&gt;\s*l10n\.calculatorToastFlatPitchHasNoRunTitle," dotAll="true" id="calculator_label_formatter.toast.flat_pitch_title">
            <mutation text="CalculatorRangeWarning.flatPitchHasNoRun =&gt; l10n.calculatorToastSlopeAboveZeroTitle,"/>
        </regex>
        <regex pattern="CalculatorRangeWarning\.slopeAboveZero =&gt;\s*l10n\.calculatorToastSlopeAboveZeroTitle," dotAll="true" id="calculator_label_formatter.toast.slope_title">
            <mutation text="CalculatorRangeWarning.slopeAboveZero =&gt; l10n.calculatorToastFlatPitchHasNoRunTitle,"/>
        </regex>
        <regex pattern="\) =&gt;\s*l10n\.calculatorToastEditTheSlopeChipBody," dotAll="true" id="calculator_label_formatter.toast.slope_body">
            <mutation text=") =&gt; l10n.calculatorToastEditThePitchChipBody,"/>
        </regex>
        <regex pattern="CalculatorRangeWarningToast\(\) =&gt; l10n\.calculatorToastEditThePitchChipBody," dotAll="true" id="calculator_label_formatter.toast.pitch_body">
            <mutation text="CalculatorRangeWarningToast() =&gt; l10n.calculatorToastEditTheSlopeChipBody,"/>
        </regex>
        <!-- CA-1376 (Section 1.8): the tip reads the wrong sign or side, its
             short form starts one character early or never, and the percent
             Alerts read in another Alert's words -->
        <regex pattern="if \(full\.length &lt;= longestNote\) return full;" dotAll="true" id="calculator_label_formatter.tip.limit">
            <mutation text="if (full.length &lt; longestNote) return full;"/>
            <mutation text="return full;"/>
        </regex>
        <regex pattern="\? l10n\.calculatorNotePercentAddsSoFar\(tip\.percent\)\s*: l10n\.calculatorNotePercentTakesOffSoFar\(tip\.percent\);" dotAll="true" id="calculator_label_formatter.tip.short_sign">
            <mutation text="? l10n.calculatorNotePercentTakesOffSoFar(tip.percent) : l10n.calculatorNotePercentAddsSoFar(tip.percent);"/>
        </regex>
        <regex pattern="\(true, false\) =&gt; l10n\.calculatorNotePercentAddsOfTheTotal\(" dotAll="true" id="calculator_label_formatter.tip.adds_total">
            <mutation text="(true, false) =&gt; l10n.calculatorNotePercentAddsOfTheBracket("/>
        </regex>
        <regex pattern="\(true, true\) =&gt; l10n\.calculatorNotePercentAddsOfTheBracket\(" dotAll="true" id="calculator_label_formatter.tip.adds_bracket">
            <mutation text="(true, true) =&gt; l10n.calculatorNotePercentAddsOfTheTotal("/>
        </regex>
        <regex pattern="\(false, false\) =&gt; l10n\.calculatorNotePercentTakesOffOfTheTotal\(" dotAll="true" id="calculator_label_formatter.tip.takes_off_total">
            <mutation text="(false, false) =&gt; l10n.calculatorNotePercentAddsOfTheTotal("/>
        </regex>
        <regex pattern="\(false, true\) =&gt; l10n\.calculatorNotePercentTakesOffOfTheBracket\(" dotAll="true" id="calculator_label_formatter.tip.takes_off_bracket">
            <mutation text="(false, true) =&gt; l10n.calculatorNotePercentTakesOffOfTheTotal("/>
        </regex>
        <regex pattern="CalculatorPercentNeedsANumberToast\(\) \|\|\s*CalculatorTypeANumberFirstToast\(\) =&gt;\s*l10n\.calculatorToastTypeANumberFirstTitle,\s*CalculatorFinishTheEditToast\(\) =&gt; l10n\.calculatorToastFinishTheEditTitle," dotAll="true" id="calculator_label_formatter.toast.percent_number_title">
            <mutation text="CalculatorPercentNeedsANumberToast() =&gt; l10n.calculatorToastPercentNeedsAnOperatorTitle, CalculatorTypeANumberFirstToast() =&gt; l10n.calculatorToastTypeANumberFirstTitle, CalculatorFinishTheEditToast() =&gt; l10n.calculatorToastFinishTheEditTitle,"/>
            <mutation text="CalculatorPercentNeedsANumberToast() =&gt; l10n.calculatorToastTypeANumberFirstTitle, CalculatorTypeANumberFirstToast() =&gt; l10n.calculatorToastFinishTheEditTitle, CalculatorFinishTheEditToast() =&gt; l10n.calculatorToastFinishTheEditTitle,"/>
            <mutation text="CalculatorPercentNeedsANumberToast() || CalculatorTypeANumberFirstToast() =&gt; l10n.calculatorToastTypeANumberFirstTitle, CalculatorFinishTheEditToast() =&gt; l10n.calculatorToastFinishValueTitle,"/>
        </regex>
        <!-- CA-1514, CA-1515: the two Alert bodies swapped for another body -->
        <regex pattern="CalculatorTypeANumberFirstToast\(:final operator\) =&gt;\s*l10n\.calculatorToastTypeANumberOrBackspaceBody\(operator\)," dotAll="true" id="calculator_label_formatter.toast.type_a_number_or_backspace_body">
            <mutation text="CalculatorTypeANumberFirstToast(:final operator) =&gt; l10n.calculatorToastPercentAfterOperatorBody(operator),"/>
            <mutation text="CalculatorTypeANumberFirstToast() =&gt; l10n.calculatorToastTypeANumberOrBackspaceBody('×'),"/>
        </regex>
        <regex pattern="CalculatorFinishTheEditToast\(\) =&gt; l10n\.calculatorToastFinishTheEditBody," dotAll="true" id="calculator_label_formatter.toast.finish_the_edit_body">
            <mutation text="CalculatorFinishTheEditToast() =&gt; l10n.calculatorToastValueEmptyBody,"/>
        </regex>
        <regex pattern="CalculatorPercentNeedsAnOperatorToast\(insideABracket: true\) =&gt;\s*l10n\.calculatorToastPercentNeedsAnOperatorInBracketBody," dotAll="true" id="calculator_label_formatter.toast.percent_bracket_body">
            <mutation text="CalculatorPercentNeedsAnOperatorToast(insideABracket: true) =&gt; l10n.calculatorToastPercentNeedsAnOperatorBody,"/>
        </regex>
        <regex pattern="CalculatorPercentTakesNoUnitToast\(\) =&gt;\s*l10n\.calculatorToastPercentTakesNoUnitBody," dotAll="true" id="calculator_label_formatter.toast.takes_no_unit_body">
            <mutation text="CalculatorPercentTakesNoUnitToast() =&gt; l10n.calculatorToastPercentHasNoUnitBody,"/>
        </regex>
        <regex pattern="CalculatorPercentDividesByZeroToast\(:final bracket\) =&gt;\s*l10n\.calculatorToastPercentBracketIsZeroBody\(bracket\)," dotAll="true" id="calculator_label_formatter.toast.bracket_body">
            <mutation text="CalculatorPercentDividesByZeroToast(:final bracket) =&gt; l10n.calculatorToastPercentBracketIsZeroBody(''),"/>
        </regex>
        <!-- CA-1094: with no note the strip still gets a note, its placeholder -->
        <regex pattern="String\? noteText\(CalculatorStripNote\? note\) =&gt; switch \(note\) \{\s*null =&gt; null," dotAll="true" id="calculator_label_formatter.note.none_is_a_note">
            <mutation text="String? noteText(CalculatorStripNote? note) =&gt; switch (note) { null =&gt; l10n.calculatorStripPlaceholder,"/>
        </regex>
        <!-- CA-1198: a keyboard key or control is read in another key's words,
             or a digit by its bare face -->
        <regex pattern="ControlAction\.delete =&gt; l10n\.calculatorKeyDeleteSemantics,\s*ControlAction\.clearAll =&gt; l10n\.calculatorKeyClearAllSemantics," dotAll="true" id="calculator_label_formatter.keyboard.control_labels_swapped">
            <mutation text="ControlAction.delete =&gt; l10n.calculatorKeyClearAllSemantics, ControlAction.clearAll =&gt; l10n.calculatorKeyDeleteSemantics,"/>
        </regex>
        <regex pattern="ControlAction\.delete =&gt; l10n\.calculatorKeyDeleteHint,\s*ControlAction\.clearAll =&gt; l10n\.calculatorKeyClearAllHint," dotAll="true" id="calculator_label_formatter.keyboard.control_hints_swapped">
            <mutation text="ControlAction.delete =&gt; l10n.calculatorKeyClearAllHint, ControlAction.clearAll =&gt; l10n.calculatorKeyDeleteHint,"/>
        </regex>
        <regex pattern="ControlAction\.paren =&gt; l10n\.calculatorBracketKeySemantics," dotAll="true" id="calculator_label_formatter.keyboard.bracket_label">
            <mutation text="ControlAction.paren =&gt; l10n.calculatorKeyDeleteSemantics,"/>
        </regex>
        <regex pattern="digitLabel: \(digit\) =&gt; l10n\.calculatorKeyDigitSemantics\(digit\.label\)," dotAll="true" id="calculator_label_formatter.keyboard.digit_bare">
            <mutation text="digitLabel: (digit) =&gt; digit.label,"/>
        </regex>
        <regex pattern="groupHeader: l10n\.calculatorGroupHeaderSemantics," dotAll="true" id="calculator_label_formatter.keyboard.group_header">
            <mutation text="groupHeader: l10n.calculatorReorderGroupSemantics,"/>
        </regex>
        <regex pattern="dragHandle: l10n\.calculatorKeyboardHandleSemantics," dotAll="true" id="calculator_label_formatter.keyboard.drag_handle">
            <mutation text="dragHandle: l10n.calculatorViewAllSemantics,"/>
        </regex>
        <!-- CA-1370: the keyboard shows one of its words in another's place -->
        <regex pattern="imperial: l10n\.calculatorUnitSystemImperial,\s*metric: l10n\.calculatorUnitSystemMetric," dotAll="true" id="calculator_label_formatter.keyboard.systems_swapped">
            <mutation text="imperial: l10n.calculatorUnitSystemMetric, metric: l10n.calculatorUnitSystemImperial,"/>
        </regex>
        <regex pattern="viewAll: l10n\.calculatorViewAllButton," dotAll="true" id="calculator_label_formatter.keyboard.view_all_face">
            <mutation text="viewAll: l10n.calculatorFunctionKeysTitle,"/>
        </regex>
        <regex pattern="groupHeader: l10n\.calculatorGroupHeader," dotAll="true" id="calculator_label_formatter.keyboard.visible_group_header">
            <mutation text="groupHeader: l10n.calculatorGroupHeaderSemantics,"/>
        </regex>
        <!-- T2a 3/3 R1 (CA-1095): a field of the size editor is answered in
             another reason's words, and the "Size not added" Alert loses its
             title or reads its title twice -->
        <regex pattern="SizeEntryRefused\(reason: SizeEntryRefusal\.zero\) =&gt;\s*l10n\.calculatorSizeEditorSizeError," dotAll="true" id="calculator_label_formatter.size_entry.zero_words">
            <mutation text="SizeEntryRefused(reason: SizeEntryRefusal.zero) =&gt; l10n.calculatorToastFinishValueTitle,"/>
        </regex>
        <regex pattern="SizeEntryRefused\(\) =&gt; l10n\.calculatorToastFinishValueTitle," dotAll="true" id="calculator_label_formatter.size_entry.unfinished_words">
            <mutation text="SizeEntryRefused() =&gt; l10n.calculatorSizeEditorSizeError,"/>
        </regex>
        <regex pattern="SizeEntryRefused\(reason: SizeEntryRefusal\.tooLarge\) =&gt;\s*l10n\.calculatorSizeEditorTooLargeError," dotAll="true" id="calculator_label_formatter.size_entry.too_large_words">
            <mutation text="SizeEntryRefused(reason: SizeEntryRefusal.tooLarge) =&gt; l10n.calculatorSizeEditorSizeError,"/>
        </regex>
        <!-- T2a 3/3 R2 (CA-1095; B3, B4): a mistake of a size field is
             answered in another mistake's words, or its two names are
             swapped -->
        <regex pattern="l10n\.calculatorSizeEditorUnitUsedTwiceError\(unit\.name, unitFace\)," dotAll="true" id="calculator_label_formatter.size_entry.used_twice_words">
            <mutation text="l10n.calculatorToastFinishValueTitle,"/>
        </regex>
        <regex pattern="SizeEntryRefused\(reason: SizeEntryRefusal\.otherSystem\) =&gt;\s*l10n\.calculatorSizeEditorOtherSystemError," dotAll="true" id="calculator_label_formatter.size_entry.other_system_words">
            <mutation text="SizeEntryRefused(reason: SizeEntryRefusal.otherSystem) =&gt; l10n.calculatorSizeEditorSizeError,"/>
        </regex>
        <regex pattern="l10n\.calculatorSizeEditorUnitWord\(unit\.name\),\s*l10n\.calculatorSizeEditorUnitWord\(after\.name\)," dotAll="true" id="calculator_label_formatter.size_entry.larger_and_smaller_swapped">
            <mutation text="l10n.calculatorSizeEditorUnitWord(after.name), l10n.calculatorSizeEditorUnitWord(unit.name),"/>
        </regex>
        <regex pattern="l10n\.calculatorSizeEditorNoUnitError\(typed\)," dotAll="true" id="calculator_label_formatter.size_entry.no_unit_words">
            <mutation text="l10n.calculatorSizeEditorSizeError,"/>
        </regex>
        <regex pattern="l10n\.calculatorSizeEditorRoundsToZeroError\(typed, shownAs\)," dotAll="true" id="calculator_label_formatter.size_entry.typed_and_shown_swapped">
            <mutation text="l10n.calculatorSizeEditorRoundsToZeroError(shownAs, typed),"/>
        </regex>
        <regex pattern="CalculatorSizeNotAddedToast\(\) =&gt; l10n\.calculatorToastSizeNotAddedTitle," dotAll="true" id="calculator_label_formatter.size_not_added.no_title">
            <mutation text="CalculatorSizeNotAddedToast() =&gt; null,"/>
        </regex>
        <regex pattern="CalculatorSizeNotAddedToast\(\) =&gt; l10n\.calculatorToastSizeNotAddedBody," dotAll="true" id="calculator_label_formatter.size_not_added.title_as_body">
            <mutation text="CalculatorSizeNotAddedToast() =&gt; l10n.calculatorToastSizeNotAddedTitle,"/>
        </regex>
    </rules>

    <commands>
        <command group="calculator_label_formatter" expected-return="0">flutter test test/features/calculator/units/formatters/calculator_label_formatter_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
