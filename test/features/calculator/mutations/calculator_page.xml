<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR PAGE: ✕ AT REST LEAVES FOR HOME (T1a, CA-1092); THE
         EDITING GUARDS' TOAST (S1c 4/5, CA-1089) -->
    <!-- Targets: the one listener that pops the page when the bloc says the
         calculator closes, and only on the state that says it first; and
         the same listener showing a toast every time a key raises one, and
         never on a state that merely still holds it. -->

    <files>
        <file>lib/features/calculator/presentation/pages/calculator_page.dart</file>
    </files>

    <rules>
        <!-- RULE 1: the page never leaves -->
        <regex pattern="\(current\.closesCalculator &amp;&amp; !previous\.closesCalculator\)" dotAll="true" id="calculator_page.close.never_pops">
            <mutation text="false"/>
        </regex>

        <!-- RULE 2: every later state pops the page again -->
        <regex pattern="\(current\.closesCalculator &amp;&amp; !previous\.closesCalculator\)" dotAll="true" id="calculator_page.close.pops_again">
            <mutation text="current.closesCalculator"/>
        </regex>

        <!-- RULE 3 (S1c 4/5, CA-1089): the red Alert is never drawn -->
        <regex pattern="if \(state\.toast case final toast\?\s*when !state\.toastClosed\)" dotAll="true" id="calculator_page.toast.never_shown">
            <mutation text="if (state.toast case final toast? when false)"/>
        </regex>

        <!-- RULE 4: the Alert stays drawn after its ✕ closed it -->
        <regex pattern="if \(state\.toast case final toast\?\s*when !state\.toastClosed\)" dotAll="true" id="calculator_page.toast.shown_after_close">
            <mutation text="if (state.toast case final toast?)"/>
        </regex>

        <!-- RULE 4a: the Alert's ✕ tells the bloc nothing -->
        <regex pattern="title: labels\.toastTitle\(toast\),\s*onClose: \(\) =&gt;\s*bloc\.add\(const CalculatorToastClosed\(\)\)," dotAll="true" id="calculator_page.toast.close_unheard">
            <mutation text="title: labels.toastTitle(toast), onClose: () {},"/>
        </regex>

        <!-- RULE 4b: a screen reader never hears the message, or hears it
             again for a state that merely still holds it -->
        <regex pattern="current\.toastsRaised != previous\.toastsRaised," dotAll="true" id="calculator_page.toast.never_announced">
            <mutation text="false,"/>
            <mutation text="current.toast != null,"/>
        </regex>

        <!-- RULE 4c (R3, B2): on a short phone the display never scrolls, so
             the Alert covers the value it talks about; or the display stays
             scrolled after the Alert closes -->
        <regex pattern="if \(hiddenHeight &lt;= 0\) return;" dotAll="true" id="calculator_page.alert.value_stays_under_it">
            <mutation text="return;"/>
        </regex>
        <regex pattern="_displayScroll\.jumpTo\(offset\);" dotAll="true" id="calculator_page.alert.display_not_scrolled_back">
            <mutation text=""/>
        </regex>

        <!-- RULE 5 (S1c bracket 2/2 R1): "Editing this group" closes by a
             timer, or is drawn as the red Alert -->
        <regex pattern="onClose: \(\) =>\s*bloc\.add\(const CalculatorToastClosed\(\)\),\s*duration: null," dotAll="true" id="calculator_page.group_toast.timed">
            <mutation text="onClose: () => bloc.add(const CalculatorToastClosed()), duration: const Duration(seconds: 5),"/>
        </regex>
        <regex pattern="CalculatorEditingGroupToast\(\) => Toast\.receipt\(" dotAll="true" id="calculator_page.group_toast.red">
            <mutation text="CalculatorEditingGroupToast() when false => Toast.receipt("/>
        </regex>
        <!-- RULE 5a: the Close action leaves the toast up. A receipt has no
             ✕ and no timer here, and its action always ends in onClose, so
             either callback alone closes it: only both silenced are heard -->
        <regex pattern="onAction: \(\) =>\s*bloc\.add\(const CalculatorToastClosed\(\)\),\s*onClose: \(\) =>\s*bloc\.add\(const CalculatorToastClosed\(\)\)," dotAll="true" id="calculator_page.group_toast.action_unheard">
            <mutation text="onAction: () {}, onClose: () {},"/>
        </regex>

        <!-- RULE 3 (T1b F1): a new group map keeps the old ordered list -->
        <regex pattern="when identical\(_orderedFor, order\) &amp;&amp;\s*identical\(_orderedFrom, groupsById\)\) \{" dotAll="true" id="calculator_page.groups.stale_after_locale">
            <mutation text="when identical(_orderedFor, order)) {"/>
        </regex>

        <!-- RULE 6 (T2a 1/2, CA-1095): the detail panel never shows, shows
             with the keys up, or keeps the display's room while the display
             is pulled open -->
        <regex pattern="_isKeypadFolded &amp;&amp; _currentStage == DisplayAreaStage\.collapsed;" dotAll="true" id="calculator_page.detail_panel.when_shown">
            <mutation text="false;"/>
            <mutation text="_currentStage == DisplayAreaStage.collapsed;"/>
            <mutation text="_isKeypadFolded;"/>
        </regex>

        <!-- RULE 7: the page never hears the keypad unfold, or fold -->
        <regex pattern="setState\(\(\) =&gt; _isKeypadFolded = isFolded\)," dotAll="true" id="calculator_page.detail_panel.fold_unheard">
            <mutation text="setState(() =&gt; _isKeypadFolded = true),"/>
            <mutation text="setState(() =&gt; _isKeypadFolded = false),"/>
        </regex>

        <!-- RULE 8: a tape with nothing to work out draws an empty panel -->
        <regex pattern="child: state\.hasDetails\s*\? _detailPanel\(labels, state\)\s*: const SizedBox\.shrink\(\)," dotAll="true" id="calculator_page.detail_panel.drawn_empty">
            <mutation text="child: _detailPanel(labels, state),"/>
        </regex>

        <!-- RULE 9: under the fold the display keeps all the room, the panel
             is sized past the keys, or the strip sits on top of the display -->
        <regex pattern="showsPanel\s*\?\s*BoxConstraints\(minWidth: width, maxWidth: width, maxHeight: room\)\s*:\s*BoxConstraints\.tightFor\(width: width, height: room\)," dotAll="true" id="calculator_page.detail_panel.display_keeps_its_room">
            <mutation text="BoxConstraints.tightFor(width: width, height: room),"/>
        </regex>
        <regex pattern="BoxConstraints\.tightFor\(width: width, height: room - display\.height\)," dotAll="true" id="calculator_page.detail_panel.panel_too_tall">
            <mutation text="BoxConstraints.tightFor(width: width, height: room),"/>
        </regex>
        <regex pattern="positionChild\(_PageSlot\.strip, Offset\(0, display\.height\)\);" dotAll="true" id="calculator_page.detail_panel.strip_on_top">
            <mutation text="positionChild(_PageSlot.strip, Offset.zero);"/>
        </regex>
        <!-- Not a rule: shouldRelayout returning false is an equivalent
             mutant. Every change of showsPanel adds or removes the panel
             child, and a CustomMultiChildLayout lays out again whenever its
             children change, so no test can tell the two apart. -->

        <!-- RULE 10: CoreUI's Attachments heading is drawn, and the Expand
             and Collapse buttons trade their names -->
        <regex pattern="attachmentsTitleLabel: _attachmentsHeadingLeftBlank," dotAll="true" id="calculator_page.detail_panel.attachments_heading">
            <mutation text=""/>
        </regex>
        <regex pattern="expandLabel: labels\.l10n\.calculatorDetailExpandButton,\s*collapseLabel: labels\.l10n\.calculatorDetailCollapseButton," dotAll="true" id="calculator_page.detail_panel.buttons_swapped">
            <mutation text="expandLabel: labels.l10n.calculatorDetailCollapseButton, collapseLabel: labels.l10n.calculatorDetailExpandButton,"/>
        </regex>

        <!-- CA-1376: the % key sends another key -->
        <regex pattern="OperatorType\.percent =&gt; const CalculatorPercentPressed\(\)," dotAll="true" id="calculator_page.percent.another_key">
            <mutation text="OperatorType.percent =&gt; const CalculatorEqualsPressed(),"/>
        </regex>
        <!-- CA-1094 (Section 1.8): the strip note never reaches CoreUI's note
             slot, or the placeholder stands in for it -->
        <regex pattern="note: labels\.noteText\(state\.stripNote\)," dotAll="true" id="calculator_page.strip_note.not_shown">
            <mutation text="note: null,"/>
        </regex>
        <regex pattern="suggestionAreaPlaceholder:\s*l10n\.calculatorStripPlaceholder," dotAll="true" id="calculator_page.strip_note.placeholder_dropped">
            <mutation text="suggestionAreaPlaceholder: '',"/>
        </regex>
        <!-- CA-1198: the keyboard keeps CoreUI's own English -->
        <regex pattern="semantics: labels\.keyboardSemantics," dotAll="true" id="calculator_page.keyboard.semantics_dropped">
            <mutation text=""/>
        </regex>
        <!-- CA-1370: the keyboard keeps coreui's own English words -->
        <regex pattern="labels: labels\.keyboardLabels," dotAll="true" id="calculator_page.keyboard.labels_dropped">
            <mutation text=""/>
        </regex>
        <!-- CA-1195 B: two groups trade their dots -->
        <regex pattern="CalculatorLabelFormatter\.unitGroupId =&gt; colors\.keyboardGroupUnit," dotAll="true" id="calculator_page.group_dots.unit_takes_shapes">
            <mutation text="CalculatorLabelFormatter.unitGroupId =&gt; colors.keyboardGroupShapes,"/>
        </regex>
        <regex pattern="CalculatorLabelFormatter\.basicGeometryGroupId =&gt;\s*colors\.keyboardGroupGeometry," dotAll="true" id="calculator_page.group_dots.geometry_takes_trig">
            <mutation text="CalculatorLabelFormatter.basicGeometryGroupId =&gt; colors.keyboardGroupTrigonometry,"/>
        </regex>
        <!-- T2a 2/3 (CA-1095): the sheet table of the detail panel -->
        <regex pattern="onDeleted: \(id\) =&gt; _bloc\.add\(CalculatorSizeRowDeleted\(id\)\)," dotAll="true" id="calculator_page.sheet_table.delete_goes_nowhere">
            <mutation text="onDeleted: (id) {},"/>
        </regex>
        <regex pattern="child: state\.hasDetails\s*\?" dotAll="true" id="calculator_page.detail_panel.tiles_only">
            <mutation text="child: state.dimensions.isNotEmpty ?"/>
        </regex>
        <regex pattern="if \(state\.sizeTable case final table\?\)\s*_sheetTable\(labels, state, table\)," dotAll="true" id="calculator_page.sheet_table.not_drawn">
            <mutation text=""/>
        </regex>
        <regex pattern="values: \[row\.sizeText, row\.countText\]" dotAll="true" id="calculator_page.sheet_table.count_column_shows_the_size">
            <mutation text="values: [row.sizeText, row.sizeText]"/>
        </regex>
        <!-- T2a 3/3 (CA-1095): "+ Add size" -->
        <regex pattern="onAdd: \(\) =&gt; _addSize\(labels, state\)," dotAll="true" id="calculator_page.add_size.opens_nothing">
            <mutation text="onAdd: () {},"/>
        </regex>
        <regex pattern="validator: \(text\) =&gt; labels\.sizeEntryError\(state\.sizeEntry\(text\)\)," dotAll="true" id="calculator_page.add_size.refuses_the_good_size">
            <mutation text="validator: (text) =&gt; labels.l10n.calculatorSizeEditorSizeError,"/>
            <mutation text="validator: (text) =&gt; null,"/>
        </regex>
        <regex pattern="CalculatorSizeEditorClosed\(entry\?\.values \?\? const \[\]\)" dotAll="true" id="calculator_page.add_size.fields_dropped">
            <mutation text="CalculatorSizeEditorClosed(const [])"/>
        </regex>
    </rules>

    <commands>
        <command group="calculator_page" expected-return="0">flutter test test/features/calculator/widgets/calculator_page_interaction_test.dart</command>
        <command group="calculator_page" expected-return="0">flutter test test/features/calculator/widgets/calculator_page_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
