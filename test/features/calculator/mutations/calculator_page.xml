<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR PAGE: ✕ AT REST LEAVES FOR HOME (T1a, CA-1092); THE
         EDITING GUARDS' TOAST (S1c 4/5, CA-1089) -->
    <!-- Targets: the one listener that pops the page when the bloc says the
         calculator closes, and only on the state that says it first; and
         the same listener showing a toast every time a key raises one, and
         never on a state that merely still holds it. -->

    <files>
        <file>lib/features/calculator/presentation/pages/calculator_page.dart</file>
    </files>

    <rules>
        <!-- RULE 1: the page never leaves -->
        <regex pattern="\(current\.closesCalculator &amp;&amp; !previous\.closesCalculator\)" dotAll="true" id="calculator_page.close.never_pops">
            <mutation text="false"/>
        </regex>

        <!-- RULE 2: every later state pops the page again -->
        <regex pattern="\(current\.closesCalculator &amp;&amp; !previous\.closesCalculator\)" dotAll="true" id="calculator_page.close.pops_again">
            <mutation text="current.closesCalculator"/>
        </regex>

        <!-- RULE 3 (S1c 4/5, CA-1089): the red Alert is never drawn -->
        <regex pattern="if \(state\.toast case final toast\? when !state\.toastClosed\)" dotAll="true" id="calculator_page.toast.never_shown">
            <mutation text="if (state.toast case final toast? when false)"/>
        </regex>

        <!-- RULE 4: the Alert stays drawn after its ✕ closed it -->
        <regex pattern="if \(state\.toast case final toast\? when !state\.toastClosed\)" dotAll="true" id="calculator_page.toast.shown_after_close">
            <mutation text="if (state.toast case final toast?)"/>
        </regex>

        <!-- RULE 4a: the Alert's ✕ tells the bloc nothing -->
        <regex pattern="onClose: \(\) => bloc\.add\(const CalculatorToastClosed\(\)\)," dotAll="true" id="calculator_page.toast.close_unheard">
            <mutation text="onClose: () {},"/>
        </regex>

        <!-- RULE 4b: a screen reader never hears the message, or hears it
             again for a state that merely still holds it -->
        <regex pattern="current\.toastsRaised != previous\.toastsRaised," dotAll="true" id="calculator_page.toast.never_announced">
            <mutation text="false,"/>
            <mutation text="current.toast != null,"/>
        </regex>

        <!-- RULE 3 (T1b F1): a new group map keeps the old ordered list -->
        <regex pattern="when identical\(_orderedFor, order\) &amp;&amp;\s*identical\(_orderedFrom, groupsById\)\) \{" dotAll="true" id="calculator_page.groups.stale_after_locale">
            <mutation text="when identical(_orderedFor, order)) {"/>
        </regex>


    </rules>

    <commands>
        <command group="calculator_page" expected-return="0">flutter test test/features/calculator/widgets/calculator_page_interaction_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
