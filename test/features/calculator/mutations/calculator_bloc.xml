<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR BLOC: THE UNIT KEY UNDER A LENGTH-ONLY KEY, AND THE
         SYSTEM OF UNITS TOGGLE ON AN EMPTY TAPE ONLY (S1a, CA-1087) -->
    <!-- Targets: the one flag the bloc reads off the chip being typed before
         a unit key reaches the tape, so Width 5 [Lbs] and Height 5 [Kg] are
         refused and Width 5ft [Feet] never raises to an area (Section 3,
         "Takes: A length"; Section 5.2). -->

    <files>
        <file>lib/features/calculator/presentation/bloc/calculator_bloc/calculator_bloc.dart</file>
        <file>lib/features/calculator/presentation/bloc/calculator_bloc/calculator_state.dart</file>
    </files>

    <rules>
        <!-- RULE 1: no key holds a length only -->
        <regex pattern="LengthOnlyKeys\.all\.contains\((tape\.beingTyped\?\.key|key)\)" dotAll="true" id="calculator_bloc.press_unit.never_length_only">
            <mutation text="false"/>
        </regex>

        <!-- RULE 2: every key holds a length only, a bare number too -->
        <regex pattern="LengthOnlyKeys\.all\.contains\((tape\.beingTyped\?\.key|key)\)" dotAll="true" id="calculator_bloc.press_unit.always_length_only">
            <mutation text="true"/>
        </regex>

        <!-- RULE 3 (R3, review of 18 Nov): the System of units toggle is
             taken on a tape that holds a result or a typed value, so 12ft +
             1m = claims Metric while Calc still reads 15ft 3-3/8in; or it is
             refused on an empty tape too (Section 1.1) -->
        <regex pattern="if \(!state\.tape\.isEmpty\) return;" dotAll="true" id="calculator_bloc.unit_system.only_on_an_empty_tape">
            <mutation text=""/>
            <mutation text="if (state.tape.isEmpty) return;"/>
        </regex>

        <!-- RULE 4 (S1a 2/2): Pitch holds any unit, so Pitch 6 [Inch] [Inch]
             raises to 6in² -->
        <regex pattern="\|\| key == PlainNumberKeys\.pitch" dotAll="true" id="calculator_bloc.press_unit.pitch_holds_any_unit">
            <mutation text=""/>
        </regex>

        <!-- RULE 5 (R2 of #820, review of 18 Nov, F1): Sides takes any unit,
             so Sides 6 [Feet] [Feet] reads 6ft² -->
        <regex pattern="bool _takesACount\(Tape tape\) =&gt; tape\.beingTyped\?\.key == PlainNumberKeys\.sides;" dotAll="true" id="calculator_bloc.press_unit.sides_takes_a_unit">
            <mutation text="bool _takesACount(Tape tape) =&gt; false;"/>
        </regex>

        <!-- RULE 4 (S1b 2/6, CA-1088): the silence after an error chip reaches
             back past the chip that starts the chain, so the strip never
             comes back until C -->
        <regex pattern="case ValueChip\(:final operator\) \|\| BracketChip\(:final operator\):\s*if \(operator == null\) return false;" dotAll="true" id="calculator_state.strip_silent.error_silences_for_ever">
            <mutation text="case ValueChip(:final operator) || BracketChip(:final operator): if (operator == null) continue;"/>
        </regex>

        <!-- RULE 5 (S1b 2/6): an open bracket after named values leaves the
             strip on -->
        <regex pattern="tape\.openBracket != null \|\|\s*switch \(tape\.runningTotal\) \{" dotAll="true" id="calculator_state.strip_silent.open_bracket_offers">
            <mutation text="switch (tape.runningTotal) {"/>
        </regex>
    </rules>

    <commands>
        <command group="calculator_bloc" expected-return="0">flutter test test/features/calculator/units/blocs/calculator_bloc_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
