<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- CALCULATOR BLOC: THE UNIT KEY UNDER A LENGTH-ONLY KEY AND UNDER PITCH,
         AND THE SYSTEM OF UNITS TOGGLE ON AN EMPTY TAPE ONLY (S1a, CA-1087),
         THE STRIP'S SILENCE (S1b 2/6, CA-1088); ✕ AT REST AND THE BRACKET
         CHIP (T1a, CA-1092); THE ORDER OF THE FUNCTION-KEY GROUPS (T1b,
         CA-1093) -->
    <!-- Targets: the one flag the bloc reads off the chip being typed before
         a unit key reaches the tape (RULES S1a 1-3), the two ends of the
         strip's silence (RULES S1b 4-5); then the one branch that turns ✕ with no value in progress into
         "closes the calculator" and its clearing on the next key, and the
         state's reading of a bracket chip: its face, its inside, the
         operator as its factor, and the chips before an open bracket inert
         (RULES 1-16); then the reorder a drag in "View all" asks for: its
         range check, the shown group following its place, C keeping the
         order, and the order in the state's equality (RULES 17-21). -->

    <files>
        <file>lib/features/calculator/presentation/bloc/calculator_bloc/calculator_bloc.dart</file>
        <file>lib/features/calculator/presentation/bloc/calculator_bloc/calculator_state.dart</file>
    </files>

    <rules>
        <!-- RULE 1: no key holds a length only -->
        <regex pattern="LengthOnlyKeys\.all\.contains\((tape\.beingTyped\?\.key|key)\)" dotAll="true" id="calculator_bloc.press_unit.never_length_only">
            <mutation text="false"/>
        </regex>

        <!-- RULE 2: every key holds a length only, a bare number too -->
        <regex pattern="LengthOnlyKeys\.all\.contains\((tape\.beingTyped\?\.key|key)\)" dotAll="true" id="calculator_bloc.press_unit.always_length_only">
            <mutation text="true"/>
        </regex>

        <!-- RULE 3 (R3, review of 18 Nov): the System of units toggle is
             taken on a tape that holds a result or a typed value, so 12ft +
             1m = claims Metric while Calc still reads 15ft 3-3/8in; or it is
             refused on an empty tape too (Section 1.1) -->
        <regex pattern="if \(!state\.tape\.isEmpty\) return;" dotAll="true" id="calculator_bloc.unit_system.only_on_an_empty_tape">
            <mutation text=""/>
            <mutation text="if (state.tape.isEmpty) return;"/>
        </regex>

        <!-- RULE 4 (S1a 2/2): Pitch holds any unit, so Pitch 6 [Inch] [Inch]
             raises to 6in² -->
        <regex pattern="\|\| key == PlainNumberKeys\.pitch" dotAll="true" id="calculator_bloc.press_unit.pitch_holds_any_unit">
            <mutation text=""/>
        </regex>

        <!-- RULE 5 (R2 of #820, review of 18 Nov, F1): Sides takes any unit,
             so Sides 6 [Feet] [Feet] reads 6ft² -->
        <regex pattern="bool _takesACount\(Tape tape\) =&gt; tape\.beingTyped\?\.key == PlainNumberKeys\.sides;" dotAll="true" id="calculator_bloc.press_unit.sides_takes_a_unit">
            <mutation text="bool _takesACount(Tape tape) =&gt; false;"/>
        </regex>

        <!-- RULE 4 (S1b 2/6, CA-1088): the silence after an error chip reaches
             back past the chip that starts the chain, so the strip never
             comes back until C -->
        <regex pattern="case ValueChip\(:final operator\) \|\| BracketChip\(:final operator\):\s*if \(operator == null\) return false;" dotAll="true" id="calculator_state.strip_silent.error_silences_for_ever">
            <mutation text="case ValueChip(:final operator) || BracketChip(:final operator): if (operator == null) continue;"/>
        </regex>

        <!-- RULE 5 (S1b 2/6): an open bracket after named values leaves the
             strip on -->
        <regex pattern="tape\.openBracket != null \|\|\s*switch \(tape\.runningTotal\) \{" dotAll="true" id="calculator_state.strip_silent.open_bracket_offers">
            <mutation text="switch (tape.runningTotal) {"/>
        </regex>

        <!-- RULE 1: ✕ never closes the calculator -->
        <regex pattern="if \(state\.tape\.openBracket == null &amp;&amp;\s*outcome == const TapeRefused\(TapeRefusal\.nothingBeingTyped\)\) \{" dotAll="true" id="calculator_bloc.clear_active.never_closes">
            <mutation text="if (false) {"/>
        </regex>

        <!-- RULE 2: ✕ closes the calculator even while it clears a value -->
        <regex pattern="if \(state\.tape\.openBracket == null &amp;&amp;\s*outcome == const TapeRefused\(TapeRefusal\.nothingBeingTyped\)\) \{" dotAll="true" id="calculator_bloc.clear_active.always_closes">
            <mutation text="if (true) {"/>
        </regex>

        <!-- RULE 2a: ✕ closes the calculator inside an open bracket too (the
             tape says "nothing typed in this group" there, so the check on
             the open bracket is what keeps the calculator open) -->
        <regex pattern="if \(state\.tape\.openBracket == null &amp;&amp;\s*outcome == const TapeRefused\(TapeRefusal\.nothingBeingTyped\)\) \{" dotAll="true" id="calculator_bloc.clear_active.closes_inside_bracket">
            <mutation text="if (outcome == const TapeRefused(TapeRefusal.nothingBeingTyped) || outcome == const TapeRefused(TapeRefusal.nothingTypedInGroup)) {"/>
        </regex>

        <!-- RULE 3: the close is said as not closing -->
        <regex pattern="refusal: \(\) => null,\s*removedResults: const \[\],\s*refusedUnit: \(\) => null,\s*closesCalculator: true," dotAll="true" id="calculator_bloc.clear_active.close_not_said">
            <mutation text="refusal: () => null, removedResults: const [], refusedUnit: () => null, closesCalculator: false,"/>

        </regex>

        <!-- RULE 4: a taken key keeps the close -->

        <regex pattern="notice: \(\) => notice,\s*refusal: \(\) => null,\s*closesCalculator: false," dotAll="true" id="calculator_bloc.fold.taken_key_keeps_close">
            <mutation text="notice: () => notice, refusal: () => null, closesCalculator: true,"/>
        </regex>

        <!-- RULE 5: a refused key keeps the close -->
        <regex pattern="refusal: \(\) => refusal,\s*closesCalculator: false," dotAll="true" id="calculator_bloc.fold.refused_key_keeps_close">
            <mutation text="refusal: () => refusal, closesCalculator: true,"/>
        </regex>

        <!-- RULE 6: the close is left out of the state's equality -->
        <regex pattern="closesCalculator,\s*removedResults,\s*refusedUnit,\s*groupEditsNoticed,\s*toastsRaised,\s*toastClosed,\s*materialCounts,\s*\];" dotAll="true" id="calculator_state.props.drop_close">
            <mutation text="removedResults, refusedUnit, groupEditsNoticed, toastsRaised, toastClosed, materialCounts, ];"/>
        </regex>

        <!-- RULE 7: no chip is ever inert -->
        <regex pattern="inert: openIndex != null &amp;&amp; index != openIndex," dotAll="true" id="calculator_state.chips.never_inert">
            <mutation text="inert: false,"/>
        </regex>

        <!-- RULE 9: the chips are inert while no bracket is open -->
        <regex pattern="final openIndex = tape\.openBracketIndex;" dotAll="true" id="calculator_state.chips.inert_without_open_bracket">
            <mutation text="final openIndex = tape.openBracketIndex ?? -1;"/>
        </regex>

        <!-- RULE 10: the open and the closed faces are swapped -->
        <regex pattern="BracketChip\(isOpen: true\) =&gt; CoreCalculatorChipType\.bracketOpen," dotAll="true" id="calculator_state.chips.bracket_faces_swapped">
            <mutation text="BracketChip(isOpen: true) =&gt; CoreCalculatorChipType.bracketClosed,"/>
        </regex>
        <regex pattern="BracketChip\(\) =&gt; CoreCalculatorChipType\.bracketClosed," dotAll="true" id="calculator_state.chips.closed_bracket_drawn_open">
            <mutation text="BracketChip() =&gt; CoreCalculatorChipType.bracketOpen,"/>
        </regex>
        <!-- RULE 10a (CA-1376 2/3 R1): a reopened percent bracket is written
             closed, with its % and a second bracket inside the open chip -->
        <regex pattern="BracketChip\(isPercent: true, isOpen: false, :final inner\) =&gt;" dotAll="true" id="calculator_state.chips.open_percent_bracket_written_closed">
            <mutation text="BracketChip(isPercent: true, :final inner) =&gt;"/>
        </regex>

        <!-- RULE 11: a bracket chip holds nothing -->
        <regex pattern="BracketChip\(:final inner\) => inner\.map\(_valueTextOf\)\.join\(\)," dotAll="true" id="calculator_state.chips.bracket_holds_nothing">
            <mutation text="BracketChip() => '',"/>
        </regex>

        <!-- RULE 12: a bracket has no factor -->
        <regex pattern="BracketChip\(:final operator\?\) => operatorIcons\[operator\]," dotAll="true" id="calculator_state.chips.bracket_without_factor">
            <mutation text="BracketChip() => null,"/>
        </regex>

        <!-- RULE 13: + is drawn as − -->
        <regex pattern="Operator\.add: CoreIcons\.addOperator," dotAll="true" id="calculator_state.factor.add_as_subtract">
            <mutation text="Operator.add: CoreIcons.subtractOperator,"/>
        </regex>

        <!-- RULE 14: − is drawn as + -->
        <regex pattern="Operator\.subtract: CoreIcons\.subtractOperator," dotAll="true" id="calculator_state.factor.subtract_as_add">
            <mutation text="Operator.subtract: CoreIcons.addOperator,"/>
        </regex>

        <!-- RULE 15: × is drawn as ÷ -->
        <regex pattern="Operator\.multiply: CoreIcons\.multiplyOperator," dotAll="true" id="calculator_state.factor.multiply_as_divide">
            <mutation text="Operator.multiply: CoreIcons.divide,"/>
        </regex>

        <!-- RULE 16: ÷ is drawn as × -->
        <regex pattern="Operator\.divide: CoreIcons\.divide," dotAll="true" id="calculator_state.factor.divide_as_multiply">
            <mutation text="Operator.divide: CoreIcons.multiplyOperator,"/>
        </regex>


        <!-- RULE 17 (T1b, CA-1093): a drag from or to a place outside the five
             groups is applied anyway -->
        <regex pattern="if \(!inRange\(oldIndex\) \|\| !inRange\(newIndex\) \|\| oldIndex == newIndex\) \{\s*return;\s*\}" dotAll="true" id="calculator_bloc.reorder.no_range_check">
            <mutation text="if (oldIndex == newIndex) { return; }"/>
        </regex>

        <!-- RULE 17c: the first place is outside the range -->
        <regex pattern="bool inRange\(int index\) => index >= 0 &amp;&amp; index &lt; order\.length;" dotAll="true" id="calculator_bloc.reorder.first_place_out_of_range">
            <mutation text="bool inRange(int index) => index > 0 &amp;&amp; index &lt; order.length;"/>
        </regex>

        <!-- RULE 17d: one place past the last is inside the range -->
        <regex pattern="bool inRange\(int index\) => index >= 0 &amp;&amp; index &lt; order\.length;" dotAll="true" id="calculator_bloc.reorder.past_the_end_in_range">
            <mutation text="bool inRange(int index) => index >= 0 &amp;&amp; index &lt;= order.length;"/>
        </regex>

        <!-- RULE 17e: only the place a drag starts from is checked -->
        <regex pattern="if \(!inRange\(oldIndex\) \|\| !inRange\(newIndex\) \|\| oldIndex == newIndex\) \{" dotAll="true" id="calculator_bloc.reorder.new_place_unchecked">
            <mutation text="if (!inRange(oldIndex) || oldIndex == newIndex) {"/>
        </regex>

        <!-- RULE 17b: a drag that ends where it started is said as a change -->
        <regex pattern="\|\| oldIndex == newIndex\) \{" dotAll="true" id="calculator_bloc.reorder.same_place_emits">
            <mutation text="|| false) {"/>
        </regex>

        <!-- RULE 18: the group on the keyboard does not follow its new place -->
        <regex pattern="currentGroupIndex: order\.indexOf\(shown\)," dotAll="true" id="calculator_bloc.reorder.shown_group_left_behind">
            <mutation text="currentGroupIndex: state.currentGroupIndex,"/>
        </regex>

        <!-- RULE 19: the dragged group is dropped instead of moved -->
        <regex pattern="order\.insert\(newIndex, order\.removeAt\(oldIndex\)\);" dotAll="true" id="calculator_bloc.reorder.group_dropped">
            <mutation text="order.removeAt(oldIndex);"/>
        </regex>

        <!-- S2b (CA-1091): the stage or the fold is not heard, or C forgets
             them -->
        <regex pattern="\) =&gt; emit\(state\.copyWith\(historyStage: event\.stage\)\);" dotAll="true" id="calculator_bloc.history_stage.unheard">
            <mutation text=") =&gt; emit(state.copyWith(historyStage: DisplayAreaStage.collapsed));"/>
        </regex>
        <regex pattern="\) =&gt; emit\(state\.copyWith\(isKeypadFolded: event\.isFolded\)\);" dotAll="true" id="calculator_bloc.keypad_fold.unheard">
            <mutation text=") =&gt; emit(state.copyWith(isKeypadFolded: true));"/>
            <mutation text=") =&gt; emit(state.copyWith(isKeypadFolded: false));"/>
        </regex>
        <regex pattern="historyStage: state\.historyStage,\s*isKeypadFolded: state\.isKeypadFolded,\s*toastsRaised: state\.toastsRaised," dotAll="true" id="calculator_bloc.cleared.stage_and_fold_forgotten">
            <mutation text="toastsRaised: state.toastsRaised,"/>
        </regex>

        <!-- S2b 2/2 (CA-1091): Undo leaves the tape as it is, View leaves
             the display where it is, or the next key keeps the card -->
        <regex pattern="tape: banked,\s*bankedTape: \(\) =&gt; null,\s*bankedSessionId: \(\) =&gt; null," dotAll="true" id="calculator_bloc.undo.tape_left">
            <mutation text="bankedTape: () =&gt; null, bankedSessionId: () =&gt; null,"/>
            <mutation text="tape: banked, bankedSessionId: () =&gt; null,"/>
        </regex>
        <regex pattern="historyStage: DisplayAreaStage\.fullScreen,\s*bankedTape: \(\) =&gt; null," dotAll="true" id="calculator_bloc.view.display_left">
            <mutation text="bankedTape: () =&gt; null,"/>
            <mutation text="historyStage: DisplayAreaStage.fullScreen,"/>
        </regex>
        <regex pattern="toastClosed: false,\s*sizeNotAdded: false,\s*bankedTape: \(\) =&gt; null,\s*bankedSessionId: \(\) =&gt; null,\s*groupEditsNoticed:" dotAll="true" id="calculator_bloc.key.card_kept">
            <mutation text="toastClosed: false, sizeNotAdded: false, bankedSessionId: () =&gt; null, groupEditsNoticed:"/>
        </regex>
        <regex pattern="refusedUnit: \(\) =&gt; unit,\s*toastClosed: false,\s*sizeNotAdded: false,\s*bankedTape: \(\) =&gt; null," dotAll="true" id="calculator_bloc.refused_key.card_kept">
            <mutation text="refusedUnit: () =&gt; unit, toastClosed: false, sizeNotAdded: false,"/>
        </regex>

        <!-- U1 1/2 (CA-1097): the card forgets which session it names, Undo
             leaves the session in history, or Undo, View, the next key or
             a refused key keeps the id of a card that is gone; the id is
             left out of the state's equality -->
        <regex pattern="bankedSessionId: \(\) =&gt; event\.sessionId," dotAll="true" id="calculator_bloc.banked.session_forgotten">
            <mutation text="bankedSessionId: () =&gt; null,"/>
        </regex>
        <regex pattern="if \(sessionId != null\) await _deleteSession\(sessionId\);" dotAll="true" id="calculator_bloc.undo.session_left_in_history">
            <mutation text=""/>
        </regex>
        <regex pattern="tape: banked,\s*bankedTape: \(\) =&gt; null,\s*bankedSessionId: \(\) =&gt; null," dotAll="true" id="calculator_bloc.undo.session_id_kept">
            <mutation text="tape: banked, bankedTape: () =&gt; null,"/>
        </regex>
        <regex pattern="historyStage: DisplayAreaStage\.fullScreen,\s*bankedTape: \(\) =&gt; null,\s*bankedSessionId: \(\) =&gt; null," dotAll="true" id="calculator_bloc.view.session_id_kept">
            <mutation text="historyStage: DisplayAreaStage.fullScreen, bankedTape: () =&gt; null,"/>
        </regex>
        <regex pattern="bankedTape: \(\) =&gt; null,\s*bankedSessionId: \(\) =&gt; null,\s*groupEditsNoticed:" dotAll="true" id="calculator_bloc.key.session_id_kept">
            <mutation text="bankedTape: () =&gt; null, groupEditsNoticed:"/>
        </regex>
        <regex pattern="sizeNotAdded: false,\s*bankedTape: \(\) =&gt; null,\s*bankedSessionId: \(\) =&gt; null,\s*\),\s*\);\s*\}\s*\}" dotAll="true" id="calculator_bloc.refused_key.session_id_kept">
            <mutation text="sizeNotAdded: false, bankedTape: () =&gt; null, ), ); } }"/>
        </regex>
        <regex pattern="bankedTape,\s*bankedSessionId,\s*bankedCarriedForward," dotAll="true" id="calculator_state.props.session_id_ignored">
            <mutation text="bankedTape, bankedCarriedForward,"/>
        </regex>

        <!-- RULE 20: C and a reset forget the order -->
        <regex pattern="currentGroupIndex: state\.currentGroupIndex,\s*groupOrder: state\.groupOrder," dotAll="true" id="calculator_bloc.cleared.order_forgotten">
            <mutation text="currentGroupIndex: state.currentGroupIndex, groupOrder: CalculatorGroupId.defaultOrder,"/>
        </regex>

        <!-- RULE 21: the order is left out of the state's equality -->
        <regex pattern="currentGroupIndex,\s*groupOrder,\s*historyStage," dotAll="true" id="calculator_state.props.drop_group_order">
            <mutation text="currentGroupIndex, historyStage,"/>
        </regex>

        <!-- RULE 23 (S1c 3/5, CA-1089): a tapped chip never reaches the tape -->
        <regex pattern="on&lt;CalculatorChipTapped&gt;\(_onChipTapped\);" dotAll="true" id="calculator_bloc.chip_tapped.unwired">
            <mutation text=""/>
        </regex>

        <!-- RULE 24: no result is ever drawn dashed -->
        <regex pattern="ResultChip\(\) when editedIndex != null &amp;&amp; index &gt; editedIndex =&gt;" dotAll="true" id="calculator_state.chips.never_dashed">
            <mutation text="ResultChip() when false =&gt;"/>
        </regex>

        <!-- RULE 25: every result is dashed while any chip is edited, the ones
             before it too -->
        <regex pattern="ResultChip\(\) when editedIndex != null &amp;&amp; index &gt; editedIndex =&gt;" dotAll="true" id="calculator_state.chips.results_before_edit_dashed">
            <mutation text="ResultChip() when editedIndex != null =&gt;"/>
        </regex>

        <!-- RULE 26 (S1c 4/5, CA-1089): the removed result is not carried into
             the state -->
        <regex pattern="removedResults: removed,\s*refusedUnit: \(\) =&gt; null,\s*toastClosed: false," dotAll="true" id="calculator_bloc.fold.removed_result_dropped">
            <mutation text="removedResults: const [], refusedUnit: () =&gt; null, toastClosed: false,"/>
            <mutation text="removedResults: removed, refusedUnit: () =&gt; null,"/>
        </regex>

        <!-- RULE 27: a refused key keeps the removed result -->
        <regex pattern="refusal: \(\) =&gt; refusal,\s*closesCalculator: false,\s*removedResults: const \[\],\s*refusedUnit: \(\) =&gt; unit,\s*toastClosed: false," dotAll="true" id="calculator_bloc.fold.removed_result_kept_on_refusal">
            <mutation text="refusal: () =&gt; refusal, closesCalculator: false, refusedUnit: () =&gt; unit, toastClosed: false,"/>
        </regex>

        <!-- RULE 28: a toast is never counted, so the same guard raised
             twice is one state -->
        <regex pattern="next\.toast == null\s*\? next\s*: next\.copyWith\(toastsRaised: next\.toastsRaised \+ 1\)," dotAll="true" id="calculator_bloc.fold.toast_uncounted">
            <mutation text="next,"/>
        </regex>

        <!-- RULE 28a: C forgets how many toasts were raised, so the page
             would show the toast C's state still holds -->
        <regex pattern="isKeypadFolded: state\.isKeypadFolded,\s*toastsRaised: state\.toastsRaised," dotAll="true" id="calculator_bloc.cleared.toast_count_forgotten">
            <mutation text="isKeypadFolded: state.isKeypadFolded,"/>
        </regex>

        <!-- RULE 29: every state is counted as a toast, so the page shows
             one on a key that said nothing -->
        <regex pattern="next\.toast == null\s*\? next\s*: next\.copyWith\(toastsRaised: next\.toastsRaised \+ 1\)," dotAll="true" id="calculator_bloc.fold.every_state_counted">
            <mutation text="next.copyWith(toastsRaised: next.toastsRaised + 1),"/>
        </regex>

        <!-- RULE 30: a removed result has no toast -->
        <regex pattern="if \(removedResults\.isNotEmpty\) \{\s*return CalculatorResultRemovedToast\(keys: removedResults\);\s*\}" dotAll="true" id="calculator_state.toast.removed_result_silent">
            <mutation text=""/>
        </regex>
        <!-- RULE 24 (S1c 4/5 R1): the Alert's ✕ leaves it open -->
        <regex pattern="emit\(state\.copyWith\(toastClosed: true\)\);" dotAll="true" id="calculator_bloc.toast_closed.ignored">
            <mutation text="emit(state);"/>
        </regex>


        <!-- RULE 31 (S1c 5/5, CA-1089): the refused unit is not kept -->
        <regex pattern="removedResults: const \[\],\s*refusedUnit: \(\) =&gt; unit," dotAll="true" id="calculator_bloc.fold.refused_unit_dropped">
            <mutation text="removedResults: const [], refusedUnit: () =&gt; null,"/>
        </regex>

        <!-- RULE 32: a taken key keeps the refused unit -->
        <regex pattern="removedResults: removed,\s*refusedUnit: \(\) =&gt; null," dotAll="true" id="calculator_bloc.fold.refused_unit_kept">
            <mutation text="removedResults: removed,"/>
        </regex>

        <!-- RULE 33: the unit column's key is not named to the toast -->
        <regex pattern="_press\(emit, \(tape\) =&gt; _pressUnit\(tape, event\.unit\), unit: event\.unit\);" dotAll="true" id="calculator_bloc.unit_selected.unit_unnamed">
            <mutation text="_press(emit, (tape) =&gt; _pressUnit(tape, event.unit));"/>
        </regex>

        <!-- RULE 34: the Unit group's key is not named to the toast -->
        <regex pattern="return _press\(emit, \(tape\) =&gt; _pressUnit\(tape, unit\), unit: unit\);" dotAll="true" id="calculator_bloc.key_selected.unit_unnamed">
            <mutation text="return _press(emit, (tape) =&gt; _pressUnit(tape, unit));"/>
        </regex>

        <!-- RULE (S1c 5/5 R3, B3): Pitch gets the length words for a weight
             or board feet, or for a unit after a rise already typed -->
        <regex pattern="\(\s*TapeEntryRefused\(reason: EntryRefusal\.needsLength\),\s*final unit\?,\s*PlainNumberKeys\.pitch,\s*\)\s*when _isABareNumber\(typed\) =&gt;\s*CalculatorPitchUnitToast\(unit: unit, value: typed\?\.entry\.text \?\? ''\)," dotAll="true" id="calculator_state.toast.pitch_reads_as_a_length">
            <mutation text=""/>
        </regex>
        <regex pattern="\(\s*TapeEntryRefused\(\s*reason: EntryRefusal\.needsLength \|\| EntryRefusal\.tailNeedsLength,\s*\),\s*_,\s*PlainNumberKeys\.pitch,\s*\) =&gt;\s*null," dotAll="true" id="calculator_state.toast.pitch_tail_reads_as_a_length">
            <mutation text=""/>
        </regex>

        <!-- RULE (S1c 5/5 R4, B4): a fraction under Pitch gets the Pitch
             words, whose body names what Inch and = give for a bare number -->
        <regex pattern="PlainNumberKeys\.pitch,\s*\)\s*when _isABareNumber\(typed\) =&gt;" dotAll="true" id="calculator_state.toast.pitch_fraction_gets_the_words">
            <mutation text="PlainNumberKeys.pitch,) =&gt;"/>
        </regex>

        <!-- RULE 35 (R2, B2): the second key order, a unit after a finished
             length, raises no message -->
        <regex pattern="TapeEntryRefused\(reason: EntryRefusal\.tailNeedsLength\),\s*final unit\?,\s*final key\?,\s*\) =&gt;\s*CalculatorNeedsLengthToast\(key: key, unit: unit\)," dotAll="true" id="calculator_state.toast.tail_order_silent">
            <mutation text="TapeEntryRefused(reason: EntryRefusal.tailNeedsLength), final unit?, final key?,) =&gt; null,"/>
        </regex>

        <!-- RULE 36 (R1, B1): a unit key on a result builds a key-named
             message for no key -->
        <regex pattern="final key = typed\?\.key;\s*return switch \(\(refusal, refusedUnit, key\)\) \{" dotAll="true" id="calculator_state.toast.empty_key_named">
            <mutation text="final key = typed?.key ?? ''; return switch ((refusal, refusedUnit, key)) {"/>
        </regex>

        <!-- RULE 35b (S1c bracket edit 2/2, CA-1089): C forgets how many times a
             bracket was reopened, so the toast comes back three more times -->
        <regex pattern="toastsRaised: state\.toastsRaised,\s*groupEditsNoticed: state\.groupEditsNoticed," dotAll="true" id="calculator_bloc.cleared.reopenings_forgotten">
            <mutation text="toastsRaised: state.toastsRaised,"/>
        </regex>

        <!-- RULE 36 (S1c bracket edit 2/2, CA-1089): a reopening is never counted -->
        <regex pattern="groupEditsNoticed: notice == TapeNotice\.editingThisGroup\s*\? state\.groupEditsNoticed \+ 1\s*: null," dotAll="true" id="calculator_bloc.fold.reopening_uncounted">
            <mutation text="groupEditsNoticed: null,"/>
        </regex>

        <!-- RULE 37: the toast never stops -->
        <regex pattern="groupEditsNoticed &lt;= groupEditToastsShown\) \{" dotAll="true" id="calculator_state.toast.group_toast_never_stops">
            <mutation text="true) {"/>
        </regex>

        <!-- RULE 38: the toast stops one reopening early -->
