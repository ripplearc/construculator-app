<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <files>
        <file>lib/features/estimation/data/repositories/your_rates_repository_impl.dart</file>
    </files>

    <exclude>
        <regex pattern="try\s*{" dotAll="false"/>
        <regex pattern="catch\s*\(" dotAll="false"/>
        <regex pattern="@override" dotAll="false"/>
        <regex pattern="^import\s" dotAll="false"/>
        <regex pattern="AppLogger" dotAll="false"/>
    </exclude>

    <rules>
        <regex pattern="final byRecency = b\.recencyAt\.compareTo\(a\.recencyAt\);" dotAll="false" id="your_rates_repo.order.reverse_recency">
            <mutation text="final byRecency = a.recencyAt.compareTo(b.recencyAt);"/>
        </regex>
        <regex pattern="b\.savedAt\.compareTo\(a\.savedAt\)" dotAll="false" id="your_rates_repo.order.reverse_tiebreak">
            <mutation text="a.savedAt.compareTo(b.savedAt)"/>
        </regex>
        <regex pattern="byRecency != 0 \? byRecency : " dotAll="false" id="your_rates_repo.order.drop_tiebreak">
            <mutation text="byRecency != 0 ? byRecency : 0 * "/>
        </regex>
        <regex pattern="\.\.sort\(_mostRecentlyUsedFirst\)" dotAll="false" id="your_rates_repo.order.skip_sort">
            <mutation text=""/>
        </regex>
        <regex pattern="limit == null \? entries : entries\.take\(limit\)\.toList\(\)" dotAll="false" id="your_rates_repo.limit.ignore">
            <mutation text="entries"/>
        </regex>
        <regex pattern="entries\.take\(limit\)" dotAll="false" id="your_rates_repo.limit.off_by_one">
            <mutation text="entries.take(limit + 1)"/>
        </regex>
        <regex pattern="if \(words\.isEmpty\) \{" dotAll="false" id="your_rates_repo.search.negate_empty">
            <mutation text="if (words.isNotEmpty) {"/>
        </regex>
        <regex pattern="words\.any\(name\.contains\)" dotAll="false" id="your_rates_repo.search.any_to_every">
            <mutation text="words.every(name.contains)"/>
        </regex>

        <regex pattern="refusal\.userId == userId" dotAll="false" id="your_rates_repo.refusal.any_user">
            <mutation text="true"/>
        </regex>
        <regex pattern="refusals\[dto\.id\]" dotAll="false" id="your_rates_repo.refusal.match_wrong_key">
            <mutation text="refusals[dto.itemName]"/>
        </regex>
        <regex pattern="refusal\.refusedAmount != dto\.rateAmount" dotAll="false" id="your_rates_repo.refusal.ignore_amount">
            <mutation text="false"/>
        </regex>
        <regex pattern="if \(acceptedAmount != null\)" dotAll="false" id="your_rates_repo.refusal.negate_accepted">
            <mutation text="if (acceptedAmount == null)"/>
        </regex>
        <regex pattern="dto\.withRateAmount\(acceptedAmount\)" dotAll="false" id="your_rates_repo.refusal.keep_refused_amount">
            <mutation text="dto"/>
        </regex>
        <regex pattern="await _forgetRefusalOf\(normalizedEntry\);" dotAll="false" id="your_rates_repo.forget.skip">
            <mutation text=";"/>
        </regex>
        <regex pattern="companyId: entry\.companyId," dotAll="false" id="your_rates_repo.forget.wrong_company">
            <mutation text="companyId: 'other-company',"/>
        </regex>
        <regex pattern="category: entry\.category\.toJson\(\)," dotAll="false" id="your_rates_repo.forget.wrong_category">
            <mutation text="category: 'material',"/>
        </regex>
        <regex pattern="itemName: entry\.itemName," dotAll="false" id="your_rates_repo.forget.wrong_item">
            <mutation text="itemName: 'other item',"/>
        </regex>
        <regex pattern="equipmentMethod: entry\.equipmentMethod\?\.toJson\(\)," dotAll="false" id="your_rates_repo.forget.wrong_method">
            <mutation text="equipmentMethod: null,"/>
        </regex>
        <regex pattern="asLastAccepted: false," dotAll="false" id="your_rates_repo.save.duplicate_check_on_filtered_rows">
            <mutation text="asLastAccepted: true,"/>
        </regex>
    </rules>

    <commands>
        <command group="your_rates_repo" expected-return="0">flutter test test/features/estimations/units/data/repositories/your_rates_repository_impl_test.dart</command>
    </commands>

    <threshold failure="70"/>
</mutations>
