<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- UNFINISHED COST LINE REPOSITORY MUTATION TESTING -->
    <!-- Targets: the 7-day clean-up, the write queue, the per-account key and the stored JSON check -->

    <files>
        <file>lib/features/estimation/data/repositories/unfinished_cost_line_repository_impl.dart</file>
    </files>

    <exclude>
        <regex pattern="@override" dotAll="false"/>
        <regex pattern="^import\s" dotAll="false"/>
    </exclude>

    <rules>
        <regex pattern="Duration\(days: 7\)" dotAll="false" id="unfinished_line.keep_for.days">
            <mutation text="Duration(days: 8)"/>
            <mutation text="Duration(days: 6)"/>
        </regex>
        <regex pattern="difference\(line\.updatedAt\) &lt; _keepFor" dotAll="false" id="unfinished_line.expiry.boundary">
            <mutation text="difference(line.updatedAt) &lt;= _keepFor"/>
            <mutation text="difference(line.updatedAt) &gt; _keepFor"/>
        </regex>
        <regex pattern="    await remove\(\);\n    return null;" dotAll="true" id="unfinished_line.expiry.skip_remove">
            <mutation text="    return null;"/>
        </regex>
        <regex pattern="return line;" dotAll="false" id="unfinished_line.expiry.never_keep">
            <mutation text="return null;"/>
        </regex>
        <regex pattern="    await _lastWrite;\n" dotAll="true" id="unfinished_line.read.skip_wait">
            <mutation text=""/>
        </regex>
        <regex pattern="return _lastWrite = _lastWrite\.then\(\(_\) async \{" dotAll="false" id="unfinished_line.queue.no_chain">
            <mutation text="return _lastWrite = Future.value().then((_) async {"/>
        </regex>
        <regex pattern="if \(accountId == null\) return null;" dotAll="false" id="unfinished_line.key.no_account">
            <mutation text="if (accountId == null) return 'unfinished_cost_line.';"/>
        </regex>
        <regex pattern="'unfinished_cost_line\.\$accountId'" dotAll="false" id="unfinished_line.key.shared">
            <mutation text="'unfinished_cost_line.'"/>
        </regex>
        <regex pattern="json is Map&lt;String, dynamic&gt;" dotAll="false" id="unfinished_line.read.type_check">
            <mutation text="json is! Map&lt;String, dynamic&gt;"/>
        </regex>
    </rules>

    <commands>
        <command group="unfinished_cost_line_repository" expected-return="0">flutter test test/features/estimations/units/repositories/unfinished_cost_line_repository_impl_test.dart</command>
    </commands>

    <threshold failure="80">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
