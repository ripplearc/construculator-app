<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <files>
        <file>lib/libraries/powersync/data/connectors/supabase_powersync_connector.dart</file>
    </files>

    <exclude>
        <regex pattern="_logger\.(debug|info|warning|error)\s*\(" dotAll="false"/>
        <regex pattern="@override" dotAll="false"/>
    </exclude>

    <rules>
        <regex pattern="DatabaseConstants\.costItemsTable: DatabaseConstants\.calculationColumn," id="connector.cost_items.calculation_not_decoded">
            <mutation text=""/>
        </regex>
        <regex pattern="if \(text is! String\) return row;" id="connector.decode.skips_string_guard">
            <mutation text=""/>
        </regex>
        <regex pattern="if \(table != DatabaseConstants\.costItemsTable\) return row;" id="connector.nulls.every_table">
            <mutation text=""/>
        </regex>
        <regex pattern="\{for \(final column in columns\) column\.name: null, \.\.\.row\}" id="connector.nulls.not_added">
            <mutation text="{...row}"/>
        </regex>
    </rules>

    <commands>
        <command group="connector_cost_items" expected-return="0">flutter test test/libraries/powersync/units/connectors/supabase_powersync_connector_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="50" name="D"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
