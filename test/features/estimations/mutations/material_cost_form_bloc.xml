<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- MATERIAL COST FORM BLOC MUTATION TESTING -->
    <!-- Targets: Add enablement, quantity and rate bounds, rate status -->

    <files>
        <file>lib/features/estimation/presentation/bloc/material_cost_form_bloc/material_cost_form_bloc.dart</file>
        <file>lib/features/estimation/presentation/bloc/material_cost_form_bloc/material_cost_form_state.dart</file>
    </files>

    <exclude>
        <regex pattern="^import .*$" dotAll="false"/>
    </exclude>

    <rules>
        <regex pattern="rate &gt;= _minRate" dotAll="false" id="bloc.rate.min_boundary">
            <mutation text="rate &gt; _minRate"/>
        </regex>
        <regex pattern="rate &lt;= _maxRate" dotAll="false" id="bloc.rate.max_boundary">
            <mutation text="rate &lt; _maxRate"/>
        </regex>
        <regex pattern="_minRate = 0\.01" dotAll="false" id="bloc.rate.min_constant">
            <mutation text="_minRate = 0.0"/>
        </regex>
        <regex pattern="_maxRate = 999999\.99" dotAll="false" id="bloc.rate.max_constant">
            <mutation text="_maxRate = 1000000.0"/>
        </regex>
        <regex pattern="quantity &gt; 0 &amp;&amp;" dotAll="false" id="bloc.quantity.positive_boundary">
            <mutation text="quantity &gt;= 0 &amp;&amp;"/>
        </regex>
        <regex pattern="quantity &gt;= _quantityColumnLimit" dotAll="false" id="bloc.quantity.limit_boundary">
            <mutation text="quantity &gt; _quantityColumnLimit"/>
        </regex>
        <regex pattern="if \(quantity == null\) return false;" dotAll="false" id="bloc.quantity.skip_null">
            <mutation text="if (quantity == null) return true;"/>
        </regex>
        <regex pattern="if \(rate == null\) return false;" dotAll="false" id="bloc.rate.skip_null">
            <mutation text="if (rate == null) return true;"/>
        </regex>
        <regex pattern="draft\.isItemNameValid &amp;&amp;" dotAll="false" id="bloc.valid.skip_name">
            <mutation text="true &amp;&amp;"/>
        </regex>
        <regex pattern="draft\.unit != null &amp;&amp;" dotAll="false" id="bloc.valid.skip_unit">
            <mutation text="true &amp;&amp;"/>
        </regex>
        <regex pattern="RateStatus\.ownRateUnconfirmed" dotAll="false" id="bloc.rate_status.typed_unconfirmed">
            <mutation text="RateStatus.ownRateConfirmed"/>
        </regex>
        <regex pattern="rate == null\s*\? RateStatus\.missing" dotAll="true" id="bloc.rate_status.cleared_missing">
            <mutation text="rate == null ? RateStatus.ownRateConfirmed"/>
        </regex>
        <regex pattern="if \(isValid\) return null;" dotAll="false" id="state.blocker.valid_null">
            <mutation text="if (!isValid) return null;"/>
        </regex>
        <regex pattern="MaterialBlockerKind\.invalid\);" dotAll="false" id="state.blocker.invalid_kind">
            <mutation text="MaterialBlockerKind.missing);"/>
        </regex>
        <regex pattern="if \(fieldErrors\.containsKey\(field\)\)" dotAll="false" id="state.blocker.skip_error_check">
            <mutation text="if (false)"/>
        </regex>
        <regex pattern="errors\[MaterialFormField\.quantity\] =\s*MaterialFieldError\.quantityNotPositive" dotAll="true" id="bloc.quantity.error_kind">
            <mutation text="errors[MaterialFormField.quantity] = MaterialFieldError.quantityTooLarge"/>
        </regex>
        <regex pattern="state is MaterialCostFormSubmitting \|\|" dotAll="false" id="bloc.submit.skip_in_flight_guard">
            <mutation text="false ||"/>
        </regex>
        <regex pattern="state is MaterialCostFormSuccess\) \{" dotAll="false" id="bloc.submit.skip_success_guard">
            <mutation text="false) {"/>
        </regex>
        <regex pattern="if \(!draft\.isValid \|\|" dotAll="false" id="bloc.submit.skip_validity_guard">
            <mutation text="if (false ||"/>
        </regex>
        <regex pattern="\)\.round\(\) / 100" dotAll="false" id="bloc.submit.total_rounding">
            <mutation text=").floor() / 100"/>
        </regex>
        <regex pattern="quantity \* \(rate" dotAll="false" id="bloc.submit.total_operator">
            <mutation text="quantity + (rate"/>
        </regex>
        <regex pattern="QuantityProvenance\.manual" dotAll="false" id="bloc.submit.provenance">
            <mutation text="QuantityProvenance.fromCalculator"/>
        </regex>
        <regex pattern="draft\.itemName\.trim\(\)" dotAll="false" id="bloc.submit.trim_name">
            <mutation text="draft.itemName"/>
        </regex>
        <regex pattern="'unit_price': rate" dotAll="false" id="bloc.submit.calculation_rate">
            <mutation text="'unit_price': 0.0"/>
        </regex>
        <regex pattern="quantity \* rate &lt; _lineTotalColumnLimit" dotAll="false" id="bloc.line_total.boundary">
            <mutation text="quantity * rate &lt;= _lineTotalColumnLimit"/>
        </regex>
        <regex pattern="_lineTotalColumnLimit = 1e16" dotAll="false" id="bloc.line_total.constant">
            <mutation text="_lineTotalColumnLimit = 1e17"/>
        </regex>
        <regex pattern="hasRate &amp;&amp;\s+fitsLineTotal" dotAll="true" id="bloc.line_total.skip_check">
            <mutation text="hasRate &amp;&amp; true"/>
        </regex>
        <regex pattern="MaterialCostFormFailure\(:final failure\) =&gt;\s*MaterialCostFormFailure\(\s*next,\s*failure,?\s*\)," dotAll="true" id="bloc.emit.failure_cleared_by_edit">
            <mutation text="MaterialCostFormFailure() =&gt; MaterialCostFormEditing(next),"/>
        </regex>
        <regex pattern="data\.itemName\.trim\(\) != _formValuesAtOpening\.itemName\.trim\(\)" dotAll="false" id="bloc.dirty.name">
            <mutation text="false"/>
        </regex>
        <regex pattern="data\.quantity != _formValuesAtOpening\.quantity" dotAll="false" id="bloc.dirty.quantity">
            <mutation text="false"/>
        </regex>
        <regex pattern="data\.unit != _formValuesAtOpening\.unit" dotAll="false" id="bloc.dirty.unit">
            <mutation text="false"/>
        </regex>
        <regex pattern="data\.rate != _formValuesAtOpening\.rate" dotAll="false" id="bloc.dirty.rate">
            <mutation text="false"/>
        </regex>
        <regex pattern="if \(data\.isUnitPicked\) return data;" dotAll="false" id="bloc.preselect.keep_picked">
            <mutation text="if (false) return data;"/>
        </regex>
        <regex pattern="if \(_withRememberedUnit\(current\)\.unit != current\.unit\)" dotAll="false" id="bloc.preselect.apply_after_load">
            <mutation text="if (false)"/>
        </regex>
        <regex pattern="unit: e\.unit, isUnitPicked: true" dotAll="false" id="bloc.pick.mark_picked">
            <mutation text="unit: e.unit, isUnitPicked: false"/>
        </regex>
        <regex pattern="CostItemType\.material,\s+draft\.itemName," dotAll="true" id="bloc.submit.remember_unit_per_material">
            <mutation text="CostItemType.material, '',"/>
        </regex>
    </rules>

    <commands>
        <command group="bloc" expected-return="0">fvm flutter test test/features/estimations/units/blocs/material_cost_form_bloc_test.dart</command>
    </commands>

    <threshold failure="85"/>
</mutations>
