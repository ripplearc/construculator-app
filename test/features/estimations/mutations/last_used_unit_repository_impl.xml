<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- LAST USED UNIT REPOSITORY MUTATION TESTING -->
    <!-- Targets: a failed read skips the save, damaged units start over -->

    <files>
        <file>lib/features/estimation/data/repositories/last_used_unit_repository_impl.dart</file>
    </files>

    <exclude>
        <regex pattern="^import .*$" dotAll="false"/>
    </exclude>

    <rules>
        <regex pattern="so none saved: \$e'\);\s+return;" dotAll="true" id="repo.save.skip_on_failed_read">
            <mutation text="so none saved: $e');"/>
        </regex>
        <regex pattern="if \(stored == null\) return RememberedUnits\.none;" dotAll="false" id="repo.decode.nothing_stored">
            <mutation text=""/>
        </regex>
        <regex pattern="damaged: \$e'\);\s+return RememberedUnits\.none;" dotAll="true" id="repo.decode.damaged_starts_over">
            <mutation text="damaged: $e'); rethrow;"/>
        </regex>
        <regex pattern="if \(key == null\) return;" dotAll="false" id="repo.save.no_account">
            <mutation text=""/>
        </regex>
        <regex pattern="await _storage\.removeData\(_retiredPerCategoryKeyFor\(key\)\);" dotAll="false" id="repo.save.retire_old_key">
            <mutation text=""/>
        </regex>
        <regex pattern="key: \?Unit\.values\.where\(\(unit\) =&gt; unit\.name == value\)\.firstOrNull" dotAll="false" id="repo.decode.known_units_only">
            <mutation text="key: Unit.values.firstWhere((unit) =&gt; unit.name == value)"/>
        </regex>
    </rules>

    <commands>
        <command group="repository" expected-return="0">fvm flutter test test/features/estimations/units/repositories/last_used_unit_repository_impl_test.dart</command>
    </commands>

    <threshold failure="85"/>
</mutations>
