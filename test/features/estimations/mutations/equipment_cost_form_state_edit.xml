<?xml version="1.0" encoding="UTF-8"?>
<mutations version="1.0">
    <!-- EQUIPMENT FORM STATE, EDIT MODE: changeInEstimateTotal, isEditingExistingLine, lineName -->

    <files>
        <file>lib/features/estimation/presentation/bloc/equipment_cost_form_bloc/equipment_cost_form_state.dart</file>
    </files>

    <exclude>
        <regex pattern="_logger\.(debug|info|warning|error)\s*\(" dotAll="false"/>
        <regex pattern="@override" dotAll="false"/>
    </exclude>

    <rules>
        <regex pattern="(_toCents\(edited\.itemTotalCost\))" id="edit_change.stored_total_zero">
            <mutation text="0"/>
        </regex>

        <regex pattern="(_toCents\(deliveryFee \?\? 0\) -)" id="edit_change.fee_added_not_subtracted">
            <mutation text="_toCents(deliveryFee ?? 0) +"/>
        </regex>

        <regex pattern="(_toCents\(edited\.itemTotalCost\)\) /)" id="edit_change.cents_off">
            <mutation text="_toCents(edited.itemTotalCost)) * "/>
        </regex>

        <regex pattern="(if \(edited == null\) return null;)" id="edit_change.always_null">
            <mutation text="return null;"/>
        </regex>

        <regex pattern="(if \(edited == null\) return null;)" id="edit_change.never_null">
            <mutation text="if (false) return null;"/>
        </regex>

        <regex pattern="(bool get isEditingExistingLine =&gt; editedItem != null;)" id="edit_flag.inverted">
            <mutation text="bool get isEditingExistingLine =&gt; editedItem == null;"/>
        </regex>

        <regex pattern="(editedItem\?\.itemName \?\? equipmentType)" id="line_name.live_name">
            <mutation text="equipmentType"/>
        </regex>

    </rules>

    <commands>
        <command group="equipment_cost_form_state_edit" expected-return="0">fvm flutter test test/features/estimations/units/blocs/equipment_cost_form_bloc_edit_test.dart</command>
    </commands>

    <threshold failure="85">
        <rating over="85" name="A"/>
        <rating over="75" name="B"/>
        <rating over="65" name="C"/>
        <rating over="55" name="D"/>
        <rating over="35" name="E"/>
        <rating over="0" name="F"/>
    </threshold>
</mutations>
