APP_ENV="dev"
APP_NAME=Construculator
API_URL=http://localhost:8000/api
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=fake-key
# Port 9081 matches the backend's current checkout, which is E2E-flavored
# (its only config on master targets the construculator-backend-e2e project).
# Revisit once CA-1007 lands a separate ordinary-dev backend config.
POWERSYNC_URL=http://localhost:9081
DEBUG_MODE=true
ANALYTICS_ENABLED=true
# Opts into the consent gate. Setting this true does nothing on its own:
# consentPersistenceReady (consent_gate_readiness.dart) blocks the gate in
# source until CA-971 lands, and no .env value can lift that. Keep it false.
CONSENT_GATE_ENABLED=false
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=
POSTHOG_DEBUG=true

# Create copies for .env.dev, .env.qa, .env.prod